{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5077",
  "jpg_path_foto": {
    "path": "/srv/istanta4/storage/jpg/"
  },
  "path_to_export": {
    "path": "wwwroot/exported_files/"
  },
  "path_to_import": {
    "path": "wwwroot/imported_files/"
  },
  "external_paths": {
    "pathLib": "wwwroot/external_lib/",
    "pathSource": "wwwroot/external_source/Famila/"
  },
  "sync_options": {
    "extractPath": "/srv/istanta4/storage/estrazioni/",
    "extPreLavorazione": [
      ".jpg"
    ],
    "extPostLavorazione": [],
    "delimitersQuery": [
      "_"
    ],
    "delimitersIndexRules": [],
    "fotoAmbientateKeyWordsToSearch": [],
    "loghiKeyWordsToSearch": [],
    "bolliniKeyWordsToSearch": [],
    "ipUploadGate": "http://127.0.0.1:59999"
  },
  "antlr_options": {
    "patternsDescrizioneRegionale": {
      "livelli": [
        {
          "nome": "Livello 1",
          "patterns": [
            {
              "condizione": "iniziativa==2505AC || settore==8305",
              "valore": "LOC"
            }
          ]
        }
      ]
    }
  },
  "fico": {
    "olympusServerUrl": "http://192.168.1.240:3005/olimpo",
    "fpServerUrl": "http://127.0.0.1:3010/api",
    "correggoServerUrl": "http://127.0.0.1:59999",
    "agent": "ws://127.0.0.1:59999/ws",
    "contextsPath": "wwwroot/ficoContexts/Famila/",
    "secretKey": "<la chiave FICO di Famila: chiedila a chi gestisce il cliente>",
    "nomeCliente": "Famila",
    "userDataPolicy": [
      {
        "source": "nome",
        "dest": "NomeUtente"
      },
      {
        "source": "cognome",
        "dest": "email"
      }
    ]
  },
  "_nota": "MODELLO per il cliente Famila. Copialo in appsettings.famila.json (che non sta in git, come nessun appsettings) e riempi secretKey. Le ConnectionStrings di proposito non sono qui: le eredita da appsettings.json, e le variabili d'ambiente vincono su entrambi. I percorsi sono relativi alla cartella del progetto: si lancia da Istanta/. La porta 5077 evita di pestare i piedi a un'altra istanza sulla 5076. Si usa cosi':  cp Istanta/appsettings.famila.template.json Istanta/appsettings.famila.json && export ISTANTA_CLIENTE=famila"
}
