@page
@model Istanta.Views.TaskManager.IndexModel
@{
}
<h2>Operazioni in Corso / Attesa</h2>

<div class="container bg-warning bg-opacity-25 border border-3 border-dark align-items-center mb-3" style="--bs-border-opacity:0.5;" id="operazioniInEsecuzione">
    Nessuna operazione trovata
</div>


<h2>Mostra operazioni concluse</h2>

<!-- Dropdown per selezionare l'intervallo di tempo -->
<div class="row mb-3 align-items-center">
    <div class="col-3 me-5">
        <label for="intervalloTempo" class="form-label">Operazioni concluse entro:</label>
        <select class="form-select" id="intervalloTempo" onchange="taskManagerInstance.takeActivitiesByTime()">
            <option value="10">10 minuti</option>
            <option value="60" selected>1 ora</option>
            <option value="180">3 ore</option>
            <option value="480">8 ore</option>
            <option value="1440">1 giorno</option>
            <option value="10080">1 settimana</option>
        </select>
    </div>
    <div class="col-8">
        <label for="checkboxSelezioneOperazioni" class="form-label">Includi esiti:</label>
        <div class="row" id="checkboxSelezioneOperazioni">
            <div class="col-auto">
            <div class="form-check">
                    <input class="form-check-input" type="checkbox" checked id="opRiuscite" onchange="taskManagerInstance.setCheckboxVisibility()">
                <label class="form-check-label" for="opRiuscite">
                    Operazioni riuscite
                </label>
            </div>
            </div>
            <div class="col-auto">
            <div class="form-check">
                    <input class="form-check-input" type="checkbox" checked id="opFallite" onchange="taskManagerInstance.setCheckboxVisibility()">
                <label class="form-check-label" for="opFallite">
                    Operazioni fallite
                </label>
            </div>
            </div>
            <div class="col-auto">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" checked id="opAnnullate" onchange="taskManagerInstance.setCheckboxVisibility()">
                    <label class="form-check-label" for="opAnnullate">
                        Operazioni annullate
                    </label>
                </div>
            </div>
        </div>        
    </div>
</div>

<div class="container border border-3 border-dark align-items-center mb-3" id="operazioniEseguite">
    Nessuna operazione trovata
</div>

<template id="rigaTabella">
    <div class="row align-items-center">
        @*<div class="row bg-light bg-opacity-50 align-items-center" style="width:100%">*@
            <div class="col-3" id="Title" style="font-size:13px">Importazione VOL IC_EUROSPAR 20 NUOVO.xlsx</div>
            <div class="col-5">
                <div class="row ms-3 me-3">
                    <div class="col-4" id="DataRegistazione">2023-12-12</div>
                    <div class="col-4" id="DataInizio">2023-12-13</div>
                    <div class="col-4" id="DataFine">2023-12-14</div>
                </div>
            </div>
            <div class="col-1" id="Completamento">0%</div>
            <div class="col-2" id="Stato" style="font-size:13px">Importazione terminata con successo</div>
            <div class="col-1" style="display:none" id="Errors">
            <button id="ErrorButton" idAttivita="0" class="btn btn-danger" onclick="taskManagerInstance.getErrori(parseInt($(this).attr('idAttivita')))">Errori</button>
            </div>
       @* </div>*@
    </div>
</template>

<template id="intestazioneTabella">
    <div class="row bg-primary bg-opacity-50 pb-2 ">
        <div class="col-3 fw-bold">Titolo</div>
        <div class="col-5">
            <div class="row ms-3 me-3">
                <div class="col-4 fw-bold">Data Reg.</div>
                <div class="col-4 fw-bold">Data Inizio</div>
                <div class="col-4 fw-bold">Data Fine</div>
            </div>
        </div>
        <div class="col-1 fw-bold">%</div>
        <div class="col-2 fw-bold">Stato</div>
        <div class="col-1 fw-bold">Errors</div>
    </div>
</template>

<div class="modal fade" id="ModalShowErrors">
    <div class="modal-xl modal-dialog modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title">Errori dell'attività:</h5>
                <button type="button" data-bs-dismiss="modal" class="btn-close" aria-label="Close"></button>
            </div>
            <!-- Modal Body -->
            <div class="modal-body">
                
            </div>
        </div>
    </div>
</div>


@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" type="text/javascript">

    let taskManagerInstance;

    function documentReady()
    {
        taskManagerInstance = new TaskManager();
        taskManagerInstance.takeActivitiesByTime();
    }

</script>