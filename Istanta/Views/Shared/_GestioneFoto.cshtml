@model Istanta.Models.GestioneFoto
@using IstantaLib;
@using Microsoft.AspNetCore.Html;
@*La sezione delle foto della Scheda articolo, condivisa con il revisore che la apre in una finestra
  (SchedaArticolo/GestioneFoto). Le azioni si agganciano da archivio.js per data-azione, e il codice
  su cui agiscono e' quello di data-codice-foto: una referenza o un codice gruppo. Un gruppo, che non
  ha una scheda articolo, ha solo le foto extra comuni a tutte le referenze.*@
@{
    string[] _extPostProduzione = Model.ExtPostProduzione;
    var olimpoIp = Model.OlimpoIp;
    var fotoPrimaria = Model.Foto.Where(f => !f.Tipo.HasValue || f.Tipo == (Byte)IstantaLib.TipoFoto.Foto).OrderByDescending(o => o.DataModifica).FirstOrDefault();
}

<div class="gestioneFoto" data-codice-foto="@Model.Codice" data-gruppo="@(Model.Gruppo ? "true" : "false")" data-in-finestra="@(Model.InFinestra ? "true" : "false")">
    @if (Model.Errore != null)
    {
        <div class="alert alert-warning">@Model.Errore</div>
    }
    else
    {
        <div class="sezioniFoto">
            @if (!Model.Gruppo)
            {
                <h5>Foto</h5>
            }
            else
            {
                <div class="alert alert-info py-2" style="font-size:13px">
                    Gruppo di @Model.Referenze referenze: le foto del prodotto si gestiscono su ogni referenza.
                    Qui ci sono le foto extra comuni a tutte, e quello che si carica, si collega, si attiva o si elimina vale per tutte.
                </div>
                @if (Model.CodiciSenzaArticolo.Count > 0)
                {
                    <div class="alert alert-warning py-2" style="font-size:13px">
                        Non in archivio: @string.Join(", ", Model.CodiciSenzaArticolo). Su queste referenze non si scrive niente.
                    </div>
                }
            }
            <div class="container">
                @{
                    string nomeFotoPrimaria = "";

                    //I20-985: le destinazioni sono quelle di Settings, voce Aree e Canali: gli
                    //elenchi di aree e canali e la matrice che dice quali coppie sono attive. Si
                    //preparano qui una volta sola perche' servono in piu' punti della scheda:
                    //sulla foto in uso, su ognuna di quelle in elenco e sul caricamento.
                    var areeFoto = Model.Aree;
                    var canaliFoto = Model.Canali;
                    var combinazioniFoto = Model.Combinazioni;
                    var siglaPerCanale = canaliFoto.GroupBy(c => c.guidID).ToDictionary(g => g.Key, g => g.First().sigla);

                    Func<string, string> testo = valore => System.Net.WebUtility.HtmlEncode(valore ?? "");

                    //Nei menu si mostrano le sigle, che sono cio' che il server scrive nella foto.
                    var opzioniCanale = new HtmlString(string.Join("", canaliFoto.OrderBy(c => c.nome)
                        .Select(c => $"<option value=\"{testo(c.sigla)}\">{testo(c.sigla + " - " + c.nome)}</option>")));

                    //Ogni area porta addosso i canali con cui e' attiva: scelto il canale,
                    //restano le sole aree previste.
                    var opzioniArea = new HtmlString(string.Join("", areeFoto.OrderBy(a => a.nome).Select(a =>
                    {
                        var canaliDellArea = string.Join(",", combinazioniFoto
                            .Where(c => c.guidIDArea == a.guidID && siglaPerCanale.ContainsKey(c.guidIDCanale))
                            .Select(c => siglaPerCanale[c.guidIDCanale])
                            .Where(sigla => !string.IsNullOrWhiteSpace(sigla))
                            .Distinct());

                        return $"<option value=\"{testo(a.sigla)}\" data-canali=\"{testo(canaliDellArea)}\">{testo(a.sigla + " - " + a.nome)}</option>";
                    })));

                    //I20-985: dove vale una foto gia' in archivio. Si scrive solo premendo Salva,
                    //perche' cambiare destinazione a una foto in uso non deve poter succedere per
                    //un tocco di troppo sul menu. Vuoto in archivio vuol dire che vale ovunque, e
                    //nei menu si mostra come tale.
                    Func<long, string, string, IHtmlContent> destinazioneDiUnaFoto = (idFoto, areaFoto, canaleFoto) =>
                    {
                        var canaleScelto = string.IsNullOrWhiteSpace(canaleFoto) ? "*" : canaleFoto;
                        var areaScelta = string.IsNullOrWhiteSpace(areaFoto) ? "*" : areaFoto;

                        return new HtmlString($@"
                        <div class=""destinazioneFotoEsistente mt-2""
                             data-idfoto=""{idFoto}"" data-canale=""{testo(canaleScelto)}"" data-area=""{testo(areaScelta)}"">
                            <div class=""d-flex align-items-center gap-2 mb-1"">
                                <label class=""mb-0 etichettaDestinazioneFoto"" for=""canaleFoto-{idFoto}"" style=""font-size:12px"">Canale</label>
                                <select id=""canaleFoto-{idFoto}"" class=""form-select form-select-sm menuDestinazioneFoto canaleFotoEsistente"" data-azione=""destinazioneFotoEsistente"">
                                    <option value=""*"">Tutti i canali</option>
                                    {opzioniCanale}
                                </select>
                            </div>
                            <div class=""d-flex align-items-center gap-2"">
                                <label class=""mb-0 etichettaDestinazioneFoto"" for=""areaFoto-{idFoto}"" style=""font-size:12px"">Area</label>
                                <select id=""areaFoto-{idFoto}"" class=""form-select form-select-sm menuDestinazioneFoto areaFotoEsistente"" data-azione=""destinazioneFotoEsistente"">
                                    <option value=""*"">Tutte le aree</option>
                                    {opzioniArea}
                                </select>
                            </div>
                        </div>");
                    };

                    //Il pulsante sta accanto all'immagine e compare solo quando c'e' davvero
                    //qualcosa da salvare: un pulsante sempre li', spento, e' un invito a premere
                    //che non porta da nessuna parte.
                    Func<long, IHtmlContent> salvaDestinazioneDiUnaFoto = idFoto =>
                        new HtmlString($@"<button type=""button"" class=""btn btn-sm btn-outline-primary salvaDestinazioneFoto""
                            data-azione=""salvaDestinazioneFoto"" data-idfoto=""{idFoto}"" style=""display:none"">Salva</button>");
                }
                @if (!Model.Gruppo)
                {
                <div class="sezioneFotoProdotto">
                @if (fotoPrimaria != null)
                {
                    nomeFotoPrimaria = System.IO.Path.GetFileNameWithoutExtension(fotoPrimaria.NomeReale!);
                    bool isPostPorodotta = ((_extPostProduzione.Length<=0) || _extPostProduzione.Contains(System.IO.Path.GetExtension(fotoPrimaria.NomeReale!)));
                    string thumbnail = olimpoIp + "/foto/getThumbNailOnDemand?width=150&guidId=" + fotoPrimaria.GuidId;
                    string bigImage = olimpoIp + "/foto/getThumbNailOnDemand?width=800&guidId=" + fotoPrimaria.GuidId;

                    <figure class="figure mb-4 p-2" style="border:3px solid @(isPostPorodotta ? "green" : "red")">
                        <div class="row" style="align-items:center;">
                            <div class="col">
                                <div class="riquadroFotoArticolo">
                                    <img src="@thumbnail" data-bigimg="@bigImage" class="figure-img rounded img-preview-hover" alt="@fotoPrimaria!.NomeReale">
                                </div>
                            </div>
                            <div class="col">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h6 class="mb-0">@fotoPrimaria!.NomeReale</h6>
                                    @salvaDestinazioneDiUnaFoto(fotoPrimaria.Id)
                                </div>
                                <div class="small text-muted foto-articolo-date">@Istanta.Utility.DateFoto.Testo(fotoPrimaria.DataInserimento, fotoPrimaria.DataModifica)</div>
                                <h6 class="mt-2">Primaria selezionata</h6>
                                @destinazioneDiUnaFoto(fotoPrimaria.Id, fotoPrimaria.Area, fotoPrimaria.Canale)
                            </div>
                        </div>                        
                    </figure>

                }

                @{
                    Func<string, string> getNomeGenerico = (string nome) =>
            {
                string ext = System.IO.Path.GetExtension(nome).ToLower();
                return nome.Replace(ext, "");
            };

                   string nomeFotoPrimariaNoExt = System.IO.Path.GetFileNameWithoutExtension(nomeFotoPrimaria);

                }

                @{
                    //I20-985: le foto non in uso si contano prima, perche' il numero serve sia per
                    //decidere se ha senso la tendina sia per dirlo senza costringere ad aprirla.
                    //Di ogni nome si tiene la piu' recente, che e' quella che uscirebbe scegliendo
                    //quel nome, ed e' la stessa regola di prima.
                    var altreFotoArticolo = Model.Foto
                        .Where(f => fotoPrimaria != null && f.Id != fotoPrimaria.Id && f.Tipo == (byte)IstantaLib.TipoFoto.Foto)
                        .GroupBy(g => getNomeGenerico(g.NomeReale))
                        .Select(s => s.OrderByDescending(o => o.DataModifica).FirstOrDefault())
                        .Where(f => f != null && System.IO.Path.GetFileNameWithoutExtension(f.NomeReale) != nomeFotoPrimariaNoExt)
                        .ToList();
                }

                @*I20-985: una decina di foto una sotto l'altra faceva una scheda lunghissima.
                  Stanno raccolte e chiuse: chi deve solo guardare la primaria non se le trova
                  tra i piedi, chi deve cambiarla le apre.*@
                @if (altreFotoArticolo.Count > 0)
                {
                    <div class="mb-3">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#altreFotoArticolo" aria-expanded="false" aria-controls="altreFotoArticolo">
                            Altre foto non selezionate (@altreFotoArticolo.Count)
                        </button>

                        <div class="collapse mt-2" id="altreFotoArticolo">
                            @foreach (var foto in altreFotoArticolo)
                            {
                                string thumbnail = olimpoIp + "/foto/getThumbNailOnDemand?width=150&guidId=" + foto!.GuidId;
                                string bigImage = olimpoIp + "/foto/getThumbNailOnDemand?width=800&guidId=" + foto.GuidId;
                                bool isPostPorodotta = ((_extPostProduzione.Length <= 0) || _extPostProduzione.Contains(System.IO.Path.GetExtension(foto.NomeReale!)));

                                <figure class="figure mb-4 p-2" style="border:3px solid @(isPostPorodotta ? "green" : "red")">
                                    <div class="row" style="align-items:center;">
                                        <div class="col">
                                            <div class="riquadroFotoArticolo">
                                                <img src="@thumbnail" data-bigimg="@bigImage" class="figure-img rounded img-preview-hover" alt="@foto?.NomeReale">
                                            </div>
                                        </div>
                                        <div class="col">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <h6 class="mb-0">@foto!.NomeReale</h6>
                                                @salvaDestinazioneDiUnaFoto(foto.Id)
                                            </div>
                                            <div class="small text-muted foto-articolo-date">@Istanta.Utility.DateFoto.Testo(foto.DataInserimento, foto.DataModifica)</div>
                                            <input type="button" class="btn btn-sm btn-primary" value="Seleziona" data-azione="selezionaPrimaria" data-guidid="@foto.GuidId">
                                            @destinazioneDiUnaFoto(foto.Id, foto.Area, foto.Canale)
                                        </div>
                                    </div>
                                </figure>
                            }
                        </div>
                    </div>
                }

                @*I20-985: da qui si archivia una foto nuova del prodotto. Si sceglie il file, se
                  ne vede l'anteprima e si conferma: fino ad allora non si scrive niente. La foto
                  finisce fra le altre e resta da selezionare, perche caricarla non vuol dire
                  volerla in uso.*@
                <div class="card card-body mt-3 mb-3" id="sezioneNuovaFotoArticolo">
                    @*Ogni etichetta sta in gruppo col suo menu: andando a capo, il gruppo si
                      sposta intero e l'etichetta non finisce sotto al menu sbagliato.*@
                    <div class="mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <label for="canaleNuovaFotoArticolo" class="mb-0 etichettaDestinazioneFoto" style="font-size:12px">Canale</label>
                            <select id="canaleNuovaFotoArticolo" class="form-select form-select-sm menuDestinazioneFoto" data-azione="destinazioneFotoArticolo">
                                <option value="*" selected>Tutti i canali</option>
                                @opzioniCanale
                            </select>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <label for="areaNuovaFotoArticolo" class="mb-0 etichettaDestinazioneFoto" style="font-size:12px">Area</label>
                            <select id="areaNuovaFotoArticolo" class="form-select form-select-sm menuDestinazioneFoto" data-azione="destinazioneFotoArticolo">
                                <option value="*" selected>Tutte le aree</option>
                                @opzioniArea
                            </select>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-success" data-azione="aggiungiFotoArticolo">Aggiungi foto</button>
                        <span class="text-muted" style="font-size:12px">La foto viene archiviata, non selezionata.</span>
                    </div>

                    <div id="anteprimaNuovaFotoArticolo" class="mt-3" style="display:none">
                        <div class="d-flex align-items-center gap-3">
                            <div class="riquadroFotoArticolo border rounded">
                                <img id="imgNuovaFotoArticolo" src="" alt="" />
                                <div id="txtAnteprimaNuovaFotoArticolo" class="text-muted text-center" style="display:none; font-size:11px;"></div>
                            </div>
                            <div>
                                <div id="nomeNuovaFotoArticolo" style="font-size:12px; word-break:break-all;"></div>
                                <div class="mt-2 d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-primary" data-azione="confermaFotoArticolo" id="confermaNuovaFotoArticolo">Conferma</button>
                                    <button type="button" class="btn btn-sm btn-secondary" data-azione="annullaFotoArticolo">Annulla</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <input type="file" id="fileNuovaFotoArticolo" accept="image/*,.psd,.tif,.tiff" style="display:none" data-azione="fileFotoArticoloScelto" />
                </div>
                </div>
                }

                @*I20-983: le foto extra si raggruppano per tipo, come nel pannello del Plugin, e
                  ogni gruppo porta i suoi due modi di aggiungerne: caricare un file nuovo oppure
                  collegare un'immagine gia' a sistema.*@
                @{
                    var tipiFotoExtra = new[] {
                        new { Val = (byte)IstantaLib.TipoFoto.Bollino, Nome = "Bollini" },
                        new { Val = (byte)IstantaLib.TipoFoto.Logo, Nome = "Loghi" },
                        new { Val = (byte)IstantaLib.TipoFoto.Ambientata, Nome = "Foto ambientate" },
                        new { Val = (byte)IstantaLib.TipoFoto.Sfondo, Nome = "Sfondo" }
                    };

                    //Per una referenza le sue, una per nome; per un gruppo quelle comuni a tutte le
                    //referenze (FotoExtraDiPiuArticoli), calcolate dal controller.
                    var fotoExtraArticolo = Model.Extra;
                }

                <div class="mt-3">
                    <h5>Foto extra</h5>
                </div>

                @foreach (var tipoExtra in tipiFotoExtra)
                {
                    var fotoDelTipo = fotoExtraArticolo.Where(f => f.Tipo == tipoExtra.Val).ToList();

                    <div class="fotoExtraSezione mb-4" data-tipo="@tipoExtra.Val">
                        <h6 class="border-bottom border-secondary pb-1">@tipoExtra.Nome</h6>

                        @if (fotoDelTipo.Count == 0)
                        {
                            <div class="fst-italic text-muted mb-2" style="font-size:12px">Nessun elemento</div>
                        }

                        @foreach (Istanta.Models.ArticoliFoto foto in fotoDelTipo)
                        {
                            string thumbnail = olimpoIp + "/foto/getThumbNailOnDemand?width=40&guidId=" + foto.GuidId;
                            string bigImage = olimpoIp + "/foto/getThumbNailOnDemand?width=800&guidId=" + foto.GuidId;

                            <figure class="figure w-50 mb-3 p-2 border border-primary">
                                <div class="row" style="align-items:center;">
                                    <div class="col">
                                        <h6>@foto!.NomeReale</h6>
                                        <div class="small text-muted foto-articolo-date mb-1">@Istanta.Utility.DateFoto.Testo(foto.DataInserimento, foto.DataModifica)</div>
                                        <img src="@thumbnail" data-bigimg="@bigImage" class="figure-img img-fluid rounded img-preview-hover" alt="@foto!.NomeReale">
                                    </div>
                                    <div class="col">
                                        <input type="hidden" class="fotoExtraDati" data='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(foto))'/>
                                        <input type="button" class="btn btn-sm btn-danger" value="Elimina" data-azione="eliminaFotoExtra">
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" id="fotoExtraAttiva-@foto.Id" guidid="@foto.GuidId" @(foto.Attiva == true ? "checked" : string.Empty) data-azione="attivaFotoExtra">
                                            <label class="form-check-label" for="fotoExtraAttiva-@foto.Id">Attiva</label>
                                        </div>
                                    </div>
                                </div>
                            </figure>
                        }

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-success" data-azione="aggiungiFotoExtra" data-tipo="@tipoExtra.Val">Aggiungi @tipoExtra.Nome</button>
                            <button type="button" class="btn btn-sm btn-outline-success" data-azione="collegaFotoExtra" data-tipo="@tipoExtra.Val" data-nometipo="@tipoExtra.Nome">Collega a immagine a sistema</button>
                        </div>
                    </div>
                }

                @*Indirizzo di Olimpo per le miniature del catalogo, come nelle altre pagine.*@
                @*Nel revisore la pagina ha gia' il suo: due elementi con lo stesso id si confonderebbero.*@
                @if (!Model.InFinestra)
                {
                    <input type="hidden" id="ipOlympus" value="@olimpoIp" />
                }

                @*Uno solo per tutta la pagina: il tipo scelto si tiene sull'elemento stesso.*@
                <input type="file" id="fileNuovaFotoExtra" accept="image/*,.psd,.tif,.tiff" style="display:none" data-azione="fileFotoExtraScelto" />
            </div>
        </div>

        @*Il catalogo delle immagini gia' a sistema, filtrato sul tipo da collegare. Sta nella sezione
          invece che in una finestra a parte: nel revisore la sezione e' gia' in una finestra, e una
          finestra sopra l'altra Bootstrap non la gestisce bene.*@
        <div class="pannelloCollegaFotoExtra" style="display:none">
            <div class="d-flex align-items-center gap-2 mb-3">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-azione="chiudiCollegaFotoExtra">Indietro</button>
                <h5 class="mb-0 titoloCollegaFotoExtra">Collega a immagine a sistema</h5>
            </div>
            <div class="corpoCollegaFotoExtra"></div>
        </div>
    }
</div>
