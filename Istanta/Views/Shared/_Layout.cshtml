    <div class="toast position-fixed" role="alert" aria-live="assertive" aria-atomic="true" id="clipToast" data-bs-delay="2000" style="top:10px;right:10px;background:#a1e3be;z-index:9999999">
        <div class="d-flex">
            <div class="toast-body">
                Token copiato!
            </div>
        </div>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2022 - Istanta - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>


    <script nonce="@Context.Items["ScriptNonce"]" src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js" type="text/javascript"></script>

    <script nonce="@Context.Items["ScriptNonce"]">
        $("#btnUser").on("click", function () {

            //Apri modal
            showUserInfoModal();

            //Disegno panello per creazione token di accesso
            Call.do("LoginController", "getTokenDiAccesso", "GET", null, this, function (result, sender) {

                let container = $(".modal-body").find("#tokenContainer");
                let tokenDiv = $(`<div class="container" style="
                    width: 95%;
                    border: 2px solid blue;
                    padding: 6px;
                    margin: 10px;
                    border-radius: 17px;
                    ">
                    <div class="row">
                    <div class="col-8" style="
                    padding-left: 30px;
                    padding-top: 16px;
                    ">
                    <span><strong>Token di accesso</strong></span>
                    <p style="margin:3px;"><button type="button" id="btnCopyToken" class="btn btn-primary btn-sm me-2">Copia</button><span id="idAccessToken">-</span></p>
                    </div>
                    <div class="col-4 text-center">
                    <span style="
                    font-size: 10px;
                    ">Scade tra</span><br>
                    <strong id="durationAccessToken" style="
                    font-size: 30px;
                    ">-</strong><br>
                    <span style="
                    font-size: 10px;
                    ">sec.</span>
                    </div>
                    </div>
                    </div>`);

                

                if (result.error != "user_no_need_token") {
                    container.append(tokenDiv);
                    $("#btnCopyToken").on("click", function () {
                    // Copia il token negli appunti
                    console.log("click to copy token");
                    const token = $("#idAccessToken").text();

                    navigator.clipboard.writeText(token).then(function () {
                    var toastLiveExample = document.getElementById('clipToast')
                    var toast = new bootstrap.Toast(toastLiveExample);
                    toast.show();

                    }, function (err) {
                    alert("Errore nel copiare il token: ", err);
                    });
                    });

                    if (result.error == null || result.error == "") {
                    // Mostra il token di accesso
                    $("#idAccessToken").text(result.token);
                    // Avvia il conto alla rovescia per la scadenza del token
                    let duration = result.duration;
                    $("#durationAccessToken").text(parseInt(duration / 1000));
                    const countdownInterval = setInterval(function () {
                    duration -= 1000;
                    $("#durationAccessToken").text(parseInt(duration / 1000));
                    if (duration <= 0) {
                    clearInterval(countdownInterval);
                    $("#durationAccessToken").text("-");
                    $("#idAccessToken").text("Il token è scaduto");
                    $("#btnCopyToken").css("display", "none");
                    }
                    }, 1000);
                    }
                    else {
                    //Errore da riportare a video perchè non previsto
                    $("#idAccessToken").text("Errore: " + result.error);
                    }
                }

               

            });

        });

        function showUserInfoModal() {
            const userName = $("#utenteLoggato").val();
            const modalHtml = `
            <div class="modal fade
            " id="userInfoModal" tabindex="-1" aria-labelledby="userInfoModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="userInfoModalLabel">Cambio password</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div>
                                <p><strong>Nome:</strong> ${userName}</p>
                            </div>
                            <div id="tokenContainer">

                            </div>
                            <div>
                                <label for="oldPassword" class="form-label">Password attuale:</label>
                                <input type="password" class="form-control" id="oldPassword" />
                            </div>
                            <div>
                                <label for="newPassword" class="form-label">Conferma Password:</label>
                                <input type="password" class="form-control" id="confirmPassword" />
                            </div>
                            <div>
                                <label for="repeatNewPassword" class="form-label">Ripeti Nuova Password:</label>
                                <input type="password" class="form-control" id="repeatNewPassword" />
                            </div>
                            <div style="margin-top:10px;font-size:11px;color:red;">
                                <span>La password deve contenere almeno 8 caratteri, di cui una maiuscola, una minuscola, un numero e un carattere speciale tra questi (&#64;,!,=,%,$,^,_,-)</span>
                            </div>
                            <div>
                                <button type="button" class="btn btn-primary mt-3" id="changePasswordBtn">Cambia Password</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            `;            

            $("body").append(modalHtml);

            $("#changePasswordBtn").on("click", function () {
                const oldPassword = $("#oldPassword").val();
                const newPassword = $("#confirmPassword").val();
                const repeatNewPassword = $("#repeatNewPassword").val();
                if (newPassword !== repeatNewPassword) {
                    alert("La nuova password e la ripetizione non corrispondono.");
                    return;
                }
                // Esegui la chiamata AJAX per cambiare la password
                $.ajax({
                    url: '/LoginController/ChangePassword',
                    type: 'POST',
                    data: {
                        oldPassword: oldPassword,
                        newPassword: newPassword
                    },
                    success: function (response) {
                        
                        if (response.esito) {
                            alert("Password cambiata con successo");
                            $('#userInfoModal').modal('hide');
                        }
                        else
                        {
                            alert("Errore: " + response.error);
                        }
                    },
                    error: function () {
                        alert("Si è verificato un errore durante il cambio della password.");
                    }
                });

            });

            const userInfoModal = new bootstrap.Modal(document.getElementById('userInfoModal'));
            userInfoModal.show();
            $('#userInfoModal').on('hidden.bs.modal', function () {
                $(this).remove();
            });
            

        }
             
        $(".navbar-brand.fp").on("click", function () {
            showLoading();
            apriLinkEsterno("fp");
        });

        $(".navbar-brand.correggo").on("click", function () {
            showLoading();
            apriLinkEsterno("correggo");
        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
