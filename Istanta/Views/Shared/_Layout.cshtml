    @inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
    <script nonce ="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" type="module">
        
        function loadScript(src) {
            return new Promise((resolve, reject) => {
                const script = document.createElement('script');
                script.src = src;
                script.onload = () => resolve();
                script.onerror = () => reject(new Error(`Errore nel caricamento: ${src}`));
                document.head.appendChild(script);
            });
        }
        

        async function loadScriptsInOrder() {

            const dynamicId = uuidv4();

            await loadScript(`${webRootFolder}/js/IAgenzia.js?id=${dynamicId}`);
            await loadScript(`${webRootFolder}/js/utility.js?id=${dynamicId}`); // dipende da lib1
            await loadScript(`${webRootFolder}/js/call.js?id=${dynamicId}`); // dipende da lib2
            await loadScript(`${webRootFolder}/js/agenzia.js?id=${dynamicId}`); // dipende da lib2
            await loadScript(`${webRootFolder}/js/revisore.js?id=${dynamicId}`); // dipende da lib2
            await loadScript(`${webRootFolder}/js/components.js?id=${dynamicId}`); // dipende da lib2
            await loadScript(`${webRootFolder}/js/archivio.js?id=${dynamicId}`); // dipende da lib2
            await loadScript(`${webRootFolder}/js/ordinamento.js?id=${dynamicId}`); // dipende da lib2
            await loadScript(`${webRootFolder}/js/taskManager.js?id=${dynamicId}`);
            await loadScript(`${webRootFolder}/js/addestramento.js?id=${dynamicId}`);
            await loadScript(`${webRootFolder}/js/promo.js?id=${dynamicId}`);
            await loadScript(`${webRootFolder}/js/syncfoto.js?id=${dynamicId}`);
            await loadScript(`${webRootFolder}/js/declinazioneMeccaniche.js?id=${dynamicId}`);
            await loadScript(`${webRootFolder}/js/etichette.js?id=${dynamicId}`);
            await loadScript(`${webRootFolder}/js/frameworkCss.js?id=${dynamicId}`);
            await loadScript(`${webRootFolder}/js/loghibolli.js?id=${dynamicId}`);  
            await loadScript(`${webRootFolder}/js/confronti.js?id=${dynamicId}`);
            setTimeout(() => {
                loadScript(`${webRootFolder}/js/site.js?id=${dynamicId}`);
            }, 1000);
            


        }

        loadScriptsInOrder();



    </script>


</head>
