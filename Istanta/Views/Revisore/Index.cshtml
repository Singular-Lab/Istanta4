@model Istanta.Views.Revisore.IndexModel
@{
    var Tracc = new List<Istanta.Models_2.PromoTracciati>();//ViewBag.Tracciato as Istanta.Models_2.PromoTracciati;
    var idTracc = 0;//ViewBag.Tracciato as Istanta.Models_2.PromoTracciati;
    var idPromo = 0;
    var nomePromo = "";
    var siglaTracc = "";
    var idOlimpo = "";
    var listAree = new List<string>();
    var listCanali = new List<string>();
    if (ViewBag.Tracciato != null)
    {
        var tItem = (ViewBag.Tracciato as List<Istanta.Models_2.PromoTracciati>);
        Tracc = tItem;
        if (Tracc!.Count == 1)
        {
            idTracc = Tracc[0].Id;
            siglaTracc = Tracc[0].Sigla;
        }


        foreach (var trac in Tracc)
        {
            if (!listAree.Contains(trac.Area!))
            {
                listAree.Add(trac.Area!);
            }

            if (!listCanali.Contains(trac.Canale!))
            {
                listCanali.Add(trac.Canale!);
            }
        }

    }
    if (ViewBag.Promo != null)
    {
        var pItem = (ViewBag.Promo as Istanta.Models_2.Promo);
        idPromo = pItem!.Id;
        nomePromo = pItem.NomePromo;

        foreach (var trac in pItem.PromoTracciatis)
        {
            if (!listAree.Contains(trac.Area!))
            {
                listAree.Add(trac.Area!);
            }

            if (!listCanali.Contains(trac.Canale!))
            {
                listCanali.Add(trac.Canale!);
            }
        }
    }
    idOlimpo = @ViewBag.ipOlympus as string;
}

<style>
  /* Contenitore con look “input” Bootstrap */
  .origini-switch{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border:1px solid #ced4da;
    border-radius:.375rem;             /* ~ .form-select rounded */
    background:#fff;
    height:calc(2.25rem + 2px);        /* ~ altezza .form-select */
    padding:0 .25rem;
    background-color:transparent;
  }

  /* Frecce “attaccate” al testo */
  .origini-switch .arrow{
    background:transparent;
    border:0;
    padding:0;                         /* niente padding = attaccate */
    margin:0;
    line-height:1;
    font-size:30px;
    cursor:pointer;
    user-select:none;
    width:40px;
  }

   .origini-switch .origine {
        display: inline-block;
        padding: 0; /* niente padding = attaccata alle frecce */
        margin: 0 .125rem; /* opzionale, quasi zero */
        font-weight: 500;
        white-space: nowrap;
        min-width: 20ch; /* evita “saltelli” con stringhe corte */
        text-align: center;
        width: fit-content; /* si adatta al contenuto sopra x */
        max-width: 100%;
   }

  /* Accessibilità focus */
  .origini-switch .arrow:focus-visible{
    outline:2px solid #0d6efd;
    outline-offset:2px;
    border-radius:.25rem;
  }
</style>

