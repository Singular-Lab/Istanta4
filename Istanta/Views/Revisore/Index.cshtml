@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" src="~/js/mySocket.js?v=1.0.0.15"></script>
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" type="text/javascript">

    let revInstance;
    let ordInstance;
    let socket;

    function documentReady()
    {
        revInstance = new Revisore();
        ordInstance = new Ordinamento();
        revInstance.olimpoIp = $("#ipOlympus").val();
        let el = $("#datiTracciato")[0]; // ottieni il DOM element puro
        const aree = JSON.parse(el.dataset.aree);
        const canali = JSON.parse(el.dataset.canali);
        revInstance.areePromo = aree;
        revInstance.canaliPromo = canali;
        let tracciati = @Html.Raw(Json.Serialize(Tracc));
        let listaIdTracciatiIniziali = [];
        tracciati.forEach(function(item){
            listaIdTracciatiIniziali.push(item.id);
        });
        revInstance.listIdTracciatiPartenza = listaIdTracciatiIniziali;
        revInstance.listIdTracciatiRichiesti = listaIdTracciatiIniziali;
        revInstance.compilaTracciati();
        revInstance.loadLabel();

        $("#CmbTracciato").on("change", function(){
            revInstance.cerca(0);
        });

        $("#nascondiGruppo").on("change", function(){
            revInstance.nascondiGruppi(this.checked);
        });

        $("#filtraPerGruppiOSingoli").on("change", function(){
            revInstance.controllaModalita();
        });


        $("#btnPreparaLista").on("click", function(){
            revInstance.preparaListaDaCaricare(0);
        });

        $("#btnReset").on("click", function(){
            reset();
        });

        $("#ch_articoli_da_revisionare").on("click", function(){
            revInstance.preparaListaDaCaricare(0);
        });

         $("#ch_articoli_revisionati").on("click", function(){
            revInstance.preparaListaDaCaricare(0);
        });


        $(".btnPagPrec").on("click", function(){
            revInstance.checkPageRequest(revInstance.getCurrentPage()-1);
            window.scrollTo(0,0);
        });

        $(".btnPagSucc").on("click", function(){
            revInstance.checkPageRequest(revInstance.getCurrentPage()+1);
            window.scrollTo(0,0);
        });
        
        $("#btnTornaSu").on("click", function(){
            window.scrollTo(0,0);
        });
        
        $("#floatingSalvaGruppo").on("click", function(){
            revInstance.salvaTuttoRevisioni();
        });

        $("#btnAddModalDescrReg").on("click", function(){
            revInstance.aggiungiCombinazione($(this).closest('.modal'));
        });

        $(".currentPage").on("input", function(){
            revInstance.checkPageRequest(this.value);
        });
        $(".currentPage").on("keypress", function(){
            return event.charCode != 13;
        });
        
        socket=new MySocket(revInstance.socketOnMessage,function(){},function(){},function(){});
        
    }



    function reset()
    {
        $("#search_codice").val("");
        $("#search_nome").val("");
        $("#search_brand").val("");
        $("#search_tipogusto").val("");
        $("#search_gramm").val("");
        $("#search_segmento").val("");
    }

</script>