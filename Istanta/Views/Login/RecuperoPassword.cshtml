@page
@model Istanta.Views.RecuperoPassword.IndexModel
@{
    Layout = "_LayoutLogin";
}


<div style="display: flex; justify-content:center; align-items: center; width:100%; margin-top:15%;">
    <div style="width: 100%; max-width: 400px; padding: 20px; border: 1px solid #ddd; border-radius: 10px; background-color: #fff; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
        <h2 class="text-center mb-4">Recupero password</h2>
        <div class="mb-3">
            <h5>@ViewBag.NomeUtente</h5>
            <p>E-mail: @ViewBag.EmailUtente</p>
        </div>
        <div id="panelAction">
            <div class="mb-3">
                <label for="password" class="form-label">Nuova Password</label>
                <div class="input-group">
                    <input type="password" name="password" class="form-control" id="password" placeholder="Inserisci la tua password">
                    <span class="input-group-text" id="toggle-password" style="cursor: pointer;">
                        <i class="bi bi-eye" id="eye-icon"></i>
                    </span>
                </div>
            </div>
            <div class="mb-3">
                <label for="passwordConferma" class="form-label">Conferma Password</label>
                <div class="input-group">
                    <input type="password" name="passwordConferma" class="form-control" id="passwordConferma" placeholder="Conferma la tua password">
                    <span class="input-group-text" id="toggle-password" style="cursor: pointer;">
                        <i class="bi bi-eye" id="eye-icon"></i>
                    </span>
                </div>
            </div>
            <div style="display: grid;">
                <button type="submit" id="btncambioPassword" class="btn btn-primary">Cambia password</button>
            </div>
        </div>
        <div style="display: none;" id="panelSuccess">
            <p>Password cambiata con successo</p>
            <a href="/Login">Vai al login</a>
        </div>
    </div>

    @inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
    <script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]">
         function documentReady() {
            $('#toggle-password').on('mousedown', function () {
                $('#password').attr('type', 'text');
                $('#eye-icon').removeClass('bi-eye').addClass('bi-eye-slash');
            });

            $('#toggle-password').on('mouseup mouseout', function () {
                $('#password').attr('type', 'password');
                $('#eye-icon').removeClass('bi-eye-slash').addClass('bi-eye');
            });


            $("#btncambioPassword").on("click", function (e) {
                e.preventDefault();

                const newPassword = $("#password").val();
                const repeatNewPassword = $("#passwordConferma").val();
                if (newPassword !== repeatNewPassword) {
                    alert("La nuova password e la ripetizione non corrispondono.");
                    return;
                }

                $.ajax({
                    url: '/LoginController/ResetPassword',
                    type: 'POST',
                    data: {
                        newPassword: newPassword
                    },
                    success: function (response) {

                        if (response.esito) {
                            alert("Password cambiata con successo");
                            $("#panelAction").css("display","none");
                            $("#panelSuccess").css("display","block");
                        }
                        else
                        {
                            alert("Errore: " + response.error);
                        }
                    },
                    error: function () {
                        alert("Si è verificato un errore durante il cambio della password.");
                    }
                });
            });
        }
    </script>
</div>
