        <button id="aggiungiNuovaRegolaButton" class="btn btn-primary" onclick="trainer.nuovaRegolaButton($(this))">Aggiungi regola</button>
        <div id="orDiv" style="display: none;">OR</div>
    </div>
</template>

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" type="text/javascript">


    let trainer;
    function documentReady() {

        trainer = new Addestramento();
        //trainer.getFormati("Aumenta fino a: ");
        //trainer.getMeccaniche();
        $("#cmbAddestramenti").on("change", function () {
            trainer.selezionaAddestramento();
        });

        $("#btnImporta").on("click", function(){
            trainer.importa();
        });


    }

</script>