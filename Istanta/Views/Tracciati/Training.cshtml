<template id="setRegoleTemplate">
    <div id="setRegoleParent">
        <div class="mt-3 bg-success bg-opacity-10 fs-3">Set</div>
        <div id="setRegole" class="bg-success bg-opacity-10 setRegole"></div>
        <button id="aggiungiNuovaRegolaButton" class="btn btn-primary aggiungiNuovaRegolaButton mt-2" onclick="trainer.nuovaRegolaButton($(this))">Aggiungi regola</button>
        <button id="rimuovi intero set" class="btn btn-warning rimuoviSetRegoleButton mt-2" onclick="trainer.rimuoviSetRegoleButton($(this))">Rimuovi intero set regole</button>
        <div class="border-top"></div>
    </div>
</template>
<template id="regolaTemplate">
    <div class="row mt-2 bg-success bg-opacity-25 regola" id="regola">
        <div class="col-4 d-flex align-items-center">
            <label for="campoAddestramentoRegola">Campo</label>
            <select data-live-search="true" class="ms-2 selectpicker" id="campoAddestramentoRegola" name="campoAddestramentoRegola">
                <option value="0">Seleziona campo</option>
            </select>
        </div>
        <div class="col-3 d-flex align-items-center">
            <select class="selectpicker" data-live-search="true" id="operatoreDiConfrontoRegola" name="operatoreDiConfrontoRegola">
                <option value="0">Uguale</option>
                <option value="1">Diverso</option>
                <option value="2">Contiene</option>
                <option value="3">Non contiene</option>
                <option value="4">Inizia con</option>
                <option value="5">Finisce con</option>
                <option value="6">Maggiore di</option>
                <option value="7">Maggiore o uguale di</option>
                <option value="8">Minore di</option>
                <option value="9">Minore o uguale di</option>
            </select>
        </div>
        <div class="col-4 d-flex align-items-center">
            <input type="text" id="valoreRegola" name="valoreRegola">
        </div>
        <div class="col-1 d-flex justify-content-end align-items-center">
            <button type="button" class="btn-close" aria-label="Close" onclick="trainer.rimuoviRegola($(this))"></button>
        </div>
    </div>
</template>
