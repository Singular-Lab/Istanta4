            <button type="button" @*class="btn btn-primary"*@ aria-label="" onclick="trainer.rimuoviSetRegole($(this).closest('#regolaPreview').attr('idRegola'), $(this).closest('#regolaPreview').attr('idAddestramento'), null)"><i class="fas fa-trash-alt" style="color: red;"></i></button>
