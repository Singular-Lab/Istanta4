                            </div>
                            <div class="col-auto d-flex align-items-center">
                                <button id="eliminaRegola" type="button" class="btn btn-danger mt-2" aria-label="" onclick="trainer.rimuoviSetRegole($(this).closest('#modificaRegola').attr('idRegola'), $(this).closest('#modificaRegola').attr('idAddestramento'), $(this).closest('.modal'))">Elimina</button>
