@page
@model Istanta.Views.SchedaArticolo.IndexModel
@using IstantaLib;
@{
    string[] _extPostProduzione = (string[])ViewBag.extPostProduzione;
}

@{
    var olimpoIp = (ViewBag.ipOlympus as string);
    var itemBind = (ViewBag.Item as Istanta.Models.Articoli)!;
    // foreach (var item in itemBind.ArticoliDescrizionis!)
    // {
    //     item.IdArticoloNavigation = null;
    // }
    // foreach (var item in itemBind.ArticoliFotos!)
    // {
    //     item.IdArticoloNavigation = null;
    // }
    foreach (var d in itemBind.ArticoliDescrizionis!)
        d.IdArticoloNavigation = null;
    foreach (var f in itemBind.ArticoliFotos!)
        f.IdArticoloNavigation = null;

    var itemDescr = itemBind.ArticoliDescrizionis!.Where(f => f.Canale == null && f.Area == null).FirstOrDefault();
    var fotoPrimaria = itemBind.ArticoliFotos!.Where(f => !f.Tipo.HasValue || f.Tipo == (Byte)IstantaLib.TipoFoto.Foto).OrderByDescending(o => o.DataModifica).FirstOrDefault();
}

<div class="container">
    <div class="row mt-3 mb-5">
        <div class="col">
            <input type="hidden" id="itemBind"
            data='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(itemBind))' />

            <input type="hidden" itemBind="@itemBind" />
            @if (itemBind.UltimaRevisione.HasValue)
            {
                <h5>Ultima revisione: @itemBind.UltimaRevisione.Value.ToString("dd/MM/yyyy HH:mm")</h5>
            }
            @if (itemBind.Segmento != null && itemBind.Segmento != "")
            {
                <h5>Segmento: @itemBind.Segmento</h5>
            }
        </div>
    </div>
    @if (ViewBag.error != null)
    {
        <div class="alert alert-dismissible alert-danger" role="alert">
            @ViewBag.error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row mb-5">
        <div class="col-4">
            <h5>Foto</h5>
            <div class="container">
                @{
                    string nomeFotoPrimaria = "";
                }
                @if (fotoPrimaria != null)
                {
                    nomeFotoPrimaria = System.IO.Path.GetFileNameWithoutExtension(fotoPrimaria.NomeReale!);
                    bool isPostPorodotta = ((_extPostProduzione.Length<=0) || _extPostProduzione.Contains(System.IO.Path.GetExtension(fotoPrimaria.NomeReale!)));
                    string thumbnail = olimpoIp + "/foto/getThumbNailOnDemand?width=150&guidId=" + fotoPrimaria.GuidId;
                    string bigImage = olimpoIp + "/foto/getThumbNailOnDemand?width=800&guidId=" + fotoPrimaria.GuidId;

                    <figure class="figure mb-4 p-2" style="border:3px solid @(isPostPorodotta ? "green" : "red")">
                        <div class="row" style="align-items:center;">
                            <div class="col">
                                <div class="riquadroFotoArticolo">
                                    <img src="@thumbnail" data-bigimg="@bigImage" class="figure-img rounded img-preview-hover" alt="@fotoPrimaria!.NomeReale">
                                </div>
                            </div>
                            <div class="col">
                                <h6>@fotoPrimaria!.NomeReale</h6>
                                <h6>Primaria selezionata</h6>
                            </div>
                        </div>                        
                    </figure>

                }

                @{
                    Func<string, string> getNomeGenerico = (string nome) =>
            {
                string ext = System.IO.Path.GetExtension(nome).ToLower();
                return nome.Replace(ext, "");
            };

                   string nomeFotoPrimariaNoExt = System.IO.Path.GetFileNameWithoutExtension(nomeFotoPrimaria);

                }

                @{
                    //I20-985: le foto non in uso si contano prima, perche' il numero serve sia per
                    //decidere se ha senso la tendina sia per dirlo senza costringere ad aprirla.
                    //Di ogni nome si tiene la piu' recente, che e' quella che uscirebbe scegliendo
                    //quel nome, ed e' la stessa regola di prima.
                    var altreFotoArticolo = itemBind.ArticoliFotos!
                        .Where(f => fotoPrimaria != null && f.Id != fotoPrimaria.Id && f.Tipo == (byte)IstantaLib.TipoFoto.Foto)
                        .GroupBy(g => getNomeGenerico(g.NomeReale))
                        .Select(s => s.OrderByDescending(o => o.DataModifica).FirstOrDefault())
                        .Where(f => f != null && System.IO.Path.GetFileNameWithoutExtension(f.NomeReale) != nomeFotoPrimariaNoExt)
                        .ToList();
                }

                @*I20-985: una decina di foto una sotto l'altra faceva una scheda lunghissima.
                  Stanno raccolte e chiuse: chi deve solo guardare la primaria non se le trova
                  tra i piedi, chi deve cambiarla le apre.*@
                @if (altreFotoArticolo.Count > 0)
                {
                    <div class="mb-3">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#altreFotoArticolo" aria-expanded="false" aria-controls="altreFotoArticolo">
                            Altre foto non selezionate (@altreFotoArticolo.Count)
                        </button>

                        <div class="collapse mt-2" id="altreFotoArticolo">
                            @foreach (var foto in altreFotoArticolo)
                            {
                                string thumbnail = olimpoIp + "/foto/getThumbNailOnDemand?width=150&guidId=" + foto!.GuidId;
                                string bigImage = olimpoIp + "/foto/getThumbNailOnDemand?width=800&guidId=" + foto.GuidId;
                                bool isPostPorodotta = ((_extPostProduzione.Length <= 0) || _extPostProduzione.Contains(System.IO.Path.GetExtension(foto.NomeReale!)));

                                <figure class="figure mb-4 p-2" style="border:3px solid @(isPostPorodotta ? "green" : "red")">
                                    <div class="row" style="align-items:center;">
                                        <div class="col">
                                            <div class="riquadroFotoArticolo">
                                                <img src="@thumbnail" data-bigimg="@bigImage" class="figure-img rounded img-preview-hover" alt="@foto?.NomeReale">
                                            </div>
                                        </div>
                                        <div class="col">
                                            <h6>@foto!.NomeReale</h6>
                                            <input type="button" class="btn btn-sm btn-primary" value="Seleziona" data-azione="selezionaPrimaria" data-guidid="@foto.GuidId">
                                        </div>
                                    </div>
                                </figure>
                            }
                        </div>
                    </div>
                }

                @*I20-985: da qui si archivia una foto nuova del prodotto. Si sceglie il file, se
                  ne vede l'anteprima e si conferma: fino ad allora non si scrive niente. La foto
                  finisce fra le altre e resta da selezionare, perche caricarla non vuol dire
                  volerla in uso.*@
                <div class="card card-body mt-3 mb-3" id="sezioneNuovaFotoArticolo">
                    @{
                        //I20-985: le destinazioni sono quelle di Settings, voce Aree e Canali:
                        //gli elenchi di aree e canali e la matrice che dice quali coppie sono
                        //attive. Nei menu si mostrano le sigle, che sono cio' che il server
                        //scrive nella foto, e ogni canale porta addosso le aree con cui e'
                        //attivo, cosi' scegliendo un'area restano solo i canali previsti.
                        var areeFoto = ViewBag.areeFoto as List<Area> ?? new List<Area>();
                        var canaliFoto = ViewBag.canaliFoto as List<Canale> ?? new List<Canale>();
                        var combinazioniFoto = ViewBag.combinazioniFoto as List<CombinazioneAreaCanale> ?? new List<CombinazioneAreaCanale>();
                        var siglaPerArea = areeFoto.GroupBy(a => a.guidID).ToDictionary(g => g.Key, g => g.First().sigla);
                    }

                    <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                        <label for="areaNuovaFotoArticolo" style="font-size:12px">Area</label>
                        <select id="areaNuovaFotoArticolo" class="form-select form-select-sm" style="width:auto" data-azione="destinazioneFotoArticolo">
                            <option value="">Scegli...</option>
                            <option value="*">Tutte le aree</option>
                            @foreach (var area in areeFoto.OrderBy(a => a.nome))
                            {
                                <option value="@area.sigla">@area.sigla - @area.nome</option>
                            }
                        </select>

                        <label for="canaleNuovaFotoArticolo" style="font-size:12px">Canale</label>
                        <select id="canaleNuovaFotoArticolo" class="form-select form-select-sm" style="width:auto" data-azione="destinazioneFotoArticolo">
                            <option value="">Scegli...</option>
                            <option value="*">Tutti i canali</option>
                            @foreach (var canale in canaliFoto.OrderBy(c => c.nome))
                            {
                                var areeDelCanale = string.Join(",", combinazioniFoto
                                    .Where(c => c.guidIDCanale == canale.guidID && siglaPerArea.ContainsKey(c.guidIDArea))
                                    .Select(c => siglaPerArea[c.guidIDArea])
                                    .Where(sigla => !string.IsNullOrWhiteSpace(sigla))
                                    .Distinct());
                                <option value="@canale.sigla" data-aree="@areeDelCanale">@canale.sigla - @canale.nome</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-success" data-azione="aggiungiFotoArticolo">Aggiungi foto</button>
                        <span class="text-muted" style="font-size:12px">La foto viene archiviata, non selezionata.</span>
                    </div>

                    <div id="anteprimaNuovaFotoArticolo" class="mt-3" style="display:none">
                        <div class="d-flex align-items-center gap-3">
                            <div class="riquadroFotoArticolo border rounded">
                                <img id="imgNuovaFotoArticolo" src="" alt="" />
                                <div id="txtAnteprimaNuovaFotoArticolo" class="text-muted text-center" style="display:none; font-size:11px;"></div>
                            </div>
                            <div>
                                <div id="nomeNuovaFotoArticolo" style="font-size:12px; word-break:break-all;"></div>
                                <div class="mt-2 d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-primary" data-azione="confermaFotoArticolo" id="confermaNuovaFotoArticolo" disabled>Conferma</button>
                                    <button type="button" class="btn btn-sm btn-secondary" data-azione="annullaFotoArticolo">Annulla</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <input type="file" id="fileNuovaFotoArticolo" accept="image/*,.psd,.tif,.tiff" style="display:none" data-azione="fileFotoArticoloScelto" />
                </div>

                @*I20-983: le foto extra si raggruppano per tipo, come nel pannello del Plugin, e
                  ogni gruppo porta i suoi due modi di aggiungerne: caricare un file nuovo oppure
                  collegare un'immagine gia' a sistema.*@
                @{
                    var tipiFotoExtra = new[] {
                        new { Val = (byte)IstantaLib.TipoFoto.Bollino, Nome = "Bollini" },
                        new { Val = (byte)IstantaLib.TipoFoto.Logo, Nome = "Loghi" },
                        new { Val = (byte)IstantaLib.TipoFoto.Ambientata, Nome = "Foto ambientate" },
                        new { Val = (byte)IstantaLib.TipoFoto.Sfondo, Nome = "Sfondo" }
                    };

                    var fotoExtraArticolo = itemBind.ArticoliFotos!
                        .Where(f => f.Tipo.HasValue && f.Tipo != (byte)IstantaLib.TipoFoto.Foto)
                        .GroupBy(g => g.NomeReale)
                        .Select(s => s.First())
                        .ToList();
                }

                <div class="mt-3">
                    <h5>Foto extra</h5>
                </div>

                @foreach (var tipoExtra in tipiFotoExtra)
                {
                    var fotoDelTipo = fotoExtraArticolo.Where(f => f.Tipo == tipoExtra.Val).ToList();

                    <div class="fotoExtraSezione mb-4" data-tipo="@tipoExtra.Val">
                        <h6 class="border-bottom border-secondary pb-1">@tipoExtra.Nome</h6>

                        @if (fotoDelTipo.Count == 0)
                        {
                            <div class="fst-italic text-muted mb-2" style="font-size:12px">Nessun elemento</div>
                        }

                        @foreach (Istanta.Models.ArticoliFoto foto in fotoDelTipo)
                        {
                            string thumbnail = olimpoIp + "/foto/getThumbNailOnDemand?width=40&guidId=" + foto.GuidId;
                            string bigImage = olimpoIp + "/foto/getThumbNailOnDemand?width=800&guidId=" + foto.GuidId;

                            <figure class="figure w-50 mb-3 p-2 border border-primary">
                                <div class="row" style="align-items:center;">
                                    <div class="col">
                                        <h6>@foto!.NomeReale</h6>
                                        <img src="@thumbnail" data-bigimg="@bigImage" class="figure-img img-fluid rounded img-preview-hover" alt="@foto!.NomeReale">
                                    </div>
                                    <div class="col">
                                        <input type="hidden" id="fotoExtra" data='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(foto))'/>
                                        <input type="button" class="btn btn-sm btn-danger" value="Elimina" data-azione="eliminaFotoExtra">
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" id="fotoExtraAttiva-@foto.Id" guidid="@foto.GuidId" @(foto.Attiva == true ? "checked" : string.Empty) data-azione="attivaFotoExtra">
                                            <label class="form-check-label" for="fotoExtraAttiva-@foto.Id">Attiva</label>
                                        </div>
                                    </div>
                                </div>
                            </figure>
                        }

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-success" data-azione="aggiungiFotoExtra" data-tipo="@tipoExtra.Val">Aggiungi @tipoExtra.Nome</button>
                            <button type="button" class="btn btn-sm btn-outline-success" data-azione="collegaFotoExtra" data-tipo="@tipoExtra.Val" data-nometipo="@tipoExtra.Nome">Collega a immagine a sistema</button>
                        </div>
                    </div>
                }

                @*Indirizzo di Olimpo per le miniature del catalogo, come nelle altre pagine.*@
                <input type="hidden" id="ipOlympus" value="@olimpoIp" />

                @*Uno solo per tutta la pagina: il tipo scelto si tiene sull'elemento stesso.*@
                <input type="file" id="fileNuovaFotoExtra" accept="image/*,.psd,.tif,.tiff" style="display:none" data-azione="fileFotoExtraScelto" />
                </div>


@*                <div class="container text-center">
                    <h5 class="mb-3">Aggiungi/Aggiorna foto</h5>
                    <input type="file" id="new_file_img" onchange="ArchivioItem.changeFotoSelect($(this))" />
                    <div style="width: 100%;margin-top: 10px;text-align: center;">
                    <input type="button" id="b_salva_img" value="Salva" style="display:none;" onclick="ArchivioItem.uploadFoto()">
                    </div>
                </div>
                <div class="container text-center mt-4">
                <button type="button" class="btn btn-primary" onclick="ArchivioItem.downloadFotoArticolo(@itemBind.Id)">Scarica tutte le foto</button>
                </div>*@
            </div>
            <div class="col">
            <div class="row mb-5">
                <div class="col">
                    <label for="Codice" class="form-label fs-3">Codice articolo</label>
                    <input type="text" readonly class="form-control" id="Codice" name="Codice" value="@itemBind.Codice">
                    <label for="Ean" class="form-label fs-3">Ean</label>
                    <input type="text" readonly class="form-control" id="Ean" name="Ean" value="@itemBind.Ean">
                </div>
            </div>
    
                <div class="container dettaglioCampiElemento">
                    <div class="d-flex justify-content-between align-items-center">
                        <ul class="nav nav-tabs flex-grow-1" id="tabHeader" style="border-bottom: 1px solid #9f9a9a !important" role="tablist">
                            <!-- Le tab verranno qui -->
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tab-Naz-tab" data-bs-toggle="tab" data-bs-target="#tab-Naz" type="button" role="tab" aria-controls="tab-Naz" aria-selected="true">
                                Naz
                            </button>
                        </li>
                        @foreach (var item in itemBind.ArticoliDescrizionis!)
                        {
                            if(item.Canale == null && item.Area == null)
                            {
                                continue;
                            }
                            var nome = @item.Canale + @item.Area;
                            var tabId = "tab-" + nome + (itemBind.Codice);
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" area="@item.Area" canale="@item.Canale" id="@tabId-tab" data-bs-toggle="tab" data-bs-target="#@tabId" type="button" role="tab" aria-controls="@tabId" aria-selected="true">@nome</button>
                            </li>
                        }
                        </ul>
                    </div>

                <!-- Tabs content -->
                <div class="tab-content border-start border-end border-bottom p-3" style="border-color: #9f9a9a !important;" id="tabContent">
                    <div class="tab-pane fade show active content" area="" canale="" id="tab-Naz" role="tabpanel" aria-labelledby="tab-Naz-tab">
                        <div class="container">
                            <div class="row" id="riga_revisione">
                                <div class="col">
                                    <span id="lab_data_ultima_revisione">Data ultima revisione: @itemDescr!.DataUltimaRicezione</span>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col">
                                    <label for="Nome" class="form-label">Descrizione1</label>
                                    <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione1" name="Descrizione1">@itemDescr.Descrizione1</textarea>
                                </div>
                                <div class="col">
                                    <label for="Tipo" class="form-label">Descrizione3</label>
                                    <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione3" name="Descrizione3">@itemDescr.Descrizione3</textarea>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <label for="Brand" class="form-label">Descrizione2</label>
                                    <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione2" name="Descrizione2">@itemDescr.Descrizione2</textarea>
                                </div>
                                <div class="col">
                                    <label for="Grammatura" class="form-label">Descrizione4</label>
                                    <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione4" name="Descrizione4">@itemDescr.Descrizione4</textarea>
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col">
                                    <div class="input-group float-start w-50">
                                        <span class="input-group-text" style="font-size:small;">Peso totale</span>
                                        <input type="text" style="font-family:monospace" class="form-control" id="Peso" name="Peso" value="@if (@itemDescr.Peso != null) { @itemDescr!.Peso.ToString()!.Replace(".", ",");}else{}" />
                                    </div>
                                    <div class="input-group float-start w-50">
                                        <span class="input-group-text" style="font-size:small;">Unità di misura</span>
                                        <input type="text" style="font-family:monospace" class="form-control" id="Um" name="Um" value="@itemDescr.Um" />
                                    </div>
                                </div>
                            </div>
                            <div class="accordion mt-2" id="accordionExtra">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                            Extra
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExtra">
                                        <div class="accordion-body">
                                            <div class="row mt-3" id="rowExtra">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col text-start px-3">
                                    <input id="vediUltimeModifiche" type="button" class="btn btn-primary" value="Cronologia modifiche" data-azione="cronologiaModifiche" />
                                </div>
                                <div class="col text-end px-3">
                                    <input id="bottoneSalva" type="button" class="btn btn-primary" value="Salva" data-azione="salvaRevisione" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Nuovi contenuti tab verranno inseriti qui da JS -->                
                    @foreach (var item in itemBind.ArticoliDescrizionis)
                    {
                        

                        var id = $"art-{item.Id}";
                        var accId = $"accordionExtra-{id}";
                        var headingId = $"heading-{id}";
                        var collapseId = $"collapse-{id}";
                        

                        if (item.Canale == null && item.Area == null)
                        {
                            continue;
                        }

                        var nome = @item.Canale + @item.Area;
                        var tabId = "tab-" + nome + (itemBind.Codice);


                        <div class="tab-pane fade hide content" area="@item.Area" canale="@item.Canale" id="@tabId" role="tabpanel" aria-labelledby="@tabId-tab">
                            <div class="container">
                                <div class="row" id="riga_revisione">
                                    <div class="col">
                                        <span id="lab_data_ultima_revisione">Data ultima revisione: @item.DataUltimaRicezione</span>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col">
                                        <label for="Nome" class="form-label">Descrizione1</label>
                                        <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione1" name="Descrizione1">@item.Descrizione1</textarea>
                                    </div>
                                    <div class="col">
                                        <label for="Tipo" class="form-label">Descrizione3</label>
                                        <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione3" name="Descrizione3">@item.Descrizione3</textarea>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <label for="Brand" class="form-label">Descrizione2</label>
                                        <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione2" name="Descrizione2">@item.Descrizione2</textarea>
                                    </div>
                                    <div class="col">
                                        <label for="Grammatura" class="form-label">Descrizione4</label>
                                        <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione4" name="Descrizione4">@item.Descrizione4</textarea>
                                    </div>
                                </div>
                                <div class="row mt-4">
                                    <div class="col">
                                        <div class="input-group float-start w-50">
                                            <span class="input-group-text" style="font-size:small;">Peso totale</span>
                                            <input type="text" style="font-family:monospace" class="form-control" id="Peso" name="Peso" value="@item.Peso" />
                                        </div>
                                        <div class="input-group float-start w-50">
                                            <span class="input-group-text" style="font-size:small;">Unità di misura</span>
                                            <input type="text" style="font-family:monospace" class="form-control" id="Um" name="Um" value="@item.Um" />
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion mb-2 mt-2" id="@accId">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="@headingId">
                                            <button class="accordion-button collapsed" type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#@collapseId"
                                                    aria-expanded="false"
                                                    aria-controls="@collapseId">
                                                Extra
                                            </button>
                                        </h2>
                                        <div id="@collapseId"
                                             class="accordion-collapse collapse"
                                             aria-labelledby="@headingId"
                                             data-bs-parent="#@accId">
                                            <div class="accordion-body">
                                                <div class="row mt-3" id="rowExtra">
                                                    <!-- tuo contenuto -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                          
                                <div class="row mt-4">
                                    <div class="col text-start px-3">
                                        <input id="vediUltimeModifiche" type="button" class="btn btn-primary" value="Cronologia modifiche" data-azione="cronologiaModifiche" />
                                    </div>
                                    <div class="col text-end px-3">
                                        <input id="bottoneSalva" area="@item.Area" canale="@item.Canale" type="button" class="btn btn-primary" value="Salva" data-azione="salvaRevisione" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Nuovi contenuti tab verranno inseriti qui da JS -->
                    }
                </div>

            </div>


        </div>
        </div>

    <!-- Modal Principale -->
    @*I20-983: il catalogo delle immagini gia' a sistema, filtrato sul tipo da collegare.*@
    <div class="modal fade" id="collegaFotoExtraModal" tabindex="-1" aria-labelledby="collegaFotoExtraModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="collegaFotoExtraModalLabel">Collega a immagine a sistema</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <div class="modal-body" id="collegaFotoExtraBody"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="operazioniModal" tabindex="-1" aria-labelledby="operazioniModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="operazioniModalLabel"></h5>
                    <select id="rangeDateSelect" class="form-select w-auto ms-3">
                        <option value="1">Ultime 24 ore</option>
                        <option value="7" selected>Ultimi 7 giorni</option>
                        <option value="30">Ultimo mese</option>
                        <option value="all">Sempre</option>
                    </select>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <div class="modal-body" id="operazioniModalBody"></div>
            </div>
        </div>
    </div>

    <!-- Modal per formData -->
    <div class="modal fade" id="formDataModal" tabindex="-1" aria-labelledby="formDataModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="formDataModalLabel">Dati del form</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <div class="modal-body" id="formDataModalBody"></div>
            </div>
        </div>
    </div>

</div>


@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" type="text/javascript">

    var ArchivioItem
    var agenzia;
    function documentReady() {
       
        ArchivioItem = new Archivio();
        agenzia = new Agenzia();

        //I20-983: i gestori si agganciano da qui, che e' uno script col nonce. Scritti come
        //attributo nel markup la policy di sicurezza della pagina li rifiuterebbe.
        ArchivioItem.collegaGestoriSchedaArticolo();

        const el = $('#itemBind');

        const item = JSON.parse(el.attr("data"));
        if (agenzia.aggiungiCampiExtraSchedaArticolo!=null)
        {
            agenzia.aggiungiCampiExtraSchedaArticolo($("#rowExtra"), item);
        }

        function clickCheck(sender)
        {
            sender.closest("form").submit();
        }

        $(document).on("mouseenter", ".img-preview-hover", function () {

        const bigImg = $(this).data("bigimg");

        $("#image-hover-preview img").attr("src", bigImg);
        $("#image-hover-preview").css("display", "flex");
        });

        $(document).on("mouseleave", ".img-preview-hover", function () {

            $("#image-hover-preview").hide();
            $("#image-hover-preview img").attr("src", "");
        });
    }

</script>