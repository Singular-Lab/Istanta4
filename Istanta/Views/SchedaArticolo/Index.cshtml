@page
@model Istanta.Views.SchedaArticolo.IndexModel
@using IstantaLib;
@using Microsoft.AspNetCore.Html;
@{
    string[] _extPostProduzione = (string[])ViewBag.extPostProduzione;
}

@{
    var olimpoIp = (ViewBag.ipOlympus as string);
    var itemBind = (ViewBag.Item as Istanta.Models.Articoli)!;
    // foreach (var item in itemBind.ArticoliDescrizionis!)
    // {
    //     item.IdArticoloNavigation = null;
    // }
    // foreach (var item in itemBind.ArticoliFotos!)
    // {
    //     item.IdArticoloNavigation = null;
    // }
    foreach (var d in itemBind.ArticoliDescrizionis!)
        d.IdArticoloNavigation = null;
    foreach (var f in itemBind.ArticoliFotos!)
        f.IdArticoloNavigation = null;

    var itemDescr = itemBind.ArticoliDescrizionis!.Where(f => f.Canale == null && f.Area == null).FirstOrDefault();
}

<div class="container">
    <div class="row mt-3 mb-5">
        <div class="col">
            <input type="hidden" id="itemBind"
            data='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(itemBind))' />

            <input type="hidden" itemBind="@itemBind" />
            @if (itemBind.UltimaRevisione.HasValue)
            {
                <h5>Ultima revisione: @itemBind.UltimaRevisione.Value.ToString("dd/MM/yyyy HH:mm")</h5>
            }
            @if (itemBind.Segmento != null && itemBind.Segmento != "")
            {
                <h5>Segmento: @itemBind.Segmento</h5>
            }
        </div>
    </div>
    @if (ViewBag.error != null)
    {
        <div class="alert alert-dismissible alert-danger" role="alert">
            @ViewBag.error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row mb-5">
        <div class="col-4">
            @if (ViewBag.GestioneFoto != null)
            {
                @await Html.PartialAsync("_GestioneFoto", (Istanta.Models.GestioneFoto)ViewBag.GestioneFoto)
            }


@*                <div class="container text-center">
                    <h5 class="mb-3">Aggiungi/Aggiorna foto</h5>
                    <input type="file" id="new_file_img" onchange="ArchivioItem.changeFotoSelect($(this))" />
                    <div style="width: 100%;margin-top: 10px;text-align: center;">
                    <input type="button" id="b_salva_img" value="Salva" style="display:none;" onclick="ArchivioItem.uploadFoto()">
                    </div>
                </div>
                <div class="container text-center mt-4">
                <button type="button" class="btn btn-primary" onclick="ArchivioItem.downloadFotoArticolo(@itemBind.Id)">Scarica tutte le foto</button>
                </div>*@
            </div>
            <div class="col">
            <div class="row mb-5">
                <div class="col">
                    <label for="Codice" class="form-label fs-3">Codice articolo</label>
                    <input type="text" readonly class="form-control" id="Codice" name="Codice" value="@itemBind.Codice">
                    <label for="Ean" class="form-label fs-3">Ean</label>
                    <input type="text" readonly class="form-control" id="Ean" name="Ean" value="@itemBind.Ean">
                </div>
            </div>
    
                <div class="container dettaglioCampiElemento">
                    <div class="d-flex justify-content-between align-items-center">
                        <ul class="nav nav-tabs flex-grow-1" id="tabHeader" style="border-bottom: 1px solid #9f9a9a !important" role="tablist">
                            <!-- Le tab verranno qui -->
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tab-Naz-tab" data-bs-toggle="tab" data-bs-target="#tab-Naz" type="button" role="tab" aria-controls="tab-Naz" aria-selected="true">
                                Naz
                            </button>
                        </li>
                        @foreach (var item in itemBind.ArticoliDescrizionis!)
                        {
                            if(item.Canale == null && item.Area == null)
                            {
                                continue;
                            }
                            var nome = @item.Canale + @item.Area;
                            var tabId = "tab-" + nome + (itemBind.Codice);
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" area="@item.Area" canale="@item.Canale" id="@tabId-tab" data-bs-toggle="tab" data-bs-target="#@tabId" type="button" role="tab" aria-controls="@tabId" aria-selected="true">@nome</button>
                            </li>
                        }
                        </ul>
                    </div>

                <!-- Tabs content -->
                <div class="tab-content border-start border-end border-bottom p-3" style="border-color: #9f9a9a !important;" id="tabContent">
                    <div class="tab-pane fade show active content" area="" canale="" id="tab-Naz" role="tabpanel" aria-labelledby="tab-Naz-tab">
                        <div class="container">
                            <div class="row" id="riga_revisione">
                                <div class="col">
                                    <span id="lab_data_ultima_revisione">Data ultima revisione: @itemDescr!.DataUltimaRicezione</span>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col">
                                    <label for="Nome" class="form-label">Descrizione1</label>
                                    <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione1" name="Descrizione1">@itemDescr.Descrizione1</textarea>
                                </div>
                                <div class="col">
                                    <label for="Tipo" class="form-label">Descrizione3</label>
                                    <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione3" name="Descrizione3">@itemDescr.Descrizione3</textarea>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <label for="Brand" class="form-label">Descrizione2</label>
                                    <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione2" name="Descrizione2">@itemDescr.Descrizione2</textarea>
                                </div>
                                <div class="col">
                                    <label for="Grammatura" class="form-label">Descrizione4</label>
                                    <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione4" name="Descrizione4">@itemDescr.Descrizione4</textarea>
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col">
                                    <div class="input-group float-start w-50">
                                        <span class="input-group-text" style="font-size:small;">Peso totale</span>
                                        <input type="text" style="font-family:monospace" class="form-control" id="Peso" name="Peso" value="@if (@itemDescr.Peso != null) { @itemDescr!.Peso.ToString()!.Replace(".", ",");}else{}" />
                                    </div>
                                    <div class="input-group float-start w-50">
                                        <span class="input-group-text" style="font-size:small;">Unità di misura</span>
                                        <input type="text" style="font-family:monospace" class="form-control" id="Um" name="Um" value="@itemDescr.Um" />
                                    </div>
                                </div>
                            </div>
                            <div class="accordion mt-2" id="accordionExtra">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                            Extra
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExtra">
                                        <div class="accordion-body">
                                            <div class="row mt-3" id="rowExtra">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col text-start px-3">
                                    <input id="vediUltimeModifiche" type="button" class="btn btn-primary" value="Cronologia modifiche" data-azione="cronologiaModifiche" />
                                </div>
                                <div class="col text-end px-3">
                                    <input id="bottoneSalva" type="button" class="btn btn-primary" value="Salva" data-azione="salvaRevisione" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Nuovi contenuti tab verranno inseriti qui da JS -->                
                    @foreach (var item in itemBind.ArticoliDescrizionis)
                    {
                        

                        var id = $"art-{item.Id}";
                        var accId = $"accordionExtra-{id}";
                        var headingId = $"heading-{id}";
                        var collapseId = $"collapse-{id}";
                        

                        if (item.Canale == null && item.Area == null)
                        {
                            continue;
                        }

                        var nome = @item.Canale + @item.Area;
                        var tabId = "tab-" + nome + (itemBind.Codice);


                        <div class="tab-pane fade hide content" area="@item.Area" canale="@item.Canale" id="@tabId" role="tabpanel" aria-labelledby="@tabId-tab">
                            <div class="container">
                                <div class="row" id="riga_revisione">
                                    <div class="col">
                                        <span id="lab_data_ultima_revisione">Data ultima revisione: @item.DataUltimaRicezione</span>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col">
                                        <label for="Nome" class="form-label">Descrizione1</label>
                                        <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione1" name="Descrizione1">@item.Descrizione1</textarea>
                                    </div>
                                    <div class="col">
                                        <label for="Tipo" class="form-label">Descrizione3</label>
                                        <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione3" name="Descrizione3">@item.Descrizione3</textarea>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <label for="Brand" class="form-label">Descrizione2</label>
                                        <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione2" name="Descrizione2">@item.Descrizione2</textarea>
                                    </div>
                                    <div class="col">
                                        <label for="Grammatura" class="form-label">Descrizione4</label>
                                        <textarea class="form-control" style="height:115px; font-family:monospace" id="Descrizione4" name="Descrizione4">@item.Descrizione4</textarea>
                                    </div>
                                </div>
                                <div class="row mt-4">
                                    <div class="col">
                                        <div class="input-group float-start w-50">
                                            <span class="input-group-text" style="font-size:small;">Peso totale</span>
                                            <input type="text" style="font-family:monospace" class="form-control" id="Peso" name="Peso" value="@item.Peso" />
                                        </div>
                                        <div class="input-group float-start w-50">
                                            <span class="input-group-text" style="font-size:small;">Unità di misura</span>
                                            <input type="text" style="font-family:monospace" class="form-control" id="Um" name="Um" value="@item.Um" />
                                        </div>
                                    </div>
                                </div>

                                <div class="accordion mb-2 mt-2" id="@accId">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="@headingId">
                                            <button class="accordion-button collapsed" type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#@collapseId"
                                                    aria-expanded="false"
                                                    aria-controls="@collapseId">
                                                Extra
                                            </button>
                                        </h2>
                                        <div id="@collapseId"
                                             class="accordion-collapse collapse"
                                             aria-labelledby="@headingId"
                                             data-bs-parent="#@accId">
                                            <div class="accordion-body">
                                                <div class="row mt-3" id="rowExtra">
                                                    <!-- tuo contenuto -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                          
                                <div class="row mt-4">
                                    <div class="col text-start px-3">
                                        <input id="vediUltimeModifiche" type="button" class="btn btn-primary" value="Cronologia modifiche" data-azione="cronologiaModifiche" />
                                    </div>
                                    <div class="col text-end px-3">
                                        <input id="bottoneSalva" area="@item.Area" canale="@item.Canale" type="button" class="btn btn-primary" value="Salva" data-azione="salvaRevisione" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Nuovi contenuti tab verranno inseriti qui da JS -->
                    }
                </div>

            </div>


        </div>
        </div>

    <div class="modal fade" id="operazioniModal" tabindex="-1" aria-labelledby="operazioniModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="operazioniModalLabel"></h5>
                    <select id="rangeDateSelect" class="form-select w-auto ms-3">
                        <option value="1">Ultime 24 ore</option>
                        <option value="7" selected>Ultimi 7 giorni</option>
                        <option value="30">Ultimo mese</option>
                        <option value="all">Sempre</option>
                    </select>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <div class="modal-body" id="operazioniModalBody"></div>
            </div>
        </div>
    </div>

    <!-- Modal per formData -->
    <div class="modal fade" id="formDataModal" tabindex="-1" aria-labelledby="formDataModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="formDataModalLabel">Dati del form</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <div class="modal-body" id="formDataModalBody"></div>
            </div>
        </div>
    </div>

</div>


@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" type="text/javascript">

    var ArchivioItem
    var agenzia;
    function documentReady() {
       
        ArchivioItem = new Archivio();
        agenzia = new Agenzia();

        //I20-983: i gestori si agganciano da qui, che e' uno script col nonce. Scritti come
        //attributo nel markup la policy di sicurezza della pagina li rifiuterebbe.
        ArchivioItem.collegaGestoriSchedaArticolo();

        const el = $('#itemBind');

        const item = JSON.parse(el.attr("data"));
        if (agenzia.aggiungiCampiExtraSchedaArticolo!=null)
        {
            agenzia.aggiungiCampiExtraSchedaArticolo($("#rowExtra"), item);
        }

        function clickCheck(sender)
        {
            sender.closest("form").submit();
        }

        $(document).on("mouseenter", ".img-preview-hover", function () {

        const bigImg = $(this).data("bigimg");

        $("#image-hover-preview img").attr("src", bigImg);
        $("#image-hover-preview").css("display", "flex");
        });

        $(document).on("mouseleave", ".img-preview-hover", function () {

            $("#image-hover-preview").hide();
            $("#image-hover-preview img").attr("src", "");
        });
    }

</script>