@page
@model Istanta.Views.SyncFoto.LoghiBolliModel
@{
}

<input type="hidden" id="ipOlympus" value="@ViewBag.ipOlympus" />

<div class="container">
    <div class="row" id="headerResult">
        <div class="col p-2">
            <h5>Loghi e bolli</h5>
        </div>
    </div>
    <table class="table" id="tblResult">
        <thead>
            <tr>
                <th scope="col" style="width:10%;"></th>
                <th scope="col" style="width:10%;text-align:left !important;">Sigla</th>
                <th scope="col" style="width:10%;text-align:left !important;">Tipo</th>
                <th scope="col" style="width:50%;text-align:left !important;">Nome file</th>
                <th scope="col" style="width:20%;"></th>
                <th scope="col" style="width:20%;"></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<template id="template">
    <tr>
        <td class="text-center" scope="row" style="text-align:left !important"><img id="preview" src="~/images/download_ico.png" style="width:30px;" /><input type="file" style="display:none;" id="fileUpload" class="fileUpload" /></td>
        <td class="text-center" scope="row" style="text-align:left !important"><input type="text" id="sigla" /></td>
        <td class="text-center" scope="row" style="text-align:left !important"><select id="cmbTipo"><option value="3">Logo</option><option value="2">Bollo</option><option value="5">Sfondo</option></select></td>
        <td><span id="nomeFile"></span></td>
        <td style="text-align:right;"><button id="btnSalvaLogo" class="btn btn-primary">Salva</button></td>
        <td><button id="btnEliminaLogo" class="btn btn-danger">Elimina</button></td>
    </tr>
</template>

@* I20-1008: si scelgono piu' file insieme, e sigla e tipo si scrivono nel riepilogo. *@
<template id="templateNew">
    <tr>
        <td class="text-center" scope="row" style="text-align:left !important"><img id="previewNew" src="~/images/download_ico.png" style="width:30px;cursor:pointer;" title="Scegli i file" /><input type="file" id="fileNew" multiple style="display:none;" /></td>
        <td colspan="3">Aggiungi loghi e bolli: si possono scegliere piu' file insieme.</td>
        <td><button class="btn btn-primary" id="btnAggiungiLoghi">Aggiungi</button></td>
        <td></td>
    </tr>
</template>

<div class="modal fade" id="riepilogoLoghiModal" tabindex="-1" aria-labelledby="riepilogoLoghiModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="riepilogoLoghiModalLabel">Riepilogo loghi e bolli da caricare</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger" id="messaggioRiepilogo" style="display:none;"></div>
                <table class="table align-middle" id="tblRiepilogo">
                    <thead>
                        <tr>
                            <th scope="col" style="width:15%;"></th>
                            <th scope="col" style="width:25%;">Sigla</th>
                            <th scope="col" style="width:20%;">Tipo</th>
                            <th scope="col" style="width:25%;">Nome file</th>
                            <th scope="col" style="width:15%;"></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <span class="me-auto" id="contatoreRiepilogo"></span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" id="btnSalvaRiepilogo">Salva</button>
            </div>
        </div>
    </div>
</div>

<template id="templateRiepilogo">
    <tr>
        <td><img class="anteprimaRiepilogo" src="~/images/download_ico.png" style="max-width:60px;max-height:60px;" /></td>
        <td><input type="text" class="form-control form-control-sm siglaRiepilogo" placeholder="Sigla" /><div class="text-danger small mt-1 erroriRiepilogo"></div></td>
        <td><select class="form-select form-select-sm tipoRiepilogo"><option value="0" selected>Seleziona tipo</option><option value="3">Logo</option><option value="2">Bollo</option><option value="5">Sfondo</option></select></td>
        <td class="text-break nomeFileRiepilogo"></td>
        <td style="text-align:right;"><button type="button" class="btn btn-outline-danger btn-sm rimuoviRiepilogo">Rimuovi</button></td>
    </tr>
</template>


@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]">
    

    let loghiBolliInstance;

    function documentReady() {
        loghiBolliInstance = new LoghiBolli();
        loghiBolliInstance.get();

        $("#btnSalvaRiepilogo").on("click", function () { loghiBolliInstance.salvaRiepilogo(); });
        // Chiudendo senza salvare, i file scelti si lasciano perdere.
        $("#riepilogoLoghiModal").on("hidden.bs.modal", function () { loghiBolliInstance.svuotaRiepilogo(); });

     




    }
</script>
