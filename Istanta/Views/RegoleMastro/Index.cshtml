@page
@model Istanta.Views.RegoleMastro.IndexModel
@{
}
@if (ViewBag.error != null)
{
    <div id="error_panel" class="alert alert-danger" style="position:fixed; width:100%;">
        <strong>Attenzione</strong>: @ViewBag.error
    </div>
}



<h3 style="margin-bottom:25px;">Lista Mastro</h3>
@{
    // Raggruppa gli elementi per livello
    var listRegoleMastro = ((List<Istanta.Models.RegoleMastro>)ViewBag.lista_regole_mastro);

}



<div>
    <table>
        <thead>
            <tr>
                <td>
                    <table>
                        <tr>
                            <td style="width:200px;">
                                Nome
                            </td>
                            <td style="width:100px;">
                                Regole
                            </td>
                            <td style="width:200px;">
                                Specifiche
                            </td>
                            <td style="padding-left:30px;">
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </thead>
        @foreach (var item in listRegoleMastro)
        {

            <tr>
                <td>
                    <form method="POST" action="RegoleMastro/Update/@item.Id">
                        <table>
                            <tr>
                                <td style="width:200px; display:none">
                                    <input type="text" id="Id" name="Id" value="@item.Id">
                                </td>
                                <td style="width:200px;">
                                    <input type="text" id="Nome" name="Nome" value="@item.Nome">
                                </td>
                                <td style="width:100px;">
                                    <button class="btn-primary" type="button" id="regole" name="regole" onclick="regoleMastroInstance.openModal($(this).closest('tr').find('#Id').val())">Vedi regole</button>
                                </td>
                                <td>
                                    <button style="margin-right:50px;" class="btn-primary" type="button" id="specifiche" name="specifiche" onclick="regoleMastroInstance.openModalSpecifiche($(this).closest('tr').find('#Id').val())">Vedi specifiche</button>
                                </td>
                                <td>
                                    <input type="submit" value="Salva">
                                </td>
                                <td style="padding-left:30px;">
                                    <a class="btn btn-danger btn-sm" href="RegoleMastro/Delete/@item.Id" onclick="return confirm('Sicuro di voler eliminare?')">Elimina</a>
                                </td>
                            </tr>
                        </table>
                    </form>
                </td>
            </tr>
            <tr>
                <td><hr /></td>
            </tr>

        }
        <tr>
            <td>
            </td>
        </tr>
    </table>
</div>



<form method="POST">
    <table>
        <tr>
            <td style="width:200px;">
                Nome
            </td>
            <td>
                <input type="submit" value="Salva">
            </td>
            <td style="padding-left:30px;">
            </td>
        </tr>
        <tr>
            <td style="width:200px;">
                <input type="text" id="Nome" name="Nome">
            </td>
            <td style="padding-left:30px;">
            </td>
        </tr>
    </table>
</form>

<div class="modal fade" tabindex="-1" id="modalModificaRegole" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Set Etichette</h5>
                <button type="button" data-bs-dismiss="modal" class="btn-close" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="liveAlertPlaceholder"></div>
                <div id="regoleContainer">
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button class="btn btn-primary" type="button" onclick="regoleMastroInstance.aggiungiNuovoSetRegole($('#modalModificaRegole').find('#regoleContainer'))">Aggiungi Set etichette</button>
                <button class="btn btn-success" type="button" onclick="regoleMastroInstance.salvaEModifica()">Salva</button>
            </div>
        </div>
    </div>
</div>


<template id="setEtichette">
    <div class="setEtichette bg-warning bg-opacity-25 mb-1 position-relative">
        SET
        <button type="button" class="btn-close position-absolute top-0 end-0" aria-label="Close" onclick="regoleMastroInstance.eliminaSetRegole($(this).closest('.setEtichette'))"></button>
    </div>
</template>

<template id="addEtichetta">
    <div class="addEtichetta mb-1 d-flex justify-content-center align-items-center">
        <button type="button" class="btn btn-primary" onclick="regoleMastroInstance.aggiungiRegola($(this).closest('.addEtichetta'))">Aggiungi etichetta</button>
    </div>
</template>

<template id="etichetta">
    <div class="etichetta row mb-1">
        <div class="col d-flex flex-column">
            <label for="etichettaVal">Etichetta</label>
            <select id="etichettaVal" class="form-select" aria-label="Menu a tendina">
            </select>
        </div>
        <div class="col d-flex justify-content-center align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="presente" name="presente">
                <label class="form-check-label" for="presente">
                    Presente
                </label>
            </div>
        </div>

        <div class="col-1 d-flex align-items-end">
            <button type="button" class="btn btn-danger btn-sm" style="height:40px" onclick="regoleMastroInstance.eliminaRegola($(this).closest('.etichetta'))">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div>
            <hr class="mt-1">
        </div>
    </div>
</template>


<div class="modal fade" tabindex="-1" id="modalModificaSpecifiche" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Specifiche</h5>
                <button type="button" data-bs-dismiss="modal" class="btn-close" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="liveAlertPlaceholder"></div>
                <div id="specificheContainer">
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button class="btn btn-primary" type="button" onclick="regoleMastroInstance.aggiungiSpecifica()">Aggiungi specifica</button>
                <button class="btn btn-success" type="button" onclick="regoleMastroInstance.salvaEModificaSpecifiche()">Salva</button>
            </div>
        </div>
    </div>
</div>

<template id="specifica">
    <div class="specifica row mb-1">

        <div class="col d-flex flex-column">
            <label for="etichettaScript">Etichetta Script</label>
            <input type="text" id="etichettaScript" class="form-control" aria-label="Etichetta Script">
        </div>

        <div class="col d-flex flex-column">
            <label for="tipoElemento">Tipo Elemento</label>
            <select id="tipoElemento" class="form-select" aria-label="Tipo Elemento">
                <!-- Opzioni verranno aggiunte dinamicamente -->
            </select>
        </div>

        <div class="col d-flex flex-column">
            <label for="nomeStile">Nome Stile</label>
            <input type="text" id="nomeStile" class="form-control" aria-label="Nome Stile">
        </div>

        <div class="col-1 d-flex align-items-end">
            <button type="button" class="btn btn-danger btn-sm" style="height:40px" onclick="regoleMastroInstance.eliminaRegola($(this).closest('.specifica'))">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div>
            <hr class="mt-1">
        </div>
    </div>
</template>

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" src="~/js/regoleMastro.js?v=1.0.0.1"></script>

<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" type="text/javascript">

    let regoleMastroInstance;

    function documentReady() {
        regoleMastroInstance = new RegoleMastro();
        regoleMastroInstance.sourceRegoleMastro = @Html.Raw(Json.Serialize(ViewBag.lista_regole_mastro));
    }

</script>      