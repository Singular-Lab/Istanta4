<template id="template">
    <div class="container mb-1 record_menabo" style="width:400px;">
        <div id="intestazioneRowSingoloTracciato" style="display:none"></div>
        <div class="row align-items-center bg-success text-light p-2">

            <div class="col-2">
                <div class="row">
                    <div class="col-2 py-1">
                        <svg id="addToOrdinamento" style="margin-left:-20px; margin-top:-23px; background-color:red; cursor:pointer" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-border-width" viewBox="0 0 16 16" onclick="menaboInstance.aggiungiAdOrdinamentoModal($(this).closest('.record_menabo'))">
                            <path d="M0 3.5A.5.5 0 0 1 .5 3h15a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.5.5H.5a.5.5 0 0 1-.5-.5zm0 5A.5.5 0 0 1 .5 8h15a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H.5a.5.5 0 0 1-.5-.5zm0 4a.5.5 0 0 1 .5-.5h15a.5.5 0 0 1 0 1H.5a.5.5 0 0 1-.5-.5" />
                        </svg>
                    </div>
                </div>
                <div class="row">
                    <div class="col-2 py-1">
                        <img class="fotoIcon" src="images/foto.png" style="width:20px;" onmouseover="menaboInstance.showFoto($(this))" onmouseout="menaboInstance.hideFoto()" onwheel="menaboInstance.hideFoto()" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-2 py-1">
                        <img class="htmlImg" src="images/html.png" style="width:20px; visibility:hidden" />
