                <h5 id="titleDettaglioReport" class="modal-title">Attenzione</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="menaboInstance.AnnullaCambioIndice($('#modalSwapOrMultiplex').attr('idMenaboRef'))"></button>
            </div>
            <div class="modal-body">
                <div class="container" id="">
                    <p><span class='fw-bold'>Si sta cercando di inserire un elemento in un box già occupato, seleziona l'operazione:</span></p>
                    <p><span class='text-danger fw-bold'>- Forma Multiplex</span>: Verrà formato un multiplex degli elementi a tale indice </p>
                    <p><span class='text-danger fw-bold'>- Scorri</span>: Gli elementi a partire da quell'indice fino al primo spazio vuoto verranno fatti sccorrere</p>
                    <p><span class='text-danger fw-bold'>- Scambia</span>: Il nuovo elemento si scambierà di posto con quelli già posizionati</p>
                </div>
            </div>
            <div class="modal-footer">
                <div class="container text-end">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" aria-label="Close" onclick="menaboInstance.FormaMultiplex($('#modalSwapOrMultiplex').attr('idMenaboRef'), $('#modalSwapOrMultiplex').attr('codiceGruppoOIdRec'), $('#modalSwapOrMultiplex').attr('newInx'))">Forma multiplex</button>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" aria-label="Close" onclick="menaboInstance.ScorriRef($('#modalSwapOrMultiplex').attr('idMenaboRef'), $('#modalSwapOrMultiplex').attr('codiceGruppoOIdRec'), $('#modalSwapOrMultiplex').attr('newInx'))">Scorri</button>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" aria-label="Close" onclick="menaboInstance.ScambiaRef($('#modalSwapOrMultiplex').attr('idMenaboRef'), $('#modalSwapOrMultiplex').attr('codiceGruppoOIdRec'), $('#modalSwapOrMultiplex').attr('newInx'))">Scambia</button>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" aria-label="Close" onclick="menaboInstance.AnnullaCambioIndice($('#modalSwapOrMultiplex').attr('idMenaboRef'), $('#modalSwapOrMultiplex').attr('codiceGruppoOIdRec'))">Annulla</button>
                </div>
            </div>
        </div>
    </div>
</div>

<template id="filtroTemplate">
    <div class="input-group input-group-sm">
        <select class="form-select form-select-sm" id="ricercaTracciato" name="ricercaTracciato" style="width: 40%;" onchange="menaboInstance.ricercaInTracciatoMenabo($(this)); this.classList.remove('bg-success', 'bg-opacity-25'); this.classList.remove('bg-danger');" onclick="this.classList.remove('bg-danger')">
            <option value="0" selected>Filtro</option>
        </select>
        <input type="text" id="ricercaText" class="form-control ricercaText" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm" style="width: 50%;" onkeypress="menaboInstance.ricercaInTracciatoMenabo($(this))">
        <img src="images/trashcanIcon.png" class="mx-1" id="trashIcon" style="width:20px;" onclick="menaboInstance.rimuoviParametroRicerca($(this))" />
    </div>
</template>

<div class="modal fade" tabindex="-1" id="modalAggiungiAdOrdinamento">
