</div>

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" src="~/js/menabo.js?v=1.0.0.99"></script>
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" src="~/js/mySocket.js?v=1.0.0.0"></script>

<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" type="text/javascript">

    let menaboInstance;
    let ordInstance;
    let revInstance;
    let taskManager;

    function documentReady() {

        let actualCode = ""; //codice che sta venendo inserito
        let actualGrpCode = ""; //codice gruppo che sta venendo inserito
        taskManager=new TaskManager();

        menaboInstance = new Menabo(@ViewBag.IdTracciato, @Html.Raw(Json.Serialize(ViewBag.PagineSource)), @Html.Raw(Json.Serialize(ViewBag.MastroSource)), @Html.Raw(Json.Serialize(ViewBag.MaccanicheSource)));
        menaboInstance.adattaGriglia();

        revInstance = new Revisore();
        ordInstance = new Ordinamento();
        
        $( window ).resize(function() {
            menaboInstance.adattaGriglia();

        });

        let canvas = $("#myCanvas");
        canvas.attr("width", $(window).width());
        canvas.attr("height", $(window).height());


        taskManager.addListener(menaboInstance);

        const modal = $("#modalVisualizzaBox");
        const btn = modal.find(".btn-close");
        modal.click(function (event) {
            // Verifica se l'elemento cliccato è all'esterno del modal
            if (modal.is(event.target) && modal.has(event.target).length === 0 && modal.hasClass("show")) {
                // L'evento di click è avvenuto all'esterno del modal, mostra il messaggio di conferma
                if (menaboInstance.ControllaPrimarie(modal).message != "")
                {
                    const result = confirm(menaboInstance.ControllaPrimarie(modal).message);
                    if (result) {
                        console.log("chiudo");
                        closeModal(modal);
                    }
                }
                else
                {
                    closeModal(modal);
                }

            }
        });

        btn.click(function (event) {
            console.log("modal");
            // Verifica se l'elemento cliccato è all'esterno del modal
            if (modal.hasClass("show")) {
                if (menaboInstance.ControllaPrimarie(modal).message != "") {
                    const result = confirm(menaboInstance.ControllaPrimarie(modal).message);
                    if (result) {
                        console.log("chiudo2");
                        closeModal(modal);
                    }
                }
                else {
                    closeModal(modal);
                }

            }
        });

        const modal2 = $("#modalDtl");
        const btn2 = modal2.find(".btn-close");
        modal2.click(function (event) {
            // Verifica se l'elemento cliccato è all'esterno del modal
            if (modal2.is(event.target) && modal2.has(event.target).length === 0 && modal2.hasClass("show")) {
                // L'evento di click è avvenuto all'esterno del modal, mostra il messaggio di conferma
                if (menaboInstance.ControllaPrimarie(modal2).message != "") {
                    const result = confirm(menaboInstance.ControllaPrimarie(modal2).message);
                    if (result) {
                        console.log("chiudo3");
                        closeModal(modal2);
                    }
                }
                else {
                    closeModal(modal2);
                }

            }
        });


        btn2.click(function (event) {
            // Verifica se l'elemento cliccato è all'esterno del modal

            if (modal2.hasClass("show")) {
                if (menaboInstance.ControllaPrimarie(modal2).message != "") {
                    const result = confirm(menaboInstance.ControllaPrimarie(modal2).message);
                    if (result) {
                        console.log("chiudo4");
                        closeModal(modal2);
                    }
                }
                else {
                    closeModal(modal2);
                }

            }
        });

        $("#codiceArticoloDaInserire").keyup(function(event) {
            if ($(this).val() != actualCode || ($(this).val() == "" && actualCode == ""))
            {
                if ($(this).val() != "") {
                    $(this).addClass("bg-danger bg-opacity-25");
                }
                $(this).removeClass("bg-success");
            }
            else
            {
                $(this).removeClass("bg-danger");
            }

            if (event.which === 13) {                         
                let result = menaboInstance.leggiCodiceRichiesto();
                if (result != false)
                {
                    $(this).addClass("bg-success bg-opacity-25");
                    $(this).removeClass("bg-danger");
                    actualCode = $(this).val();      
                }
                else{
                    actualCode = "";
                    $(this).addClass("bg-danger bg-opacity-25");
                    $(this).removeClass("bg-success");
                }

            }
        });

        $("#InserimentoInGruppo").find("#codiceGruppo").keyup(function (event) {
            actualGrpCode = "0";
            $("#InserimentoInGruppo").find("#codiceGruppo").attr("CodGr", "0");
            if ($(this).val() == "")
            {
                $("#InserimentoInGruppo").find("#codiceGruppo").attr("CodGr", "0");
                menaboInstance.svuotaCampiInserimentoInGruppo();
            }
            if ($(this).val() != actualGrpCode || ($(this).val() == "" && actualGrpCode == "0")) {
                if ($(this).val() != "") {
                    $(this).addClass("bg-danger bg-opacity-25");
                }
                $(this).removeClass("bg-success"); 
                menaboInstance.svuotaCampiInserimentoInGruppo();
            }
            else
            {
                $(this).removeClass("bg-danger");
            }

            if (event.which === 13) {   
                console.log($(this).val());
                let valore = $("#codiceGruppo").val();
                $("#codiceGruppo").val($("#codiceGruppo").val() + "0");
                $("#codiceGruppo").val(valore);
                let result = menaboInstance.leggiCodiceGruppoRichiesto($(this).val());
                console.log(result);
                if (result != false)
                {
                    console.log("ok");
                    console.log($(this));
                    $(this).removeClass("bg-danger");
                    $(this).addClass("bg-success bg-opacity-25");                    
                    actualGrpCode = $(this).val();      
                }
                else{
                    actualGrpCode = "0";
                    $(this).addClass("bg-danger bg-opacity-25");
                    $(this).removeClass("bg-success");
                }

            }
        });

        //$("#ScaricaPacchettoFotoButton").attr("href", "Menabo/donwloadPacchettoFoto/"+@ViewBag.IdTracciato);
        
    }

    function closeModal(modal) {
    // Logica per chiudere il modal
        modal.modal("hide");
        //$('.modal-backdrop').remove();
    }

    function onSalvataRevisione(result) {
        menaboInstance.onSalvataRevisione(result);
    }
</script>