                                                                            <td style="width:150px;">
                                                                                Regole
                                                                            </td>
                                                                            <td style="padding-left:30px;">
                                                                            </td>
                                                                        </tr>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </thead>
                                                        @foreach (var item in group)
                                                        {

                                                            <tr class="rowTable">
                                                                <td>
                                                            
                                                                        <table>
                                                                            <tr>
                                                                                <!-- Nessun ID duplicato, usiamo classi per differenziare -->
                                                                                <td style="width:150px; display:none">
                                                                                    <input style="width:150px;" type="text" class="Id" name="Id" value="@item.Id">
                                                                                </td>
                                                                                <td style="width:150px;">
                                                                                    <input style="width:150px;" type="text" class="Nome" name="Nome" value="@item.Nome">
                                                                                </td>
                                                                                <td style="width:150px;">
                                                                                    <input style="width:150px;" type="text" class="LivelloMeccanica" name="LivelloMeccanica" value="@item.LivelloMeccanica">
                                                                                </td>
                                                                                <td style="width:150px;">
                                                                                    <input style="width:150px;" type="text" class="LivelloEsternoMeccanicaAvanzata" name="LivelloEsternoMeccanicaAvanzata" value="@item.LivelloEsternoMeccanicaAvanzata">
                                                                                </td>
                                                                                <td style="width:150px;">
                                                                                    <input style="width:150px;" type="text" class="Formato" name="Formato" value="@item.Formato">
                                                                                </td>
                                                                                <td>
                                                                                <button style="margin-right:50px;" class="btn-primary regoleMeccanicheAvanzate" type="button" id="regole" name="regole">Vedi regole</button>
                                                                                </td>
                                                                                <td>
                                                                                    <button class="salvaDeclinazioneMeccanicaAvanzata" type="button">
                                                                                        Salva
                                                                                    </button>
                                                                                </td>
                                                                                <td style="padding-left:30px;">
                                                                                <button class="btn btn-danger btn-sm eliminaDeclinazioneMeccanicaAvanzata" idItem="@item.Id">Elimina</button>
                                                                                </td>
                                                                            </tr>
                                                                        </table>
                                                            


                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td><hr /></td>
                                                            </tr>

                                                        }
                                                        <tr>
                                                            <td>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                <p></p>
                @foreach (var groupEsterno in groupedItemsRimozioneMeccanicheAvanzate)
                {
                    <div class="accordion" id="accordionLivelloRimozione_@groupEsterno.Key">
                        <div class="accordion-item">
                            <div class="accordion-header" id="headingLivelloRimozione_@groupEsterno.Key">
                                <h2 class="mb-0">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLivelloEsternoRimozione_@groupEsterno.Key" aria-expanded="false" aria-controls="collapseLivelloRimozione_@groupEsterno.Key">
                                        Remove - Livello Esterno @groupEsterno.Key
                                    </button>
                                </h2>
                            </div>
                            <div style="width:90%; margin-left: auto;" id="collapseLivelloEsternoRimozione_@groupEsterno.Key" class="accordion-collapse collapse" aria-labelledby="headingLivelloEsternoRimozione_@groupEsterno.Key" data-parent="#accordionLivelloRimozione_@groupEsterno.Key">
                                @foreach (var group in groupEsterno.GroupBy(x => x.LivelloMeccanica))
                                {
                                    var adaptedKey = group.Key.ToString().Replace(",", "_");
                                    adaptedKey = adaptedKey.Replace(".", "_");
                                    <div class="accordion" id="accordionLivelloRemove_@(groupEsterno.Key)_@(adaptedKey)">
                                        <div class="accordion-item">
                                            <div class="accordion-header" id="headingLivelloRemove_@(groupEsterno.Key)_@(adaptedKey)">
                                                <h2 class="mb-0">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLivelloRemove_@(groupEsterno.Key)_@(adaptedKey)" aria-expanded="false" aria-controls="collapseLivelloRemove_@(groupEsterno.Key)_@(adaptedKey)">
                                                        Livello @adaptedKey
                                                    </button>
                                                </h2>
                                            </div>
                                            <div id="collapseLivelloRemove_@(groupEsterno.Key)_@(adaptedKey)" class="accordion-collapse collapse" aria-labelledby="headingLivelloRemove_@(groupEsterno.Key)_@(adaptedKey)" data-parent="#accordionLivelloRemove_@(groupEsterno.Key)_@(adaptedKey)">
                                                <div class="accordion-body">
                                                    <table>
                                                        <thead>
                                                            <tr>
                                                                <td>
                                                                    <table>
                                                                        <tr>
                                                                            <td style="width:150px;">
                                                                                Nome
                                                                            </td>
                                                                            <td style="width:150px;">
                                                                                Livello Meccanica
                                                                            </td>
                                                                            <td style="width:150px;">
                                                                                Livello Esterno
                                                                            </td>
