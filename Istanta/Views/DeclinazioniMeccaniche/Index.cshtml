    </div>
    <div id="contentSource" class="pt-3" style="display:none;">
        <div class="container">
            <div class="row">
                <div class="col-12 mb-3" style="text-align:right;">
                    <button class="btn btn-primary" id="btnSourceSave" value="Salva">Salva</button>
                </div>
            </div>
            <div id="editor"></div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="modalModificaRegole" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Set Etichette</h5>
                <button type="button" data-bs-dismiss="modal" class="btn-close" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="liveAlertPlaceholder"></div>
                <div id="regoleContainer">
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button id="addSetEtichette" class="btn btn-primary" type="button">Aggiungi Set etichette</button>
                <button id="salvaRegole" class="btn btn-success" type="button">Salva</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" id="modalModificaRegoleMeccanicaAvanzata" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Set Etichette</h5>
                <button type="button" data-bs-dismiss="modal" class="btn-close" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="liveAlertPlaceholder"></div>
                <div id="regoleAvanzateContainer">
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button class="btn btn-primary" id="addSetRegoleButton" rimozione="false" type="button" >Aggiungi Set</button>
                <button class="btn btn-success" id="salvaRegoleAvanzate" type="button">Salva</button>
                <button class="btn btn-success" id="salvaRimozioneRegoleAvanzate" style="display:none" type="button" >Salva</button>
            </div>
        </div>
    </div>
</div>


<template id="setEtichette">
    <div class="setEtichette bg-warning bg-opacity-25 mb-1 position-relative">
        SET
        <button id="setEtichetteBtn" type="button" class="btn-close position-absolute top-0 end-0 setEtichetteBtn" aria-label="Close"></button>
    </div>
</template>

<template id="setMeccaniche">
    <div class="setMeccaniche bg-warning bg-opacity-25 mb-1 position-relative">
        SET
        <div class="form-check">
            <input class="form-check-input meccanicaEsclusiva" type="checkbox" id="meccanicaEsclusiva" name="meccanicaEsclusiva" data-bs-toggle="tooltip" data-bs-placement="top" title="Questa opzione abilitata richiede che, perchè il set sia valido, non ci siano altre meccaniche assegnate al record oltre a quelle richieste dal set.">
            <label class="form-check-label" for="meccanicaEsclusiva" data-bs-toggle="tooltip" data-bs-placement="top" title="Questa opzione abilitata richiede che, perchè il set sia valido, non ci siano altre meccaniche assegnate al record oltre a quelle richieste dal set.">
                Meccaniche esclusive
            </label>
            <span data-bs-toggle="tooltip" data-bs-placement="top" title="Questa opzione abilitata richiede che, perchè il set sia valido, non ci siano altre meccaniche assegnate al record oltre a quelle richieste dal set.">
                <i class="bi bi-info-circle ms-2"></i>
            </span>
        </div>
        <button id="eliminaSetRegole" type="button" class="btn-close position-absolute top-0 end-0 eliminaSetRegole" aria-label="Close"></button>
    </div>
</template>

<template id="addEtichetta">
    <div class="addEtichetta mb-1 d-flex justify-content-center align-items-center">
