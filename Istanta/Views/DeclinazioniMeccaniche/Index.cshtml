                                                                                Regole
                                                                            </td>
                                                                            <td style="padding-left:30px;">
                                                                            </td>
                                                                        </tr>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        </thead>
                                                        @foreach (var item in group)
                                                        {

                                                            <tr class="rowTable">
                                                                <td>

                                                                    <table>
                                                                        <tr>
                                                                            <!-- Nessun ID duplicato, usiamo classi per differenziare -->
                                                                            <td style="width:150px; display:none">
                                                                                <input style="width:150px;" type="text" class="Id" name="Id" value="@item.Id">
                                                                            </td>
                                                                            <td style="width:150px;">
                                                                                <input style="width:150px;" type="text" class="Nome" name="Nome" value="@item.Nome">
                                                                            </td>
                                                                            <td style="width:150px;">
                                                                                <input style="width:150px;" type="text" class="LivelloMeccanica" name="LivelloMeccanica" value="@item.LivelloMeccanica">
                                                                            </td>
                                                                            <td style="width:150px;">
                                                                                <input style="width:150px;" type="text" class="LivelloEsternoMeccanicaAvanzata" name="LivelloEsternoMeccanicaAvanzata" value="@item.LivelloEsternoMeccanicaAvanzata">
                                                                            </td>
                                                                            <td style="width:150px; align-items:center; justify-content:center; display:flex;">
                                                                                <input class="form-check-input applyBeforeExecution" @(item.timeToApply == timeToApplyOperation.applyBefore ? "checked" : "") type="checkbox" name="applyBeforeExecution" data-bs-toggle="tooltip" data-bs-placement="top" title="Questa flag se abilitata farà si che la meccanica in rimozione venga tolta prima del calcolo delle altre meccaniche Avanzate">

                                                                            </td>
                                                                            <td>
                                                                                <button style="margin-right:50px;" class="btn-primary regoleRimozioniMeccanicheAvanzate" type="button" id="regole" name="regole">Vedi regole</button>
                                                                            </td>
                                                                            <td>
