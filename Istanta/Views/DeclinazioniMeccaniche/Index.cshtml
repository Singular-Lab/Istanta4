@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" src="~/js/sourceEditor.js"></script>

<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" type="text/javascript">

    let declMeccanicheInstance;
    
    

    function documentReady() {
    declMeccanicheInstance = new DeclinazioneMeccaniche();

    $("#btnSourceSave").on("click", function() {
    exSourceEditor.save('DeclinazioniMeccaniche');
    });

    $("#aMenuVisual").on("click", function() {
    menuVisual();
    });

    $("#aMenuSource").on("click", function() {
    menuSource();
    });

@*     $("#vediCombMeccaniche").on("click", function() {
    declMeccanicheInstance.openModalCombinazioni();
    }); *@

    $("#headerMeccanicheAvanzate1").on("click", function() {
        console.log("testata1");
    declMeccanicheInstance.setScheda(1,$(this));
    });
    $("#headerMeccanicheAvanzate").on("click", function() {
    declMeccanicheInstance.setScheda(2,$(this));
    });
    $(".regoleBtn").on("click", function() {
    declMeccanicheInstance.openModal($(this).closest('tr').find('.Id').val());
    });
    $(".eliminaDeclinazione").on("click", function() {
        declMeccanicheInstance.deleteDeclMeccanica($(this).attr('idItem'), $(this).closest('tr'), $(this));
    });
    $(".salvaDeclinazione").on("click", function() {
    
    var row = $(this).closest('tr');
    declMeccanicheInstance.update(
    row.find('.Id').val(),
    row.find('.Nome').val(),
    row.find('.Livello').val(),
    row.find('.Formato').val(),
    $(this))
    });

    $(".regoleMeccanicheAvanzate").on("click", function() {
        declMeccanicheInstance.openModalMeccanicaAvanzata(parseInt($(this).closest('tr').find('.Id').val()));
    });
    $(".eliminaDeclinazioneMeccanicaAvanzata").on("click", function() {
        declMeccanicheInstance.deleteDeclMeccanicaAvanzata($(this).attr('idItem'), $(this).closest('tr'), $(this));
    });
    $(".salvaDeclinazioneMeccanicaAvanzata").on("click", function() {
    
    var row = $(this).closest('tr');
    declMeccanicheInstance.updateMeccanicaAvanzata(
    row.find('.Id').val(),
    row.find('.Nome').val(),
    row.find('.LivelloMeccanica').val(),
    row.find('.LivelloEsternoMeccanicaAvanzata').val(),
    row.find('.Formato').val(),
    $(this)
    )
    
    });

    $(".regoleRimozioniMeccanicheAvanzate").on("click", function() {
        declMeccanicheInstance.openModalRimozioneMeccanicaAvanzata(parseInt($(this).closest('tr').find('.Id').val()));
    });

    $(".salvaRimozioneMeccanicaAvanzata").on("click", function() {
    var row = $(this).closest('tr');
    declMeccanicheInstance.updateRimozioneMeccanicaAvanzata(
    row.find('.Id').val(),
    row.find('.Nome').val(),
    row.find('.LivelloMeccanica').val(),
    row.find('.LivelloEsternoMeccanicaAvanzata').val(),
    row.find('.applyBeforeExecution').prop('checked'),
    $(this)
    )
    });

    $(".eliminaRimozioneMeccanicaAvanzata").on("click", function() {
        declMeccanicheInstance.deleteRimozioneDeclMeccanicaAvanzata($(this).attr('idItem'), $(this).closest('tr'), $(this));
    });

    $("#tdSalvaAvanzate").on("click", function() {
    var row = $(this).closest('tr');
    declMeccanicheInstance.addMeccanicaAvanzata(
    row.find('#Nome').val(),
    row.find('#LivelloMeccanica').val(),
    row.find('#LivelloEsternoMeccanicaAvanzata').val(),
    row.find('#FormatoAv').val(),
    $(this))
    });

    $("#tdSalvaRimozioniAvanzate").on("click", function() {
    var row = $(this).closest('tr');
    declMeccanicheInstance.addRimozioneMeccanicaAvanzata(
    row.find('#Nome').val(),
    row.find('#LivelloMeccanica').val(),
    row.find('#LivelloEsternoMeccanicaAvanzata').val(),
    row.find('#applyBeforeExecution').prop('checked'),
    $(this))
    });

    $("#addSetEtichette").on("click", function() {
        declMeccanicheInstance.aggiungiNuovoSetRegole($('#modalModificaRegole').find('#regoleContainer'));
    });
    $("#salvaRegole").on("click", function() {
        declMeccanicheInstance.salvaEModifica();
    });
    $("#addSetRegoleButton").on("click", function() {
        declMeccanicheInstance.aggiungiNuovoSet($('#modalModificaRegoleMeccanicaAvanzata').find('#regoleAvanzateContainer'), $(this).attr('rimozione') === 'true')
    });
    $("#salvaRegoleAvanzate").on("click", function() {
        declMeccanicheInstance.salvaEModificaAvanzate();
    });
    $("#salvaRimozioneRegoleAvanzate").on("click", function() {
        declMeccanicheInstance.salvaEModificaRimozioneAvanzate();
    });

    $("#tipoMeccanica").on("change", function() {
        declMeccanicheInstance.checkTipoMeccanica($(this));
    });

    $("#modalModificaRegoleMeccanicaAvanzata, #modalModificaRegole").on("click", ".setEtichetteBtn", function () {
    declMeccanicheInstance.eliminaSetRegole($(this).closest('.setEtichette'));
    });

    $("#modalModificaRegoleMeccanicaAvanzata, #modalModificaRegole").on("click", ".eliminaSetRegole", function () {
    declMeccanicheInstance.eliminaSetRegole($(this).closest('.setMeccaniche'));
    });

    $("#modalModificaRegoleMeccanicaAvanzata, #modalModificaRegole").on("click", ".addEtichettaBtn", function () {
    declMeccanicheInstance.aggiungiRegola($(this).closest('.container-riga'), false);
    });

    $("#modalModificaRegoleMeccanicaAvanzata, #modalModificaRegole").on("click", ".addMeccanicaBtn", function () {
    declMeccanicheInstance.aggiungiRegola(
    $(this).closest('.container-riga'),
    true,
    $(this).attr('rimozione') === 'true'
    );
    });

    $("#modalModificaRegoleMeccanicaAvanzata, #modalModificaRegole").on("click", ".eliminaRegolaBtn", function () {
    declMeccanicheInstance.eliminaRegola($(this).closest('.etichetta'));
    });

    $("#modalModificaRegoleMeccanicaAvanzata, #modalModificaRegole").on("click", ".eliminaRegolaMeccanicaBtn", function () {
    declMeccanicheInstance.eliminaRegola($(this).closest('.meccanica'));
    });

    $("#modalModificaRegoleMeccanicaAvanzata, #modalModificaRegole").on("change", ".meccanicaVal", function () {
        declMeccanicheInstance.checkSelection($(this));
    });




    }

</script>



<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" src="https://unpkg.com/monaco-editor@latest/min/vs/loader.js"></script>

<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]">

    let exSourceEditor = new ExternalSourceEditor();

    function menuVisual() {
        document.getElementById("contentSource").style.display = "none";
        document.getElementById("contentVisual").style.display = "block";

        $(".toggleVisual").addClass("active");
        $(".toggleSource").removeClass("active");

    }
    function menuSource() {
        document.getElementById("contentSource").style.display = "block";
        document.getElementById("contentVisual").style.display = "none";

        $(".toggleSource").addClass("active");
        $(".toggleVisual").removeClass("active");

        //prima ridimensiono l'editor
        $("#editor").css("width", $("#container").css("width"));
        //atezza quanto la pagina
        $("#editor").css("height", $(window).height() - 100 + "px");

        exSourceEditor.init("SourceDeclinazioneMeccaniche");

    }
</script>