                        </div>
                    </div>
                }
                <p></p>
                <form>
                    <table>
                        <tr>
                            <td style="width:200px;">
                                Tipo meccanica
                            </td>
                            <td style="width:200px;">
                                Nome
                            </td>
                            <td style="width:200px;">
                                Livello Meccanica
                            </td>
                            <td style="width:200px;">
                                Livello Esterno
                            </td>
                            <td id="formatoAvLabel" style="width:200px;">
                                Formato
                            </td>
                            <td style="padding-left:30px;">
                            </td>
                        </tr>
                        <tr>
                            <td style="width:200px;">
                                <select id="tipoMeccanica" class="form-select" aria-label="Menu a tendina" >
                                    <option value="1">AddMeccanica</option>
                                    <option value="2">RemoveMeccanica</option>
                                </select>
                            </td>
                            <td style="width:200px;">
                                <input type="text" id="Nome" name="Nome">
                            </td>
