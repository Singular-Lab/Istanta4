                                        Livello @adaptedKey
                                    </button>
                                </h2>
                            </div>
                            <div id="collapseLivello_@adaptedKey" class="accordion-collapse collapse" aria-labelledby="headingLivello_@adaptedKey" data-parent="#accordionLivello_@adaptedKey">
                                <div class="accordion-body">
                                    <table>
                                        <thead>
                                            <tr>
                                                <td>
                                                    <table>
                                                        <tr>
                                                            <td style="width:200px;">
                                                                Nome
                                                            </td>
                                                            <td style="width:200px;">
                                                                Livello
                                                            </td>
                                                            <td style="width:200px;">
                                                                Formato
                                                            </td>
                                                            <td style="width:200px;">
                                                                Regole
                                                            </td>
                                                            <td style="padding-left:30px;">
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </thead>
                                        @foreach (var item in group)
                                        {

                                            <tr class="rowTable">
                                                <td>
                                            
                                                        <table>
                                                            <tr>
                                                                <!-- Nessun ID duplicato, usiamo classi per differenziare -->
                                                                <td style="width:200px; display:none">
                                                                    <input type="text" class="Id" name="Id" value="@item.Id">
                                                                </td>
                                                                <td style="width:200px;">
                                                                    <input type="text" class="Nome" name="Nome" value="@item.Nome">
                                                                </td>
                                                                <td style="width:200px;">
                                                                    <input type="text" class="Livello" name="Livello" value="@item.Livello">
                                                                </td>
                                                                <td style="width:200px;">
                                                                    <input type="text" class="Formato" name="Formato" value="@item.Formato">
                                                                </td>
                                                                <td>
                                                                    <button style="margin-right:50px;" class="btn-primary regoleBtn" type="button" id="regole" name="regole">Vedi regole</button>
                                                                </td>
                                                                <td>
                                                                    <button class="salvaDeclinazione" type="button">
                                                                        Salva
                                                                    </button>
                                                                </td>
                                                                <td style="padding-left:30px;">
                                                                <button class="btn btn-danger btn-sm eliminaDeclinazione" idItem="@item.Id">Elimina</button>
                                                                </td>
                                                            </tr>
                                                        </table>
                                            


                                                </td>
                                            </tr>
                                            <tr>
                                                <td><hr /></td>
                                            </tr>

                                        }
                                        <tr>
                                            <td>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <p></p>
                <form method="POST">
                    <table>
                        <tr>
                            <td style="width:200px;">
                                Nome
                            </td>
                            <td style="width:200px;">
                                Livello
                            </td>
                            <td style="width:200px;">
                                Formato
                            </td>
                            <td style="padding-left:30px;">
                            </td>
                        </tr>
                        <tr>
                            <td style="width:200px;">
                                <input type="text" id="Nome" name="Nome">
                            </td>
                            <td>
                                <input type="text" id="Livello" name="Livello" />
                            </td>
                            <td>
                                <input type="text" id="Formato" name="Formato" />
                            </td>
                            <td style="vertical-align: middle; text-align: center;">
                                <input type="submit" value="Salva">
                            </td>
                            <td style="padding-left:30px;">
                            </td>
                        </tr>
                    </table>
                </form>
            </div>
        </div>
        <div class="tab-content">

            <div id="schedaMeccanicheAvanzate" class="container tab-pane scheda">
