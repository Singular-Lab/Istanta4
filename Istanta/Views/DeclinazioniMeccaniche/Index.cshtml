@page
@model Istanta.Views.DeclinazioniMeccaniche.IndexModel
@{
}
@if (ViewBag.error != null)
{
    <div id="error_panel" class="alert alert-danger" style="position:fixed; width:100%;">
        <strong>Attenzione</strong>: @ViewBag.error
    </div>
}



<h3 style="margin-bottom:25px;">Lista meccaniche</h3>
@{
    // Raggruppa gli elementi per livello
    var groupedItems = ((List<Istanta.Models.DeclinazioneMeccanica>)ViewBag.lista_declinazione_meccaniche)
                        .GroupBy(x => x.Livello);
    var groupedItemsMeccanicheAvanzate = ((List<Istanta.Models.DeclinazioneMeccanicaAvanzata>)ViewBag.lista_meccaniche_avanzate)
    .GroupBy(x => x.LivelloEsternoMeccanicaAvanzata).OrderBy(x=>x.Key);
    var groupedItemsRimozioneMeccanicheAvanzate = ((List<Istanta.Models.RimozioneDeclinazioneMeccanica>)ViewBag.lista_meccanicheInRimozione)
    .GroupBy(x => x.LivelloEsternoMeccanicaAvanzata).OrderBy(x=>x.Key);

}
<div id="msg_container" style="display:none;">
</div>

<div class="btn-group">
    <a href="#" id="aMenuVisual" class="btn btn-primary toggleVisual active" aria-current="page">Visual</a>
    <a href="#" id="aMenuSource" class="btn btn-primary toggleSource">Source</a>
</div>


<div class="container" id="container">
    <div id="contentVisual" class="pt-3">
@*         <button class="btn btn-primary mb-3" id="vediCombMeccaniche" type="button">
            Vedi combinazioni meccaniche
        </button> *@

        <ul class="nav nav-tabs mb-3" id="schede">


            <li class="nav-item">

                <a class="nav-link active testata" style="cursor:pointer;" id="headerMeccanicheAvanzate1" data-toggle="tab">Declinazioni meccaniche</a>

            </li>

            <li class="nav-item">

                <a class="nav-link testata" id="headerMeccanicheAvanzate" style="cursor:pointer;" data-toggle="tab">Meccaniche avanzate</a>

            </li>

        </ul>

        <div class="tab-content">

