                                                                            </td>
                                                                            <td style="padding-left:30px;">
                                                                                <button class="btn btn-danger btn-sm eliminaRimozioneMeccanicaAvanzata" idItem="@item.Id">Elimina</button>
                                                                            </td>
                                                                        </tr>
                                                                    </table>



                                                                </td>
