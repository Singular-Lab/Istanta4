@page
@using Istanta.Models_2
@model Istanta.Views.Confronti.PuliziaListeModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<Istanta.Models_2.Edro21_DbContext2> FabbricaCtx2
@{
    // I20-1106 (Lotto 2): le promo come in Backup promo, le attive prime.
    TendinaPromo tendina;
    using (Edro21_DbContext2 ctx2 = FabbricaCtx2.CreateDbContext())
    {
        tendina = BackupPromo.PromoPerLaTendina(
            ctx2.Promos.Where(p => p.Stato != (Byte)StatoPromo.Eliminata).ToList(),
            DateTime.Now);
    }
}

<head>
    <title>Pulizia liste</title>
    <style>
        #tabellaReport td, #tabellaReport th { vertical-align: middle; }
        #tabellaReport tr.selezionata { background-color: #fff3cd; }
        #tabellaReport tr.impaginata td { color: #6c757d; }
        .avviso-impaginato { font-size: 11px; color: #dc3545; }
        .valori-regole { font-size: 11px; color: #555; }
        #contatori .btn { margin-right: 6px; }
    </style>
</head>

<h2>Pulizia liste</h2>
<p class="text-muted">
    Scegli una promo e una delle sue liste: il report mostra i record della promo, con la label di quella lista, che le regole del cliente
    riconoscono e che nella lista non ci sono piu'. I manuali vengono prima; chi e' impaginato si vede ma non si elimina.
    Prima di eliminare viene fatto un backup dei record dei tracciati della promo (Confronti &rarr; Backup promo).
</p>

<div class="container p-4" style="width:auto;" id="puliziaContainer">
    <div class="row">
        <div class="col-3">
            <label for="TendinaPromo" class="form-label">Promo</label>
            <select class="form-select" id="TendinaPromo">
                <option value="0">Seleziona una promo</option>
                @if (tendina.attive.Count > 0)
                {
                    <optgroup label="Promo attive">
                        @foreach (var promo in tendina.attive)
                        {
                            <option value="@promo.Id">@promo.NomePromo (@promo.DataRegistrazione.ToString("dd/MM/yyyy"))</option>
                        }
                    </optgroup>
                }
                @if (tendina.altre.Count > 0)
                {
                    <optgroup label="Promo chiuse o scadute">
                        @foreach (var promo in tendina.altre)
                        {
                            <option value="@promo.Id">@promo.NomePromo (@promo.DataRegistrazione.ToString("dd/MM/yyyy"))</option>
                        }
                    </optgroup>
                }
            </select>
        </div>
        <div class="col-2">
            <label for="TendinaCanale" class="form-label">Canale</label>
            <select class="form-select" id="TendinaCanale" disabled>
                <option value="">Tutti</option>
            </select>
        </div>
        <div class="col-2">
            <label for="TendinaArea" class="form-label">Area</label>
            <select class="form-select" id="TendinaArea" disabled>
                <option value="">Tutte</option>
            </select>
        </div>
        <div class="col-3">
            <label for="TendinaLista" class="form-label">Lista caricata</label>
            <select class="form-select" id="TendinaLista" disabled>
                <option value="0">Seleziona prima una promo</option>
            </select>
        </div>
        <div class="col-2 text-end align-self-end">
            <button class="btn btn-primary" id="btnAvviaReport" style="display:none;">Avvia report</button>
        </div>
    </div>

    <div class="row pt-3">
        <div class="col">
            <button class="btn btn-outline-secondary btn-sm" id="btnRegole">Regole di riconoscimento del cliente (SourcePuliziaListe)</button>
            <div id="contentSource" class="pt-2" style="display:none;">
                <p class="text-muted" style="font-size:12px;">
                    Ogni tipo di record ha un nome, <code>Regole</code> sui campi (stesso formato e stessi operatori delle etichette, per esempio
                    <code>{"campo":"recordInTracciato.tema","Operatore":"IN","Value":"fuori depliant"}</code>) e <code>RegoleEtichette</code>
                    (<code>{"nomeEtichetta":"SPRINT","presente":true}</code>). Fra i gruppi vale l'OR, dentro un gruppo l'AND. Un tipo senza regole non riconosce nulla.
                </p>
                <div class="text-end mb-2">
                    <button class="btn btn-primary btn-sm" id="btnSourceSave">Salva regole</button>
                </div>
                <div id="editor" style="height:360px;"></div>
            </div>
        </div>
    </div>

    <div id="reportContainer" class="pt-4" style="display:none;">
        <div class="row">
            <div class="col">
                <h4>Report <small class="text-muted" id="reportTitolo"></small></h4>
            </div>
        </div>
        <div class="row pt-2">
            <div class="col" id="contatori">
                <button class="btn btn-warning btn-sm" id="cntManuali" title="Importati manualmente. Clicca per nascondere o mostrare.">Manuali: <span>0</span></button>
                <button class="btn btn-primary btn-sm" id="cntDaLista" title="Importati da lista. Clicca per nascondere o mostrare.">Da lista: <span>0</span></button>
                <button class="btn btn-secondary btn-sm" id="cntImpaginati" title="Impaginati: non si possono eliminare. Clicca per nascondere o mostrare.">Impaginati: <span>0</span></button>
                <button class="btn btn-dark btn-sm" id="cntTutti" disabled title="I record visualizzati">Visualizzati: <span>0</span></button>
            </div>
        </div>
        <div class="row pt-3">
            <div class="col">
                <button class="btn btn-outline-dark btn-sm" id="btnSelTutti">Seleziona tutti</button>
                <button class="btn btn-outline-dark btn-sm" id="btnSelNessuno">Deseleziona tutti</button>
                <button class="btn btn-outline-warning btn-sm" id="btnSelManuali">Solo i manuali</button>
                <button class="btn btn-outline-primary btn-sm" id="btnSelDaLista">Solo quelli da lista</button>
            </div>
            <div class="col text-end">
                <button class="btn btn-danger" id="btnElimina" disabled>ELIMINA</button>
            </div>
        </div>
        <div class="row pt-3">
            <div class="col">
                <p id="pNessunRecord" style="display:none;">Nessun record da pulire: tutti i record riconosciuti dalle regole sono ancora nella lista.</p>
                <table class="table table-sm table-hover" id="tabellaReport" style="display:none;">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Codice</th>
                            <th>Gruppo</th>
                            <th>Descrizione</th>
                            <th>Label / ver.</th>
                            <th>Canale / Area</th>
                            <th>Origine</th>
                            <th>Tipo</th>
                            <th>Campi delle regole</th>
                        </tr>
                    </thead>
                    <tbody id="corpoReport"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" src="~/js/sourceEditor.js?v=3"></script>
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" src="https://unpkg.com/monaco-editor@latest/min/vs/loader.js"></script>
<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" src="~/js/puliziaListe.js?v=2"></script>

<script nonce="@HttpContextAccessor.HttpContext?.Items["ScriptNonce"]" type="text/javascript">

    let exSourceEditor = new ExternalSourceEditor();
    let puliziaListe;

    function documentReady() {
        puliziaListe = new PuliziaListe("corpoReport");

        $("#TendinaPromo").on("change", function () {
            puliziaListe.cambiaPromo(parseInt($(this).val(), 10) || 0);
        });

        $("#TendinaLista").on("change", function () {
            puliziaListe.cambiaLista(parseInt($(this).val(), 10) || 0);
        });

        $("#TendinaCanale, #TendinaArea").on("change", function () {
            puliziaListe.cambiaFiltro();
        });

        $("#btnAvviaReport").on("click", function () {
            puliziaListe.avviaReport();
        });

        $("#cntManuali").on("click", function () { puliziaListe.toggleCategoria("manuale"); });
        $("#cntDaLista").on("click", function () { puliziaListe.toggleCategoria("daLista"); });
        $("#cntImpaginati").on("click", function () { puliziaListe.toggleCategoria("impaginato"); });

        $("#btnSelTutti").on("click", function () { puliziaListe.seleziona("tutti"); });
        $("#btnSelNessuno").on("click", function () { puliziaListe.seleziona("nessuno"); });
        $("#btnSelManuali").on("click", function () { puliziaListe.seleziona("manuali"); });
        $("#btnSelDaLista").on("click", function () { puliziaListe.seleziona("daLista"); });

        $("#btnElimina").on("click", function () {
            puliziaListe.elimina();
        });

        // Le regole: l'editor si apre la prima volta che si chiede, e salva con l'azione di Confronti.
        $("#btnRegole").on("click", function () {
            var $contenuto = $("#contentSource");
            if ($contenuto.is(":visible")) {
                $contenuto.hide();
                return;
            }
            $contenuto.show();
            exSourceEditor.init("SourcePuliziaListe");
        });

        $("#btnSourceSave").on("click", function () {
            exSourceEditor.save('Confronti');
        });
    }

</script>
