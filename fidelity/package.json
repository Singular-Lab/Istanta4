{
  "name": "fidelity-promotion",
  "version": "2.18.001",
  "private": true,
  "type": "module",
  "workspaces": [
    "src",
    "server"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "check:rolldown-binding": "node scripts/checkRolldownBinding.mjs",
    "check:rolldown-binding:advice": "node scripts/checkRolldownBinding.mjs --advice",
    "deps:reinstall:clean": "rimraf node_modules && yarn install",
    "dev": "cross-env concurrently --names client,server --prefix \"[{name}]\" --prefix-colors cyan,magenta \"vite\" \"tsx server/index.ts\"",
    "dev:debug": "cross-env concurrently --names client,server --prefix \"[{name}]\" --prefix-colors cyan,magenta \"vite\" \"tsx --inspect server/index.ts\"",
    "dev:server": "cross-env NODE_ENV=development tsx server/index.ts",
    "dev:client": "vite",
    "build:client": "node scripts/checkRolldownBinding.mjs && vite build --mode production",
    "build": "yarn clean && yarn build:client",
    "benchmark:rolldown:baseline": "node scripts/rolldown/benchmark.mjs --label baseline --lazybarrel false",
    "benchmark:rolldown:post": "node scripts/rolldown/benchmark.mjs --label post --lazybarrel false",
    "benchmark:rolldown:lazybarrel": "node scripts/rolldown/benchmark.mjs --label lazybarrel --lazybarrel true",
    "benchmark:rolldown:compare": "node scripts/rolldown/compareReports.mjs --baseline reports/rolldown/baseline.txt --candidate reports/rolldown/post.txt --buildThresholdPct 5 --bundleThresholdPct 3",
    "start": "tsx server/index.ts",
    "lint": "eslint \"src/**/*.tsx\"",
    "lint:fix": "eslint \"src/**/*.tsx\" --fix",
    "type-check": "tsc --noEmit",
    "type-check:server": "tsc -p server/tsconfig.json --noEmit",
    "security-check": "yarn npm audit --all --recursive --environment production --severity moderate --no-deprecations",
    "deps-check": "depcheck --ignores=\"@types/*\"",
    "ci": "yarn type-check && yarn type-check:server && yarn lint && yarn security-check && yarn build",
    "auth:link-servizio": "tsx server/core/scripts/generaLinkAccessoServizio.ts",
    "models:sync": "tsx server/core/scripts/initializeModels.ts sync",
    "models:sync:force": "tsx server/core/scripts/initializeModels.ts sync --force",
    "models:status": "tsx server/core/scripts/initializeModels.ts status",
    "models:check": "tsx server/core/scripts/initializeModels.ts check",
    "models:sync-model": "tsx server/core/scripts/initializeModels.ts model",
    "models:sync-db-objects": "tsx server/core/scripts/initializeModels.ts sync-db-objects",
    "migrate:momenti-linear": "tsx server/core/scripts/migrateMomentiLinear.ts",
    "migrate:momenti-linear:dry-run": "tsx server/core/scripts/migrateMomentiLinear.ts --dry-run",
    "plugin:css": "tsx server/core/scripts/compilePluginCss.ts",
    "test": "vitest",
    "test:server": "vitest run",
    "test:server:coverage": "vitest run --coverage",
    "test:server:ui": "vitest --ui",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:prune": "docker compose -f docker-compose.dev.yml down -v && docker image prune -f",
    "db:export": "tsx server/core/scripts/exportToDocker.ts",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build --pull ",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build --pull never",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f app",
    "docker:prod:deploy": "docker compose -f docker-compose.prod.yml up -d --build --no-deps --pull never app",
    "docker:test:up": "docker compose -f docker-compose.test.yml up --build",
    "docker:test:up:detach": "docker compose -f docker-compose.test.yml up -d --build",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "docker:test:logs": "docker compose -f docker-compose.test.yml logs -f app",
    "docker:test:prune": "docker compose -f docker-compose.test.yml down -v && docker image prune -f"
  },
  "resolutions": {
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.19.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.3",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tailwindcss/forms": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/base64-stream": "^1.0.5",
    "@types/bcrypt": "^6.0.0",
    "@types/clean-css": "^4.2.11",
    "@types/compression": "^1.7.5",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/dropzone": "^5.7.8",
    "@types/eslint__eslintrc": "^2.1.2",
    "@types/file-saver": "^2.0.7",
    "@types/flat": "^5.0.5",
    "@types/immutability-helper": "^2.0.15",
    "@types/js-beautify": "^1.14.3",
    "@types/leaflet": "^1.9.8",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.17.17",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.4",
    "@types/postcss-import": "^14.0.3",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-transition-group": "^4.4.10",
    "@types/styled-components": "^5.1.34",
    "@types/supertest": "^7.2.0",
    "@types/tabulator-tables": "^5.5.4",
    "@types/toastify-js": "^1.12.3",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.4.16",
    "baseline-browser-mapping": "^2.9.14",
    "clean-css": "^5.3.3",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "dotenv": "^16.5.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "glob": "11.1.0",
    "globals": "^16.3.0",
    "lightningcss": "^1.27.0",
    "lodash": "^4.17.21",
    "postcss": "^8.5.3",
    "postcss-advanced-variables": "^5.0.0",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.0.0",
    "postcss-nesting": "^12.0.2",
    "postcss-prefix-selector": "^2.1.0",
    "postcss-rename": "^0.8.0",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.2",
    "sass": "^1.89.0",
    "sass-embedded": "^1.86.0",
    "supertest": "^7.2.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.1",
    "terser": "^5.39.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.7.0",
    "tsx": "^4.19.1",
    "typescript": "~5.8",
    "vite": "8.0.16",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-sri": "^0.0.2",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@react-pdf/pdfkit": "^5.1.1",
    "@react-pdf/renderer": "^4.5.1",
    "pako": "^1.0.11"
  },
  "packageManager": "yarn@4.18.1"
}
