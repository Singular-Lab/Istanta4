    { "id": 50, "type": "row", "title": "PostgreSQL", "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 51, "type": "stat", "title": "DB Size",
      "datasource": { "uid": "postgres" },
      "gridPos": { "x": 0, "y": 49, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto" },
      "targets": [{ "datasource": { "uid": "postgres" }, "format": "time_series", "refId": "A", "rawSql": "SELECT now() AS \"time\", pg_database_size(current_database())::double precision AS value;" }]
    },
    {
      "id": 52, "type": "stat", "title": "Connessioni Attive",
      "datasource": { "uid": "postgres" },
      "gridPos": { "x": 4, "y": 49, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 150 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto" },
      "targets": [{ "datasource": { "uid": "postgres" }, "format": "time_series", "refId": "A", "rawSql": "SELECT now() AS \"time\", COUNT(*)::double precision AS value FROM pg_stat_activity WHERE datname = current_database() AND state = 'active';" }]
    },
    {
      "id": 53, "type": "stat", "title": "Utilizzo Connessioni %",
      "datasource": { "uid": "postgres" },
      "gridPos": { "x": 8, "y": 49, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto" },
      "targets": [{ "datasource": { "uid": "postgres" }, "format": "time_series", "refId": "A", "rawSql": "SELECT now() AS \"time\", (100.0 * COUNT(*) / NULLIF((SELECT setting::int FROM pg_settings WHERE name = 'max_connections'), 0))::double precision AS value FROM pg_stat_activity;" }]
    },
    {
      "id": 54, "type": "stat", "title": "Cache Hit Ratio %",
      "datasource": { "uid": "postgres" },
      "gridPos": { "x": 12, "y": 49, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 98 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto" },
      "targets": [{ "datasource": { "uid": "postgres" }, "format": "time_series", "refId": "A", "rawSql": "SELECT now() AS \"time\", (100.0 * sum(blks_hit) / NULLIF(sum(blks_hit) + sum(blks_read), 0))::double precision AS value FROM pg_stat_database WHERE datname = current_database();" }]
    },
    {
      "id": 55, "type": "stat", "title": "Deadlock (totale)",
      "datasource": { "uid": "postgres" },
      "gridPos": { "x": 16, "y": 49, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto" },
      "targets": [{ "datasource": { "uid": "postgres" }, "format": "time_series", "refId": "A", "rawSql": "SELECT now() AS \"time\", deadlocks::double precision AS value FROM pg_stat_database WHERE datname = current_database();" }]
    },
    {
      "id": 56, "type": "stat", "title": "File Temporanei",
      "datasource": { "uid": "postgres" },
      "gridPos": { "x": 20, "y": 49, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto" },
      "targets": [{ "datasource": { "uid": "postgres" }, "format": "time_series", "refId": "A", "rawSql": "SELECT now() AS \"time\", temp_files::double precision AS value FROM pg_stat_database WHERE datname = current_database();" }]
    },

    {
      "id": 57, "type": "timeseries", "title": "Connessioni per Stato",
      "datasource": { "uid": "postgres" },
      "gridPos": { "x": 0, "y": 53, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "gradientMode": "opacity", "showPoints": "never", "spanNulls": false }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [{ "datasource": { "uid": "postgres" }, "format": "time_series", "refId": "A", "rawSql": "SELECT now() AS \"time\", COALESCE(state, 'unknown') AS metric, COUNT(*)::double precision AS value FROM pg_stat_activity WHERE datname = current_database() GROUP BY metric ORDER BY metric;" }]
    },
    {
      "id": 58, "type": "table", "title": "Query Attive più Lente",
      "datasource": { "uid": "postgres" },
      "gridPos": { "x": 12, "y": 53, "w": 12, "h": 8 },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "targets": [{ "datasource": { "uid": "postgres" }, "format": "table", "refId": "A", "rawSql": "SELECT pid, usename AS utente, application_name AS app, state AS stato, wait_event_type AS attesa_tipo, now() - query_start AS durata, left(query, 150) AS query_preview FROM pg_stat_activity WHERE datname = current_database() AND state = 'active' AND query NOT ILIKE '%pg_stat_activity%' ORDER BY durata DESC NULLS LAST LIMIT 15;" }]
    },
    {
      "id": 59, "type": "table", "title": "Statistiche Tabelle (Top per Righe Vive)",
      "datasource": { "uid": "postgres" },
      "gridPos": { "x": 0, "y": 61, "w": 24, "h": 8 },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "targets": [{ "datasource": { "uid": "postgres" }, "format": "table", "refId": "A", "rawSql": "SELECT schemaname AS schema, relname AS tabella, n_live_tup AS righe_vive, n_dead_tup AS righe_morte, n_mod_since_analyze AS mod_da_analyze, pg_size_pretty(pg_total_relation_size(schemaname||'.'||relname)) AS dimensione, last_autovacuum::text AS ultimo_vacuum, last_autoanalyze::text AS ultimo_analyze FROM pg_stat_user_tables ORDER BY n_live_tup DESC LIMIT 20;" }]
    },

