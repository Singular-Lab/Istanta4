          "custom": { "lineWidth": 2, "fillOpacity": 5, "gradientMode": "none", "showPoints": "never", "spanNulls": false }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        { "expr": "nodejs_eventloop_lag_p50_seconds{job=~\"$job\"} * 1000", "legendFormat": "P50", "refId": "A" },
        { "expr": "nodejs_eventloop_lag_p90_seconds{job=~\"$job\"} * 1000", "legendFormat": "P90", "refId": "B" },
        { "expr": "nodejs_eventloop_lag_p99_seconds{job=~\"$job\"} * 1000", "legendFormat": "P99", "refId": "C" }
      ]
    },
    {
      "id": 40, "type": "timeseries", "title": "Garbage Collection (% tempo per tipo)",
