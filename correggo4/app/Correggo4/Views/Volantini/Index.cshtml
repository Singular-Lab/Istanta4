    }
    @* j243: la campanella apre la tendina delle notifiche. Prima non faceva niente. *@
    <button class="bell" type="button" id="bell" title="Notifiche"
            aria-label="Notifiche, @Model.NotificheNonLette non lette">
      <svg class="i"><use href="#i-bell"/></svg>
      <span class="n" id="bellN" hidden="@bellNascosto">@bellNumero</span>
    </button>
    <div class="me">
      <div class="avatar" aria-hidden="true">@iniziali</div>
      <div class="me-t"><b>@nome</b><span><span class="role">@(Model.PuoCorreggere ? "GDO" : "Agenzia")</span>@(Model.PuoCorreggere ? "può correggere" : "sola lettura")</span></div>
    </div>
    <form method="post" action="~/Account/Logout" style="margin:0">
      @Html.AntiForgeryToken()
      <button class="logout" type="submit">Esci</button>
    </form>
  </div>
</header>

