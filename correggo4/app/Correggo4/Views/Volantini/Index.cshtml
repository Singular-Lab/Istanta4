     title="Le email di avviso quando cambia qualcosa sui volantini">
  <div class="ic"><svg class="i"><use href="@emailIco"/></svg></div>
  <div><b>Notifiche email</b><span id="notifTxt">@emailTxt</span></div>
  <div class="sw" aria-hidden="true"></div>
</div>

<script>
/* ============================================================
   Dati dal controller (VolantiniController.Index -> HubVolantini).
   promo = classificazione · PDF = volantino (classificazione, titolo)
   ============================================================ */
const DATI = @Html.Raw(jsonHome);
const UTENTE = { ruolo: DATI.puoCorreggere ? "GDO" : "Agenzia" };
const SENZA_CANALE = "Senza canale";

/* colore stabile per canale: i canali non sono tabellati, si ricava dal nome */
const TAVOLOZZA = [
  { c:"#2a8a7c", c2:"#bfe9e2" }, { c:"#d9822b", c2:"#fbe0c3" }, { c:"#6b5bb5", c2:"#dcd6f3" },
  { c:"#c8352e", c2:"#f6d0cd" }, { c:"#2f6db3", c2:"#cfe0f4" }, { c:"#8a6d1f", c2:"#efe3c0" }
];
const CANALI = new Proxy({}, { get(_, nome){
  if (nome === SENZA_CANALE) return { c:"#7c8a91", c2:"#e3e8ea" };
  let h = 0; for (const ch of String(nome)) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  return TAVOLOZZA[h % TAVOLOZZA.length];
}});

function tempoFa(iso){
  if (!iso) return "";
  const min = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
  if (min < 1) return "adesso";
  if (min < 60) return `${min} min fa`;
  const ore = Math.round(min / 60);
  if (ore < 24) return `${ore} or${ore===1?"a":"e"} fa`;
  const gg = Math.round(ore / 24);
  if (gg === 1) return "ieri";
  if (gg < 7) return `${gg} giorni fa`;
  return new Date(iso).toLocaleDateString("it-IT", { day:"numeric", month:"short" });
}
const dataBreve = iso => iso ? new Date(iso).toLocaleDateString("it-IT", { day:"2-digit", month:"2-digit" }) : "";

/* j317: i volantini dove l'Agenzia ha del lavoro di timone da fare. Si riempie poco dopo, con
   una chiamata al server (in fondo al file). Sta dichiarato qui, in alto, perche' pdfPerCanale lo
   legge al primo disegno: dichiarandolo in fondo il primo disegno morirebbe sulla zona morta
   temporale della const, e la home resterebbe vuota. */
const TIMONE_DA_FARE = new Set();

const CAMPAGNE = DATI.promo.map(p => ({
  classificazione: p.classificazione,
  aggiornato: tempoFa(p.aggiornata),
  validita: p.validitaInizio ? `valida ${dataBreve(p.validitaInizio)} – ${dataBreve(p.validitaFine)}` : "",
  volantini: p.volantini.map(v => ({
    id: v.id, titolo: v.titolo,
    canale: v.canale || SENZA_CANALE, area: v.area || "",
    versione: v.versione, pagine: v.pagine, miniatura: v.miniatura,
    stato: v.stato, aperte: v.aperte, commenti: v.commenti, bloccoMin: v.bloccoMinuti
  }))
}));

/* ---------- derivati ---------- */
function statoCampagna(c){ return c.volantini.every(v => v.stato === "approvato") ? "approvato" : "revisione"; }
function aperteCampagna(c){ return c.volantini.reduce((s,v)=>s+v.aperte,0); }
function approvati(c){ return c.volantini.filter(v=>v.stato==="approvato").length; }

// j241: Michele vuole solo "correzioni", senza "aperte"
const correzioniAperte = n => n === 1 ? "1 correzione" : `${n} correzioni`;

/* ---------- stato UI ---------- */
const PRIMA = CAMPAGNE.length ? CAMPAGNE[0].classificazione : null;
const S = { filtro:"tutte", q:"", sel:PRIMA, canale:"", area:"", hl:null,
            aperta:PRIMA };  // una sola tendina PDF aperta alla volta

const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"]/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[ch]));
const ico = id => `<svg class="i"><use href="#i-${id}"/></svg>`;

/* ============================================================
   j241 - COMMENTI DEL VOLANTINO
   Il bottone "Commenti" della card apre un riquadro su questa stessa pagina (niente finestre
   nuove del browser): l'elenco dei commenti di quel volantino, col nome e la data, e una casella
   per scriverne uno. Sono appunti generici sul volantino, non la chat di una singola correzione
   (quella dell'originale, `volantini_correzzioni_messaggistica`, resta fuori).
   Lo stile sta qui dentro per tenere la modifica in un unico punto del file.
   ============================================================ */
const STILE_COMMENTI = `
#cvelo { position: fixed; inset: 0; background: #36383a94; z-index: 300; display: none; }
#cvelo.on { display: block; }
#cbox { width: 560px; max-width: calc(100% - 32px); max-height: calc(100vh - 120px);
        margin: 60px auto 0; background: #fff; border-radius: 12px; overflow: hidden;
        display: flex; flex-direction: column; box-shadow: 0 10px 30px rgba(0,0,0,.35); }
#cbox .ctesta { background: #2a8a7c; color: #fff; padding: 10px 14px; display: flex; gap: 10px;
                align-items: center; font-weight: 700; }
#cbox .ctesta button { margin-left: auto; border: 0; background: #ffffff2e; color: #fff;
                       border-radius: 6px; padding: 4px 10px; cursor: pointer; font: inherit; }
#clista { padding: 12px 14px; overflow-y: auto; flex: 1 1 auto; min-height: 90px; }
#clista .cuno { border-bottom: 1px solid #eee; padding: 8px 0; }
#clista .cuno:last-child { border-bottom: 0; }
#clista .cchi { font-size: 12px; color: #555; margin-bottom: 2px; }
#clista .cchi b { color: #222; }
#clista .ctesto { white-space: pre-wrap; }
#clista .cvuoto { color: #666; text-align: center; padding: 18px 0; }
#cscrivi { border-top: 1px solid #e6e6e6; padding: 10px 14px; }
#cscrivi textarea { width: 100%; height: 66px; resize: vertical; font: inherit; padding: 6px 8px;
                    border: 1px solid #bbb; border-radius: 6px; box-sizing: border-box; }
#cscrivi .criga { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
#cscrivi button { background: #2a8a7c; color: #fff; border: 0; border-radius: 6px;
                  padding: 7px 14px; cursor: pointer; font: inherit; font-weight: 700; }
#cscrivi button[disabled] { opacity: .5; cursor: default; }
#cscrivi .cmsg { font-size: 12px; color: #a33; }
.badge.cbadge { background: #2a8a7c; color: #fff; }
`;

(function commenti() {
  const stile = document.createElement("style");
  stile.textContent = STILE_COMMENTI;
  document.head.appendChild(stile);

  const velo = document.createElement("div");
  velo.id = "cvelo";
  velo.innerHTML = `<div id="cbox">
      <div class="ctesta"><span id="ctitolo">Commenti</span><button type="button" id="cchiudi">CHIUDI</button></div>
      <div id="clista"></div>
      <div id="cscrivi">
        <textarea id="ctesto" maxlength="2000" placeholder="Scrivi un appunto su questo volantino…"></textarea>
        <div class="criga"><button type="button" id="cinvia">Scrivi</button><span class="cmsg" id="cmsg"></span></div>
      </div>
    </div>`;
  document.body.appendChild(velo);

  const lista = velo.querySelector("#clista");
  const testo = velo.querySelector("#ctesto");
  const msg = velo.querySelector("#cmsg");
  const invia = velo.querySelector("#cinvia");
  let volAperto = null;

  const dataOra = iso => iso ? new Date(iso).toLocaleString("it-IT",
      { day: "2-digit", month: "2-digit", year: "2-digit", hour: "2-digit", minute: "2-digit" }) : "";

  function token() {
    const i = document.querySelector('input[name="__RequestVerificationToken"]');
    return i ? i.value : "";
  }

  function disegna(commenti) {
    if (!commenti || !commenti.length) {
      lista.innerHTML = `<div class="cvuoto">Ancora nessun commento su questo volantino.</div>`;
      return;
    }
    lista.innerHTML = commenti.map(c => `<div class="cuno">
        <div class="cchi"><b>${esc(c.autore)}</b>${c.tipoAutore ? " · " + esc(c.tipoAutore) : ""} · ${dataOra(c.data)}</div>
        <div class="ctesto">${esc(c.testo)}</div>
      </div>`).join("");
  }

  function pallino(idVol, quanti) {
    document.querySelectorAll(".cbadge-" + idVol).forEach(b => {
      b.textContent = quanti || "";
      b.hidden = !quanti;
    });
  }

  function apri(idVol, titolo) {
    volAperto = idVol;
    velo.querySelector("#ctitolo").textContent = "Commenti · " + titolo;
    lista.innerHTML = `<div class="cvuoto">Carico…</div>`;
    testo.value = ""; msg.textContent = ""; invia.disabled = false;
    velo.classList.add("on");
    testo.focus();
    fetch(C4_BASE + "Correzioni/Commenti/" + idVol, { credentials: "same-origin" })
      .then(r => r.json())
      .then(j => {
        if (!j.ok) { lista.innerHTML = `<div class="cvuoto">${esc(j.messaggio || "Non si e' potuto leggere i commenti.")}</div>`; return; }
        disegna(j.dati.commenti);
        pallino(idVol, j.dati.quanti);
      })
      .catch(() => { lista.innerHTML = `<div class="cvuoto">Server non raggiungibile.</div>`; });
  }

  function chiudi() { velo.classList.remove("on"); volAperto = null; }

  velo.querySelector("#cchiudi").addEventListener("click", chiudi);
  velo.addEventListener("click", e => { if (e.target === velo) chiudi(); });
  document.addEventListener("keydown", e => { if (e.key === "Escape" && velo.classList.contains("on")) chiudi(); });

  invia.addEventListener("click", () => {
    const t = testo.value.trim();
    if (!t || volAperto == null) return;
    invia.disabled = true; msg.textContent = "";
    fetch(C4_BASE + "Correzioni/Commenti/" + volAperto, {
      method: "POST", credentials: "same-origin",
      headers: { "Content-Type": "application/json", "RequestVerificationToken": token() },
      body: JSON.stringify({ testo: t })
    }).then(r => r.json()).then(j => {
      invia.disabled = false;
      if (!j.ok) { msg.textContent = j.messaggio || "Non si e' potuto scrivere il commento."; return; }
      testo.value = "";
      disegna(j.dati.commenti);
      pallino(volAperto, j.dati.quanti);
    }).catch(() => { invia.disabled = false; msg.textContent = "Server non raggiungibile."; });
  });

  document.addEventListener("click", e => {
    const b = e.target.closest ? e.target.closest("[data-commenti]") : null;
    if (!b) return;
    e.preventDefault();
    apri(Number(b.dataset.commenti), b.dataset.titolo || "");
  });

  // i pallini di tutte le card, con una sola chiamata
  function conta() {
    fetch(C4_BASE + "Correzioni/Commenti", { credentials: "same-origin" })
      .then(r => r.json())
      .then(j => { if (j.ok) (j.dati.conti || []).forEach(c => pallino(c.idVol, c.quanti)); })
      .catch(() => {});
  }
  window.addEventListener("load", () => setTimeout(conta, 300));
})();

function matchQ(c){
  if(!S.q) return true;
  const q = S.q.toLowerCase();
  return c.classificazione.toLowerCase().includes(q) || c.volantini.some(v => v.titolo.toLowerCase().includes(q));
}
function campagneVisibili(){
  return CAMPAGNE.filter(c => (S.filtro==="tutte" || statoCampagna(c)===S.filtro) && matchQ(c));
}

// DEPRECATO (11/9/2026) - statoCampagna, pillStato, approvati e renderTabs servivano allo stato
// "In revisione / Approvato" e ai tab, tolti su richiesta di Michele: nel Correggo originale un
// volantino "approvato" non esiste (nessuno scrive quello stato) e il controller non lo produce mai.
// Restano solo per non riscoprirlo: se si decide cosa significa "approvato", il controller deve
// valorizzare PdfHub.Stato = "approvato" e qui si rimettono la pill in renderCamps e i tab nel markup.
function pillStato(st){
  if(st==="approvato") return `<span class="pill p-ok">Approvato</span>`;
  return `<span class="pill p-rev">In revisione</span>`;
}

function renderTabs(){
  if(!$("#tabs")) return;   // tab tolti: vedi DEPRECATO sopra
  const base = CAMPAGNE.filter(matchQ);
  $('[data-c="tutte"]').textContent = base.length;
  $('[data-c="revisione"]').textContent = base.filter(c=>statoCampagna(c)==="revisione").length;
  $('[data-c="approvato"]').textContent = base.filter(c=>statoCampagna(c)==="approvato").length;
  document.querySelectorAll(".tab").forEach(t => t.setAttribute("aria-selected", t.dataset.f===S.filtro));
}

function renderCamps(list){
  $("#campCount").textContent = list.length ? `${list.length}` : "";
  if(!list.length){
    $("#camps").innerHTML = `<div class="empty"><b>Nessuna promo</b>${CAMPAGNE.length ? "Prova a cambiare filtro o ricerca." : "Non ci sono promo attive."}</div>`;
    return;
  }
  const q = S.q.toLowerCase();
  $("#camps").innerHTML = list.map(c => {
    const k = c.classificazione;
    const st = statoCampagna(c), ap = aperteCampagna(c), n = c.volantini.length, ok = approvati(c);
    const col = st==="approvato" ? "var(--ok-fg)" : "#e5a200";
    const qInCamp = !q || k.toLowerCase().includes(q);
    const pdfVis = c.volantini.filter(v => qInCamp || v.titolo.toLowerCase().includes(q));
    const open = S.aperta===k || (!!q && !qInCamp);
    return `<div class="camp" aria-current="${k===S.sel}" style="--st:${col}">
      <button class="camp-head" type="button" data-k="${esc(k)}">
        <div class="camp-top"><span class="camp-name">${esc(k)}</span></div>
        <div class="camp-meta">
          <span>${n} PDF</span>
          <span class="open ${ap?"has":""}">${ap ? correzioniAperte(ap) : "nessuna aperta"}</span>
        </div>
      </button>
      <button class="pdf-tog" type="button" data-tog="${esc(k)}" aria-expanded="${open}">
        ${ico("files")} PDF caricati per canale ${ico("chev").replace('class="i"','class="i chev"')}
      </button>
      ${open ? `<div class="pdfs">${pdfPerCanale(c, pdfVis)}</div>` : ""}
    </div>`;
  }).join("");
}

/* nella tendina il prefisso della promo è ridondante: si mostra solo la parte che distingue il PDF
   (nome completo nel tooltip). Se il titolo non segue la convenzione, resta intero. */
function nomeBreve(titolo, promo){
  const p = promo + "_";
  return titolo.startsWith(p) && titolo.length > p.length ? titolo.slice(p.length) : titolo;
}

/* tendina: PDF della promo raggruppati per canale */
function pdfPerCanale(c, vols){
  const perCanale = {};
  vols.forEach(v => (perCanale[v.canale] ||= []).push(v));
  const k = c.classificazione;
  return Object.keys(perCanale).sort((a,b) => (a===SENZA_CANALE) - (b===SENZA_CANALE) || a.localeCompare(b)).map(can => {
    const kc = (CANALI[can]||{c:"#7c8a91"}).c;
    const on = k===S.sel && S.canale===can;
    return `<button class="pdf-can ${on?"on":""}" type="button" data-k="${esc(k)}" data-can="${esc(can)}" style="--kc:${kc}">
        <span class="sw-c"></span>${esc(can)}<span class="n">${perCanale[can].length}</span>
      </button>` +
      perCanale[can].map(v => {
        const st = v.stato==="approvato" ? `<span class="st ok" title="Approvato">${ico("check")}</span>`
                 : v.stato==="bloccato"  ? `<span class="st lk" title="Bloccato">${ico("lock")}</span>`
                 : v.aperte ? `<span class="st a" title="${v.aperte} correzioni">${v.aperte}</span>` : "";
        // j317: la casella del timone sta PRIMA delle altre: e' quella che dice «entra qui adesso»
        const tim = TIMONE_DA_FARE.has(v.id)
          ? `<span class="st tim" title="Il Marketing ha chiuso la finestra e ha chiesto delle modifiche col timone: entra nel volantino e riportale sull'impaginato">TIMONE</span>`
          : "";
        return `<button class="pdf ${S.hl===v.id?"on":""}" type="button" data-k="${esc(k)}" data-id="${v.id}" title="${esc(v.titolo)}.pdf">
          <span class="fi">PDF</span><span class="nm">${esc(nomeBreve(v.titolo, k))}</span><span class="mt">v${v.versione} · ${v.pagine}p</span>${tim}${st}
        </button>`;
      }).join("");
  }).join("");
}

function fly(v){
  if (v.miniatura) {
    return `<img class="fly-img" src="${esc(v.miniatura)}" alt="Pagina 1 di ${esc(v.titolo)}" loading="lazy"
              onerror="this.outerHTML=flyFinta(${v.id})">`;
  }
  return flyFinta(v.id);
}
function flyFinta(id){
  const v = CAMPAGNE.flatMap(c => c.volantini).find(x => x.id === id) || {};
  const k = CANALI[v.canale] || {c:"#7c8a91",c2:"#e3e8ea"};
  return `<div class="fly" style="--fc:${k.c};--fc2:${k.c2}">
    <div class="fh"><i style="width:34%"></i><i style="width:18%;opacity:.6"></i></div>
    <div class="fhero"></div>
    <div class="fg">${"<i></i>".repeat(9)}</div>
    <div class="ff"></div>
  </div>`;
}

function cardVol(v){
  const puoCorreggere = UTENTE.ruolo === "GDO";
  let stato;
  if(v.stato==="approvato"){
    stato = `<div class="v-state done">${ico("check")} Approvato</div>`;
  } else {
    stato = `<div class="v-state">${v.aperte ? `<span class="dot">${v.aperte}</span> correzion${v.aperte===1?"e":"i"}` : "Nessuna correzione"}</div>`;
  }
  const tags = [`<span class="pill p-area">${esc(v.canale)}${v.area ? " · " + esc(v.area) : ""}</span>`];
  if(v.stato==="bloccato") tags.push(`<span class="pill p-lock">${ico("lock")} Bloccato</span>`);
  const lock = v.stato==="bloccato" ? `<div class="v-lockinfo">Si sblocca tra ${v.bloccoMin} min</div>` : "";
  // Dall'11/9 anche l'Agenzia lavora nell'editor (accetta le correzioni): per tutti "Apri editor".
  const editLabel = v.stato==="approvato" ? "Apri in lettura" : "Apri editor";
  const editIco   = v.stato==="approvato" ? "eye" : "edit";
  return `<article class="vcard" data-id="${v.id}">
    <div class="v-body">
      <a class="v-thumb ${v.stato==="bloccato"?"locked":""}" href="${C4_BASE}Volantini/Dettaglio/${v.id}" title="Apri ${esc(v.titolo)}">${fly(v)}<span class="pages">${v.pagine} pag.</span></a>
      <div class="v-side">
        <div class="v-tags">${tags.join("")}</div>
        ${stato}${lock}
        <div class="v-actions">
          <a class="act primary" href="${C4_BASE}Volantini/Dettaglio/${v.id}">${ico(editIco)} ${editLabel}</a>
          <button class="act" type="button" data-commenti="${v.id}" data-titolo="${esc(v.titolo)}"
                  title="Appunti su questo volantino">${ico("chat")} Commenti <span class="badge cbadge cbadge-${v.id}" hidden></span></button>
        </div>
      </div>
    </div>
    <div class="v-foot">
      <span class="v-title" title="${esc(v.titolo)}">${esc(v.titolo)}</span>
      <span class="v-ver">Ver. <b>${v.versione}</b></span>
    </div>
  </article>`;
}

function fillSelect(el, label, values, cur){
  el.innerHTML = `<option value="">${label}</option>` + values.map(x => `<option ${x===cur?"selected":""}>${esc(x)}</option>`).join("");
}

function renderContent(list){
  const c = list.find(x => x.classificazione===S.sel);
  const grid = $("#grid");
  if(!c){
    $("#cTitle").textContent = "—"; $("#cSub").textContent = "";
    $("#fCanale").hidden = $("#fArea").hidden = true;
    grid.innerHTML = `<div class="empty" style="grid-column:1/-1"><b>Seleziona una promo</b>I PDF caricati compariranno qui.</div>`;
    return;
  }
  $("#fCanale").hidden = $("#fArea").hidden = false;
  const n = c.volantini.length, ok = approvati(c), ap = aperteCampagna(c);
  $("#cTitle").textContent = c.classificazione;
  $("#cSub").textContent = [`${n} PDF`, ok && `${ok} approvat${ok===1?"o":"i"}`, correzioniAperte(ap), c.validita, c.aggiornato && `aggiornata ${c.aggiornato}`].filter(Boolean).join(" · ");
  fillSelect($("#fCanale"), "Tutti i canali", [...new Set(c.volantini.map(v=>v.canale))], S.canale);
  const aree = [...new Set(c.volantini.map(v=>v.area).filter(Boolean))];
  fillSelect($("#fArea"), "Tutte le aree", aree, S.area);
  $("#fArea").hidden = aree.length === 0;

  const q = S.q.toLowerCase();
  const qInCamp = c.classificazione.toLowerCase().includes(q);
  const vols = c.volantini
    .filter(v => !S.canale || v.canale===S.canale)
    .filter(v => !S.area || v.area===S.area)
    .filter(v => !q || qInCamp || v.titolo.toLowerCase().includes(q))
    // prima quelli che richiedono attenzione
    .sort((a,b) => (a.stato==="approvato") - (b.stato==="approvato") || b.aperte - a.aperte);

  grid.innerHTML = vols.length ? vols.map(cardVol).join("")
    : `<div class="empty" style="grid-column:1/-1"><b>Nessun volantino</b>Nessun risultato con questi filtri.</div>`;
}

function render(){
  const list = campagneVisibili();
  if(!list.some(c => c.classificazione===S.sel) && list.length) { S.sel = list[0].classificazione; S.canale = S.area = ""; }
  renderTabs(); renderCamps(list); renderContent(list);
}

/* ---------- eventi ---------- */
$("#tabs")?.addEventListener("click", e => {   // tab tolti l'11/9: resta innocuo
  const t = e.target.closest(".tab"); if(!t) return;
  S.filtro = t.dataset.f; render();
});
$("#camps").addEventListener("click", e => {
  const tog = e.target.closest("[data-tog]");
  if(tog){ const k = tog.dataset.tog; S.aperta = (S.aperta===k) ? null : k; render(); return; }
  const pdf = e.target.closest(".pdf");
  if(pdf){
    S.sel = pdf.dataset.k; S.canale = S.area = ""; S.hl = +pdf.dataset.id; render();
    const card = document.querySelector(`.vcard[data-id="${S.hl}"]`);
    if(card){ card.scrollIntoView({behavior:"smooth", block:"center"}); card.classList.remove("flash"); void card.offsetWidth; card.classList.add("flash"); }
    return;
  }
  const can = e.target.closest(".pdf-can");
  if(can){ S.sel = can.dataset.k; S.area = ""; S.hl = null; S.canale = (S.canale===can.dataset.can) ? "" : can.dataset.can; render(); return; }
  const head = e.target.closest(".camp-head"); if(!head) return;
  S.sel = head.dataset.k; S.canale = S.area = ""; S.hl = null; S.aperta = head.dataset.k; render();
});
$("#q").addEventListener("input", e => { S.q = e.target.value.trim(); render(); });
$("#fCanale").addEventListener("change", e => { S.canale = e.target.value; render(); });
$("#fArea").addEventListener("change", e => { S.area = e.target.value; render(); });
document.addEventListener("keydown", e => {
  if(e.key === "/" && document.activeElement !== $("#q")) { e.preventDefault(); $("#q").focus(); }
});
/* ============================================================
   j243 - CAMPANELLA, INTERRUTTORE DELLE EMAIL, SEMAFORO CHE SUONA

   La campanella apre una tendina con le notifiche (prima non faceva niente) e c'e' il bottone
   "Segna tutte come lette": il numerino non si azzera da solo aprendo, e' una scelta di Michele.
   L'interruttore della colonna di sinistra governa le EMAIL di avviso e viene salvato sul server.
   Ogni minuto la pagina chiede se e' arrivato qualcosa: quando arriva il SEMAFORO (una finestra
   dei Category che si apre o si chiude) suona un din-don, compare una barra verde e nella
   linguetta del browser appare il numero, cosi' chi sta aspettando il via se ne accorge.
   Avvertenza: i browser non lasciano suonare una pagina se non ci si e' mai cliccato dentro;
   in quel caso la barra e il titolo si vedono comunque.
   ============================================================ */
const STILE_NOTIFICHE = `
#npan { position: fixed; top: 58px; right: 14px; width: 390px; max-width: calc(100% - 28px);
        max-height: 70vh; background: #fff; border: 1px solid var(--line); border-radius: 12px;
        box-shadow: 0 12px 30px rgba(0,0,0,.22); z-index: 320; display: flex;
        flex-direction: column; overflow: hidden; }
/* senza questa riga il display:flex vince sull'attributo hidden e la tendina resta aperta */
#npan[hidden] { display: none; }
#npan .ntesta { display: flex; align-items: center; gap: 8px; padding: 9px 12px;
                background: var(--teal-700); color: #fff; }
#npan .ntesta b { font-size: 14px; }
#npan .ntesta button { margin-left: auto; border: 0; background: #ffffff2e; color: #fff;
                       border-radius: 6px; padding: 4px 9px; cursor: pointer; font: inherit;
                       font-size: 12px; }
#npan .ntesta button[disabled] { opacity: .5; cursor: default; }
#nlista { overflow-y: auto; padding: 4px 0; }
#nlista .nuna { display: block; padding: 9px 12px; border-bottom: 1px solid #f0f3f4;
                text-decoration: none; color: var(--ink); }
#nlista .nuna:last-child { border-bottom: 0; }
#nlista .nuna:hover { background: var(--teal-50); }
#nlista .nuna.da_leggere { background: #f4fbf9; border-left: 3px solid var(--teal); }
#nlista .nuna.semaforo b { color: #1d7a34; }
#nlista .nquando { display: block; font-size: 11.5px; color: var(--ink-3); margin-top: 3px; }
#nlista .nvuoto { padding: 22px 12px; text-align: center; color: var(--ink-3); }
#nbarra { position: fixed; left: 0; right: 0; top: 0; z-index: 330; background: #1d7a34;
          color: #fff; padding: 10px 14px; display: flex; align-items: center; gap: 12px;
          font-weight: 600; box-shadow: 0 2px 10px rgba(0,0,0,.25); }
#nbarra a { color: #fff; text-decoration: underline; }
#nbarra button { margin-left: auto; border: 0; background: #ffffff2e; color: #fff;
                 border-radius: 6px; padding: 3px 9px; cursor: pointer; font: inherit; }
`;

(function notifiche(){
  const stile = document.createElement("style");
  stile.textContent = STILE_NOTIFICHE;
  document.head.appendChild(stile);

  const bell = document.getElementById("bell");
  const badge = document.getElementById("bellN");
  const notif = document.getElementById("notif");
  const TITOLO = document.title;
  let ultimoId = 0, suono = null;

  const pan = document.createElement("div");
  pan.id = "npan"; pan.hidden = true;
  pan.innerHTML = `<div class="ntesta"><b>Notifiche</b>
      <button type="button" id="nlette">Segna tutte come lette</button></div>
    <div id="nlista"><div class="nvuoto">Carico&hellip;</div></div>`;
  document.body.appendChild(pan);
  const lista = pan.querySelector("#nlista");
  const bLette = pan.querySelector("#nlette");

  function token(){
    const i = document.querySelector('input[name="__RequestVerificationToken"]');
    return i ? i.value : "";
  }
  const quando = iso => iso ? new Date(iso).toLocaleString("it-IT",
      { day:"2-digit", month:"2-digit", hour:"2-digit", minute:"2-digit" }) : "";

  function numerino(n){
    if(badge){ badge.textContent = n > 99 ? "99+" : String(n); badge.hidden = !n; }
    document.title = n > 0 ? "(" + n + ") " + TITOLO : TITOLO;
    if(bell) bell.setAttribute("aria-label", "Notifiche, " + n + " non lette");
  }

  function disegna(voci){
    if(!voci || !voci.length){
      lista.innerHTML = `<div class="nvuoto">Nessuna notifica.<br>Qui arriva il via quando si apre la finestra dei Category.</div>`;
      return;
    }
    lista.innerHTML = voci.map(v => {
      const cl = "nuna" + (v.letta ? "" : " da_leggere") + (v.semaforo ? " semaforo" : "");
      const testo = `<b>${esc(v.testo)}</b><span class="nquando">${quando(v.data)}</span>`;
      return v.link ? `<a class="${cl}" href="${esc(v.link)}">${testo}</a>`
                    : `<div class="${cl}">${testo}</div>`;
    }).join("");
  }

  function carica(){
    fetch(C4_BASE + "Notifiche", { credentials:"same-origin" })
      .then(r => r.json())
      .then(j => {
        if(!j.ok) { lista.innerHTML = `<div class="nvuoto">Non si e' potuto leggere le notifiche.</div>`; return; }
        disegna(j.dati.voci);
        numerino(j.dati.quanteNonLette);
        if(j.dati.ultimoId > ultimoId) ultimoId = j.dati.ultimoId;
        bLette.disabled = !j.dati.quanteNonLette;
      })
      .catch(() => { lista.innerHTML = `<div class="nvuoto">Server non raggiungibile.</div>`; });
  }

  function apri(){ pan.hidden = false; carica(); }
  function chiudi(){ pan.hidden = true; }

  if(bell) bell.addEventListener("click", e => { e.stopPropagation(); pan.hidden ? apri() : chiudi(); });
  document.addEventListener("click", e => {
    if(pan.hidden || pan.contains(e.target) || (bell && bell.contains(e.target))) return;
    chiudi();
  });
  document.addEventListener("keydown", e => { if(e.key === "Escape") chiudi(); });

  bLette.addEventListener("click", () => {
    bLette.disabled = true;
    fetch(C4_BASE + "Notifiche/Lette", { method:"POST", credentials:"same-origin",
        headers:{ "RequestVerificationToken": token() } })
      .then(r => r.json())
      .then(j => { if(j.ok){ numerino(0); carica(); } else bLette.disabled = false; })
      .catch(() => { bLette.disabled = false; });
  });

  /* ---------- il din-don ---------- */
  function dindon(){
    try{
      const C = window.AudioContext || window.webkitAudioContext;
      if(!C) return;
      suono = suono || new C();
      if(suono.state === "suspended") suono.resume();
      const t0 = suono.currentTime;
      [[784, 0], [1046, 0.17]].forEach(function(nota){
        const o = suono.createOscillator(), g = suono.createGain();
        o.type = "sine"; o.frequency.value = nota[0];
        g.gain.setValueAtTime(0.0001, t0 + nota[1]);
        g.gain.exponentialRampToValueAtTime(0.22, t0 + nota[1] + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, t0 + nota[1] + 0.40);
        o.connect(g); g.connect(suono.destination);
        o.start(t0 + nota[1]); o.stop(t0 + nota[1] + 0.45);
      });
    }catch(e){ /* niente suono: restano la barra e il titolo */ }
  }

  /* ---------- la barra verde ---------- */
  let orologioBarra = null;
  function barra(testo, link){
    let b = document.getElementById("nbarra");
    if(!b){ b = document.createElement("div"); b.id = "nbarra"; document.body.appendChild(b); }
    b.innerHTML = `<span>${esc(testo)}</span>` +
                  (link ? ` <a href="${esc(link)}">Vai</a>` : "") +
                  `<button type="button" aria-label="Chiudi">&times;</button>`;
    b.querySelector("button").addEventListener("click", () => b.remove());
    clearTimeout(orologioBarra);
    orologioBarra = setTimeout(() => { const x = document.getElementById("nbarra"); if(x) x.remove(); }, 120000);
  }

  /* ---------- il giro di ogni minuto ---------- */
  function giro(){
    fetch(C4_BASE + "Notifiche/Nuove?dopo=" + ultimoId, { credentials:"same-origin" })
      .then(r => r.json())
      .then(j => {
        if(!j.ok) return;
        const d = j.dati;
        numerino(d.quanteNonLette);
        if(d.ultimoId > ultimoId){
          ultimoId = d.ultimoId;
          const semafori = (d.nuove || []).filter(x => x.semaforo);
          if(semafori.length){ dindon(); barra(semafori[0].testo, semafori[0].link); }
          if(!pan.hidden) carica();
        }
      })
      .catch(() => {});
  }
  giro();
  setInterval(giro, 60000);
  document.addEventListener("visibilitychange", () => { if(!document.hidden) giro(); });

  /* ---------- l'interruttore delle email ---------- */
  function mostraInterruttore(on){
    notif.setAttribute("aria-checked", on ? "true" : "false");
    $("#notifTxt").textContent = on ? "Attive" : "Silenziate";
    notif.querySelector(".ic use").setAttribute("href", on ? "#i-bell" : "#i-bell-off");
  }
  function toggleNotif(){
    const on = notif.getAttribute("aria-checked") !== "true";
    mostraInterruttore(on);
    fetch(C4_BASE + "Notifiche/Email", { method:"POST", credentials:"same-origin",
        headers:{ "Content-Type":"application/json", "RequestVerificationToken": token() },
        body: JSON.stringify({ attive: on }) })
      .then(r => r.json())
      .then(j => { if(!j.ok) mostraInterruttore(!on); })
      .catch(() => { mostraInterruttore(!on); });
  }
  notif.addEventListener("click", toggleNotif);
  notif.addEventListener("keydown", e => { if(e.key===" "||e.key==="Enter"){ e.preventDefault(); toggleNotif(); } });
})();

/* ---------- j317: i volantini che aspettano l'Agenzia ----------
   Una chiamata sola, al caricamento. Il server risponde con l'elenco dei volantini dove il
   Marketing ha chiuso la finestra e ha davvero salvato delle modifiche nel timone; a chi non e'
   l'Agenzia risponde con un elenco vuoto, quindi qui non c'e' nessuna regola di ruolo da tenere
   allineata - sta tutta in Servizi/ServizioTimone.cs.
   Perche' non arriva insieme al resto della home: cosi' la rotta che disegna la home non si tocca.
   Se un domani servisse anche altrove, e' una riga di fetch.
   L'elenco si riempie dopo il primo disegno, percio' si ridisegna - ma solo se c'e' qualcosa:
   ridisegnare per niente farebbe sfarfallare la pagina a ogni apertura. */
(function () {
  fetch(C4_BASE + "Timone/DaSistemare", { credentials: "same-origin" })
    .then(r => r.json())
    .then(j => {
      if (!j || !j.ok || !j.dati) return;
      (j.dati.volantini || []).forEach(id => TIMONE_DA_FARE.add(Number(id)));
      if (TIMONE_DA_FARE.size) render();
    })
    .catch(() => {});
})();

render();
</script>
</body>
</html>
