@if (TempData["Avviso"] is string avvisoHome)
{
    <div style="background:#fff0c2;color:#8a5a00;font-weight:600;padding:10px 28px;border-bottom:1px solid #f0d98a">@avvisoHome</div>
}
<header class="hdr">
  <div class="hdr-in">
    <a class="brand" href="~/Volantini" aria-label="Correggo — home">
      <span class="co">Co</span>
      <span><b>Correggo</b><small>Hub correzioni</small></span>
    </a>
    <span class="sep" aria-hidden="true"></span>
    @if (string.IsNullOrWhiteSpace(Model.LogoCliente))
    {
        <div class="logo-slot" title="Logo del cliente: impostare Cliente:LogoUrl in appsettings.json">Logo cliente</div>
    }
    else
    {
        <img class="logo-img" src="@Model.LogoCliente" alt="Logo cliente" />
    }
    <div class="hdr-sp"></div>
    @* CONSULTA TUTTI I VOLANTINI (j213): per tutti, come ftp.aspx:58 e Home.aspx dell'originale *@
    <a class="logout" href="~/Storico" style="display:inline-flex;align-items:center;text-decoration:none">Consulta tutti i volantini</a>
    @if (!User.IsInRole("Agenzia"))
    {
        @* LEGENDA (j216): il manuale di Correggo in PDF. Solo Category e Marketing: l'Agenzia non corregge
           (decisione di Michele del 14/9). Il PDF lo serve /Legenda, non sta in wwwroot. *@
        <a class="logout" href="~/Legenda" target="_blank" rel="noopener" title="Legenda: il manuale di Correggo (PDF)"
           style="display:inline-flex;align-items:center;gap:6px;text-decoration:none">
            <img src="~/immagini-correggo/infoButton.png" alt="" style="width:18px;height:18px">LEGENDA
        </a>
    }
    @if (User.IsInRole("Agenzia"))
    {
        @* GESTISCI PROMO (j209): solo Agenzia, come Home.aspx:299 dell'originale *@
