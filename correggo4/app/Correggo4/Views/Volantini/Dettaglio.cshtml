    // Il ritaglio: la pagina intera, spostata e scalata perche' si veda solo il box.
    function ritaglia(b) {
        var cont = document.getElementById('mRitaglio');
        var im = document.getElementById('mRitaglioImg');
        if (!b.pagW || !b.pagH || !b.pw || !b.ph) { im.removeAttribute('src'); return; }
        var lc = cont.clientWidth, hc = cont.clientHeight;
        var s = Math.min(lc / b.pw, hc / b.ph);
        im.src = b.urlPagina;
        im.style.width = (b.pagW * s) + 'px';
        im.style.height = (b.pagH * s) + 'px';
        im.style.left = (-b.px * s + (lc - b.pw * s) / 2) + 'px';
        im.style.top = (-b.py * s + (hc - b.ph * s) / 2) + 'px';
    }

    function apri(id, clickX, clickY) {
        var b = dati[id];
        if (!b) return;

        document.querySelectorAll('.zona.aperta').forEach(function (z) { z.classList.remove('aperta'); });
        var zona = document.querySelector('.zona[data-box="' + id + '"]');
        if (zona) zona.classList.add('aperta');

        document.getElementById('mTitolo').textContent =
            (b.nomeBox || '(box)') + ' – ' + (b.basecode || '');

        boxInModale = { id: id, x: (clickX !== undefined ? clickX : b.px), y: (clickY !== undefined ? clickY : b.py) };

        caricaSchedaFoto(id);   // foto P/S e loghi da Istanta (passo 2, j206)
        riempiEdit(id);   // descrizione, prezzi e altre azioni (Edit avanzato, j200)

        var sel2 = document.getElementById('mSceltaAzione');
        if (sel2) {
            sel2.innerHTML = '<option value="">Seleziona un azione</option>' +
                b.azioni.map(function (a) { return '<option>' + esc(a) + '</option>'; }).join('');
        }

        // Propagazioni dell'Edit avanzato (j227): la colonna dell'originale, con le spunte per
        // portare la correzione sui prodotti gemelli degli altri volantini.
        disegnaPropagazioniEdit(id);

        disegnaNoteModale();

        velo.classList.add('visibile');
        modale.classList.add('visibile');
        ritaglia(b);
        ombreRitaglio();
    }

    function posizioneNelFoglio(el, ev) {
        var foglio = el.closest('.foglio');
        var r = foglio.getBoundingClientRect();
        var lp = parseFloat(foglio.dataset.larghezza) || 0;
        var ap = parseFloat(foglio.dataset.altezza) || 0;
        if (!r.width || !r.height) return {};
        return { x: (ev.clientX - r.left) / r.width * lp, y: (ev.clientY - r.top) / r.height * ap };
    }

    document.querySelectorAll('.zona').forEach(function (el) {
        el.addEventListener('click', function (ev) {
            var p = posizioneNelFoglio(el, ev);
            var idBox = el.dataset.box;
            // j236: fuori policy non si fa niente, nemmeno aprire la scheda (nell'originale per
            // quei prodotti le zone cliccabili non venivano create, tool.js:255-281).
            if (fuoriPolicy(idBox)) {
                suggerisci('Questo prodotto non e\' fra quelli che puoi correggere.', 4000);
                return;
            }
            // Senza strumento il clic sul prodotto non fa niente, come l'originale: la scheda si apre
            // solo da Edit avanzato.
            if (strumento === 'edit') { apri(idBox, p.x, p.y); return; }
            if (strumento && stato.puoScrivere) {
                if (!scrivibile()) { suggerisci(motivoNonScrivibile(), 3500); return; }
                if (strumento === 'nota') { popNuovaNota(idBox, p.x, p.y, ev); return; }
                if (strumento === 'ok') { cambiaOk(idBox, ev); return; }
                if (strumento.indexOf('timbro:') === 0) { nuovoTimbro(idBox, strumento.slice(7), p.x, p.y, ev); return; }
            }
        });
    });

    /* =====================================================================
       Correzioni (11/9/2026): note, timbri e OK visto.
       Stato iniziale da #datiCorrezioni; ogni operazione riuscita su /Correzioni/...
       restituisce lo stato completo del volantino e si ridisegna tutto.
       Le regole (ruolo, autore, blocco, scadenza, 5 minuti) le decide il server:
       qui si nascondono solo i bottoni che il server rifiuterebbe comunque.
       ===================================================================== */
    var stato = JSON.parse(document.getElementById('datiCorrezioni').textContent);
    var IMG = '/immagini-correggo/';
    var NOMI_TIMBRI = {};
    document.querySelectorAll('.timbro_img').forEach(function (bt) { NOMI_TIMBRI[bt.dataset.simbolo] = bt.title; });
    var scarto = 0;          // differenza fra orologio del browser e del server, in ms
    var strumento = null;    // null | 'nota' | 'edit' | 'ok' | 'timbro:<simbolo>'
    var boxInModale = null;  // { id, x, y } del box aperto nella modale
    var pop = document.getElementById('popCorr');
    var timerPop = null;

    function aggiornaScarto() { scarto = Date.now() - new Date(stato.adesso).getTime(); }
    aggiornaScarto();

    function token() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? t.value : '';
    }

    function api(url, corpo) {
        return fetch(url, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(corpo || {})
        }).then(function (r) {
            return r.json().catch(function () {
                return { ok: false, messaggio: r.status === 200 || r.redirected
                    ? 'Sessione scaduta: ricarica la pagina e rientra.'
                    : 'Risposta non valida dal server (' + r.status + ').' };
            });
        }).then(function (j) {
            if (j.ok && j.dati && j.dati.stato) {
                stato = j.dati.stato;
                aggiornaScarto();
                disegna();
            }
            return j;
        }).catch(function () {
            return { ok: false, messaggio: 'Server non raggiungibile.' };
        });
    }

    /* j307: la pagina aperta adesso aspetta che l'Agenzia rifaccia l'impaginato? Il velo copre il
       foglio e basterebbe, ma i pulsanti che stanno FUORI dal foglio (i cassetti, gli elenchi delle
       correzioni) non li copre nessuno: quelli passano da scrivibile(). */
    function paginaInAttesa() {
        if (stato.tipoUtente === 'Agenzia') return false;
        var lista = stato.pagineDaSistemare || [];
        if (!lista.length) return false;
        /* la pagina «di adesso» e' quella selezionata nel pannello (pag_selected): e' lei che
           comandano gli strumenti. Guardare quale foglio e' visibile sarebbe sbagliato nella
           lettura affiancata, dove i fogli visibili sono due. */
        var c = document.querySelector('.pannello_pagine .cella.pag_selected');
        var n = c ? Number(c.dataset.pagina) : NaN;
        if (isNaN(n)) {
            var f = document.querySelector('.foglio[style*="inline-block"]');
            n = f ? Number(f.dataset.numero) : NaN;
        }
        return !isNaN(n) && lista.indexOf(n) >= 0;
    }

    function scrivibile() {
        return stato.puoScrivere && !stato.bloccato && !stato.scaduto && !stato.finestraChiusaPerTe
               && !paginaInAttesa();
    }
    function motivoNonScrivibile() {
        // j307: se la pagina che si sta guardando aspetta l'Agenzia, il motivo e' quello
        if (paginaInAttesa()) return 'In attesa che l\'Agenzia sistemi l\'impaginato.';
        if (stato.bloccato) return 'Il volantino è bloccato: per ora non si possono salvare correzioni.';
        if (stato.finestraChiusaPerTe) return 'La finestra dei Category per questa promo è chiusa.';
        if (stato.scaduto) return 'Il volantino è scaduto: le correzioni sono chiuse.';
        return 'Le correzioni le scrivono Category e Marketing.';
    }

    function dataBreve(iso) {
        if (!iso) return '';
        var d = new Date(iso);
        return d.toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit' }) + ' ' +
               d.toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });
    }
    function badgeTipo(tipo) { return tipo ? '<span class="badge_tipo ' + esc(tipo) + '">' + esc(tipo) + '</span>' : ''; }
    function secondiAllAccettazione(n) {
        var ultima = new Date(n.dataModifica || n.dataInserimento).getTime();
        var adessoServer = Date.now() - scarto;
        return Math.ceil(stato.secondiBattitura - (adessoServer - ultima) / 1000);
    }
    function tempo(sec) { return sec >= 60 ? Math.ceil(sec / 60) + ' min' : sec + ' s'; }

    /* ---------- strumenti ---------- */
    function suggerisci(testo, ms) {
        var s = document.getElementById('suggerimento');
        if (!testo) { s.style.display = 'none'; return; }
        s.textContent = testo; s.style.display = 'block';
        if (ms) setTimeout(function () { if (s.textContent === testo) aggiornaSuggerimento(); }, ms);
    }
    function aggiornaSuggerimento() {
        if (strumento === 'nota') suggerisci('Nota: clicca sul prodotto da correggere');
        else if (strumento === 'edit') suggerisci('Edit avanzato: clicca su un prodotto per aprire la scheda');
        else if (strumento === 'ok') suggerisci('OK visto: clicca su un prodotto per mettere o togliere l\'OK');
        else if (strumento && strumento.indexOf('timbro:') === 0)
            suggerisci('Timbro «' + (NOMI_TIMBRI[strumento.slice(7)] || '') + '»: clicca sul prodotto');
        else suggerisci(null);
    }
    function scegliStrumento(s) {
        strumento = s;
        document.body.classList.toggle('con_strumento', !!s && s !== 'edit');
        document.body.classList.toggle('modo_edit', s === 'edit');
        document.getElementById('strNota').classList.toggle('scelto', s === 'nota');
        document.getElementById('strEdit').classList.toggle('scelto', s === 'edit');
        [['strNota', s === 'nota'], ['strEdit', s === 'edit']].forEach(function (c) {
            var im = document.querySelector('#' + c[0] + ' img');
            if (im) im.src = c[1] ? im.dataset.on : im.dataset.off;
        });
        document.querySelectorAll('.timbro_img').forEach(function (bt) {
            bt.classList.toggle('scelto', s === 'timbro:' + bt.dataset.simbolo);
        });
        document.getElementById('tOk').classList.toggle('scelto', s === 'ok');
        aggiornaSuggerimento();
    }

    /* ---------- disegno ---------- */
    function fogli() {
        var m = {};
        document.querySelectorAll('.foglio').forEach(function (f) { m[f.dataset.idPagina] = f; });
        return m;
    }
    function nascostoPerTipo(tipo) {
        return (tipo === 'Marketing' && !vedi.marketing) || (tipo === 'Category' && !vedi.category);
    }
    function perc(v, tot) { return tot ? (v / tot * 100) + '%' : '0'; }

    // Misure prese dal vecchio Correggo in pixel dell'immagine di pagina (il suo #maincontent era scalato,
    // quindi rimpicciolivano con lo zoom). Qui diventano una percentuale del foglio: se l'immagine non e'
    // ancora caricata si usa la conversione delle pagine estratte a 150 dpi (1 px = 25,4/150 mm).
    function pxPagina(f, px) {
        var img = f.querySelector('img.pagina');
        var nat = img && img.naturalWidth ? img.naturalWidth : 0;
        return nat ? (px / nat * 100) + '%' : perc(px * 25.4 / 150, parseFloat(f.dataset.larghezza));
    }

    // Spunta rossa dell'Agenzia (j221): accetta la nota o il timbro con un clic, con la domanda
    // dell'originale (correzioni.js:2144 "Sicuro di voler confermare l'attuazione della correzione?").
    function spuntaAccetta(tipo, id, classi) {
        var im = document.createElement('img');
        im.className = 'spunta_ok' + (classi ? ' ' + classi : '');
        im.src = IMG + 'done.png';
        im.alt = 'Accetta';
        im.title = 'Accetta questa correzione';
        im.addEventListener('click', function (ev) {
            ev.stopPropagation();
            if (!confirm("Sicuro di voler confermare l'attuazione della correzione?")) return;
            im.style.pointerEvents = 'none';
            api('/Correzioni/' + tipo + '/' + id + '/Accetta').then(function (j) {
                if (!j.ok) {
                    im.style.pointerEvents = '';
                    suggerisci(j.messaggio || 'La correzione non si e\' potuta accettare.', 6000);
                }
            });
        });
        return im;
    }

    function accettabile(c) { return stato.puoAccettare && c.stato === 0 && secondiAllAccettazione(c) <= 0; }

    /* Spunta dell'Agenzia su una propagazione ricevuta (j225): conferma quella riga della catena,
       come faceva l'originale con confermaNota(id_nota, id_elemento) direttamente sul gemello. */
    function spuntaPropagata(r, classi) {
        var im = document.createElement('img');
        im.className = 'spunta_ok' + (classi ? ' ' + classi : '');
        im.src = IMG + 'done.png';
        im.alt = 'Conferma';
        im.title = 'Conferma questa propagazione';
        im.addEventListener('click', function (ev) {
            ev.stopPropagation();
            if (!confirm("Sicuro di voler confermare l'attuazione della correzione?")) return;
            im.style.pointerEvents = 'none';
            api('/Correzioni/Propagazione/' + r.idCatena + '/Conferma', { selezionati: [r.id], ancheIlPilota: false })
                .then(function (j) {
                    if (!j.ok) {
                        im.style.pointerEvents = '';
                        suggerisci(j.messaggio || 'Non si e\' potuto confermare.', 7000);
                    }
                    aggiornaStato();
                });
        });
        return im;
    }

    /* ---------- megafono delle propagazioni (j223) ----------
       src come l'originale (correzioni.js:383-407): in costruzione = megafono_progress.gif,
       nessun gemello attivato (e catena di meno di un'ora) = prop_lampeggiante.gif, altrimenti prop.gif. */
    function megafono(c, classi) {
        var p = c.propagazione;
        if (!p || (!p.inCostruzione && p.gemelli <= 0)) return null;
        var im = document.createElement('img');
        im.className = 'megafono' + (classi ? ' ' + classi : '');
        im.src = IMG + (p.inCostruzione ? 'megafono_progress.gif'
                      : (p.daConsultare ? 'prop_lampeggiante.gif' : 'prop.gif'));
        im.alt = 'Propagazione';
        // j246: niente conteggi nemmeno qui (erano "N prodotti gemelli, N attivati, N fatti")
        im.title = p.inCostruzione ? 'Sto cercando lo stesso prodotto sugli altri volantini…'
                 : 'Propagazione';
        if (!p.inCostruzione) {
            im.addEventListener('click', function (ev) { ev.stopPropagation(); apriCatena(p.id); });
        } else {
            im.style.cursor = 'default';
        }
        return im;
    }

    /* l'alone lampeggiante della correzione: rosso/giallo da fare, verde/giallo quando tutta la catena
       e' stata corretta (Main.aspx:137-175, correzioni.js:397-406) */
    /* j239: quanto spazio serve a un'icona fuori dal rettangolo (30px + 4 di stacco) */
    var SPAZIO_ICONA = 36;

    /** Sposta le icone della nota se fuori dal foglio. `el` e' la nota, `f` il foglio. */
    function sistemaIcone(el, f) {
        if (!el.querySelector('.spunta_ok, .megafono')) return;
        el.classList.remove('icone_a_destra', 'icone_dentro');
        // j240: un foglio non visibile misura zero, e il conto diceva "non c'e' spazio da nessuna
        // parte" mettendo l'icona DENTRO la nota (Michele l'ha vista sopra la scritta del prodotto).
        // Sui fogli nascosti non si decide niente: ci pensa sistemaTutteLeIcone() quando si apre.
        if (!f.clientWidth) return;
        var sinistra = el.offsetLeft;
        if (sinistra >= SPAZIO_ICONA) return;
        var destra = f.clientWidth - (el.offsetLeft + el.offsetWidth);
        el.classList.add(destra >= SPAZIO_ICONA ? 'icone_a_destra' : 'icone_dentro');
    }

    /** Come sopra per le icone dei timbri, che sono elementi a se' appoggiati al centro del box. */
    function sistemaIconaTimbro(icona, f) {
        icona.classList.remove('icona_a_destra');
        if (!f.clientWidth) return;   // j240: foglio nascosto, si rifa' il conto quando si apre
        // il transform la porta a sinistra di 1,45 volte la sua larghezza
        if (icona.offsetLeft - icona.offsetWidth * 1.45 < 2) icona.classList.add('icona_a_destra');
    }

    /** j240: rifa' il conto su tutte le pagine visibili (cambio pagina, zoom). */
    function sistemaTutteLeIcone() {
        document.querySelectorAll('.foglio').forEach(function (f) {
            if (!f.clientWidth) return;
            f.querySelectorAll('.nota_chiusa').forEach(function (n) { sistemaIcone(n, f); });
            f.querySelectorAll('.megafono_timbro, .spunta_timbro').forEach(function (i) {
                sistemaIconaTimbro(i, f);
            });
        });
    }

    function classeLampeggio(c) {
        var p = c.propagazione;
        if (!p || p.inCostruzione || p.gemelli <= 0) return '';
        return p.tuttiFatti ? ' prop_fatta' : ' prop_lampeggia';
    }

    /* j307: il velo sulle pagine che il timone ha cambiato. L'elenco dei numeri arriva dallo stato
       (pagineDaSistemare), che lo calcola il server: una pagina e' in attesa se un salvataggio del
       timone ha cambiato una voce che sta o stava in quella pagina, o se ci sono caselle bloccate.
       Il velo lo vedono tutti TRANNE l'Agenzia, che e' quella che deve sistemare l'impaginato e per
       farlo deve poter lavorare. Il contrassegno sulle miniature invece lo vedono tutti, Agenzia
       compresa: a lei serve per sapere quali pagine rifare.
       Si chiama da disegna(), che gira a ogni cambio di stato: cosi' appena il timone viene salvato
       - o appena arriva una versione nuova e le pagine si sbloccano - il velo si aggiorna da se'. */
    function applicaAttesaImpaginato() {
        var lista = stato.pagineDaSistemare || [];
        var soggetto = stato.tipoUtente !== 'Agenzia';
        document.querySelectorAll('.foglio').forEach(function (f) {
            var n = Number(f.dataset.numero);
            var attesa = soggetto && lista.indexOf(n) >= 0;
            f.classList.toggle('in_attesa', attesa);
            if (!attesa) return;
            var d = document.createElement('div');
            d.className = 'attesa_agenzia corr_el';
            d.title = 'Questa pagina e\' stata cambiata nel timone: si corregge solo dal timone.';
            var s = document.createElement('span');
            s.textContent = 'In attesa che l\'Agenzia sistemi l\'impaginato.';
            d.appendChild(s);
            f.appendChild(d);
        });
        document.querySelectorAll('.pannello_pagine .cella').forEach(function (c) {
            var n2 = Number(c.dataset.pagina);
            var attesa2 = lista.indexOf(n2) >= 0;
            c.classList.toggle('attesa', attesa2);
            if (attesa2) c.title = 'In attesa che l\'Agenzia sistemi l\'impaginato.';
        });
    }

    function disegna() {
        document.querySelectorAll('.corr_el').forEach(function (e) { e.remove(); });
        applicaAttesaImpaginato();
        var mf = fogli();

        stato.note.forEach(function (n) {
            var f = mf[n.idPagina]; if (!f) return;
            if (!vedi.correzioni || (n.stato === 1 && !vedi.accettate) || nascostoPerTipo(n.tipoAutore)) return;
            var el = document.createElement('div');
            // il colore dell'autore resta anche quando e' accettata: diventa il bordo (come l'originale)
            el.className = 'nota_chiusa corr_el' + (n.stato === 1 ? ' accettata' : '') +
                (n.tipoAutore === 'Category' ? ' cat' : '') +
                (n.idAutore === stato.idUtente ? ' mia' : '') + classeLampeggio(n);
            el.style.left = perc(n.x, parseFloat(f.dataset.larghezza));
            el.style.top = perc(n.y, parseFloat(f.dataset.altezza));
            el.textContent = n.testo;
            el.title = n.testo + '\n— ' + n.autore + (n.tipoAutore ? ' (' + n.tipoAutore + ')' : '') +
                       (n.stato === 1 ? '\nAccettata' : '');
            el.addEventListener('click', function (ev) { ev.stopPropagation(); popNota(n.id, ev); });
            // j234: una sola icona, come il vecchio: se c'e' la propagazione comanda il megafono
            // e la nota non porta la spunta (l'Agenzia conferma dalla finestra della catena, dove
            // la correzione di partenza ha la sua spunta e la sua casella, j224).
            var mg = megafono(n);
            if (mg) el.appendChild(mg);
            else if (accettabile(n)) el.appendChild(spuntaAccetta('Nota', n.id));
            f.appendChild(el);
            sistemaIcone(el, f);   // j239: se le icone escono dal foglio, si spostano
        });

        stato.timbri.forEach(function (t) {
            var f = mf[t.idPagina]; if (!f) return;
            if (!vedi.correzioni || (t.stato === 1 && !vedi.accettate) || nascostoPerTipo(t.tipoAutore)) return;
            var im = document.createElement('img');
            im.className = 'corr_timbro corr_el' + (t.stato === 1 ? ' accettato' : '') + classeLampeggio(t);
            im.src = IMG + t.simbolo + (t.stato === 1 ? '_ok' : '') + '.png';
            im.alt = t.nome;
            im.title = t.nome + ' — ' + t.autore + (t.stato === 1 ? ' (accettato)' : '');
            im.style.left = perc(t.x, parseFloat(f.dataset.larghezza));
            im.style.top = perc(t.y, parseFloat(f.dataset.altezza));
            im.addEventListener('click', function (ev) { ev.stopPropagation(); popTimbro(t.id, ev); });
            f.appendChild(im);
            var mgt = megafono(t, 'megafono_timbro corr_el');
            if (mgt) {
                mgt.style.left = perc(t.x, parseFloat(f.dataset.larghezza));
                mgt.style.top = perc(t.y, parseFloat(f.dataset.altezza));
                f.appendChild(mgt);
                sistemaIconaTimbro(mgt, f);
            } else if (accettabile(t)) {
                var sp = spuntaAccetta('Timbro', t.id, 'spunta_timbro corr_el');
                sp.style.left = perc(t.x, parseFloat(f.dataset.larghezza));
                sp.style.top = perc(t.y, parseFloat(f.dataset.altezza));
                f.appendChild(sp);
                sistemaIconaTimbro(sp, f);
            }
        });

        // Propagazioni ricevute da altri volantini (j225): l'originale le manda con coordinate -1 e il
        // client le appoggia sul prodotto, impilando le successive (correzioni.js:346-357 note, 846-877 timbri).
        var pila = {};
        (stato.propagate || []).forEach(function (r) {
            var f = mf[r.idPagina], b = dati[String(r.idBox)]; if (!f || !b) return;
            if (!vedi.correzioni || (r.stato === 1 && !vedi.accettate) || nascostoPerTipo(r.tipoAutore)) return;
            var lp = parseFloat(f.dataset.larghezza), ap = parseFloat(f.dataset.altezza);
            var k = pila[r.idBox] || 0; pila[r.idBox] = k + 1;
            // j231: Michele non vuole vedere chi ha propagato la correzione, ne' nella nota ne' nel
            // suggerimento del mouse. Chi l'ha scritta si legge nella finestra del megafono.
            var titolo = (r.tipo === 'nota' ? 'Nota propagata da un altro volantino'
                                            : 'Timbro «' + r.nome + '» propagato da un altro volantino') +
                         (r.data ? ' il ' + dataBreve(r.data) : '') +
                         '\n' + r.statoTesto + (r.correttore ? ' da ' + r.correttore : '') +
                         (r.suggerimento ? '\n(proposta non ancora attivata)' : '');
            var el;
            if (r.tipo === 'nota') {
                el = document.createElement('div');
                el.className = 'nota_chiusa corr_el propagata' + (r.stato === 1 ? ' accettata' : '') +
                    (r.tipoAutore === 'Category' ? ' cat' : '') + (r.suggerimento ? ' suggerita' : '') +
                    classeLampeggio(r);
                el.textContent = r.testo;
                // j231: qui sotto c'era la riga "propagata da <autore>" (classe .propagata_da),
                // togliendola la nota mostra solo il testo della correzione.
                el.style.marginTop = (k * 34) + 'px';
            } else {
                el = document.createElement('img');
                el.className = 'corr_timbro corr_el propagata' + (r.stato === 1 ? ' accettato' : '') +
                    (r.suggerimento ? ' suggerita' : '') + classeLampeggio(r);
                el.src = IMG + r.simbolo + (r.stato === 1 ? '_ok' : '') + '.png';
                el.alt = r.nome;
                el.style.marginLeft = (k * 46) + 'px';
            }
            el.style.left = perc(b.px, lp);
            el.style.top = perc(b.py, ap);
            el.title = titolo;
            el.addEventListener('click', function (ev) { ev.stopPropagation(); apriCatena(r.idCatena); });
            f.appendChild(el);
            // j234: anche qui una sola icona. Nell'originale le propagazioni ricevute erano note
            // come le altre (ramo //PROPAGAZIONI di getCorrezioni) e passavano dalla stessa regola:
            // catena attiva -> megafono, e la conferma si faceva dalla finestra. Il j225 ci aveva
            // messo anche la spunta: resta nella finestra della catena, sulla riga di questo
            // volantino.
            if (r.tipo === 'nota') {
                var mgn = megafono(r);
                if (mgn) el.appendChild(mgn);
                else if (r.puoConfermare) el.appendChild(spuntaPropagata(r));
                sistemaIcone(el, f);
            } else {
                var mgt2 = megafono(r, 'megafono_timbro corr_el');
                if (mgt2) {
                    mgt2.style.left = perc(b.px, lp); mgt2.style.top = perc(b.py, ap);
                    mgt2.style.marginLeft = (k * 46) + 'px';
                    f.appendChild(mgt2);
                    sistemaIconaTimbro(mgt2, f);
                } else if (r.puoConfermare) {
                    var sp = spuntaPropagata(r, 'spunta_timbro corr_el');
                    sp.style.left = perc(b.px, lp); sp.style.top = perc(b.py, ap);
                    sp.style.marginLeft = (k * 46) + 'px';
                    f.appendChild(sp);
                    sistemaIconaTimbro(sp, f);
                }
            }
        });

        if (vedi.ok) stato.ok.forEach(function (o) {
            var f = mf[o.idPagina], b = dati[String(o.idBox)]; if (!f || !b) return;
            var im = document.createElement('img');
            im.className = 'corr_ok corr_el';
            im.src = IMG + 'ok.png';
            im.alt = 'OK';
            im.title = 'OK visto — ' + o.autore + ' ' + dataBreve(o.data);
            im.style.left = perc(b.px + b.pw / 2, parseFloat(f.dataset.larghezza));
            im.style.top = perc(b.py + b.ph / 2, parseFloat(f.dataset.altezza));
            im.style.width = perc(Math.min(b.pw, b.ph) * 0.32, parseFloat(f.dataset.larghezza));
            im.addEventListener('click', function (ev) { ev.stopPropagation(); popOk(o.idBox, ev); });
            f.appendChild(im);
        });

        // Edit avanzato: per chi scrive il rettangolo sul campo cambiato, gialli in attesa e verdi confermati
        // (j200). Per l'Agenzia un solo pallino sulla referenza (j219): vedi .ea_pallino.
        if (vedi.ea && stato.tipoUtente === 'Agenzia') {
            var perBox = {};
            (stato.edit || []).forEach(function (ed) {
                if (nascostoPerTipo(ed.tipoAutore)) return;
                var k = String(ed.idBox);
                if (!perBox[k]) perBox[k] = { idPagina: ed.idPagina, attesa: false, chi: [], parti: [] };
                if (ed.stato !== 2) perBox[k].attesa = true;
                var chi = ed.autore + (ed.tipoAutore ? ' (' + ed.tipoAutore + ')' : '');
                if (perBox[k].chi.indexOf(chi) < 0) perBox[k].chi.push(chi);
                perBox[k].parti.push(ed.parte === 'descrizione' ? 'descrizione, foto e loghi' : 'prezzi e azioni');
            });
            Object.keys(perBox).forEach(function (k) {
                var v = perBox[k], f = mf[v.idPagina], b = dati[k];
                if (!f || !b) return;
                var lp = parseFloat(f.dataset.larghezza), ap = parseFloat(f.dataset.altezza);
                var el = document.createElement('div');
                el.className = 'ea_pallino corr_el' + (v.attesa ? '' : ' confermata');
                el.dataset.box = k;
                el.style.left = perc(b.px + b.pw / 2, lp);
                el.style.top = perc(b.py, ap);
                el.style.width = pxPagina(f, 60);   // 60 px dell'immagine di pagina, come l'originale
                el.title = 'Edit avanzato (' + v.parti.join(' + ') + ') — ' + v.chi.join(', ') +
                           (v.attesa ? ', da confermare' : ', confermata');
                el.addEventListener('click', function (ev) { ev.stopPropagation(); apri(k); });
                f.appendChild(el);
            });
        }
        else if (vedi.ea) (stato.edit || []).forEach(function (ed) {
            var f = mf[ed.idPagina]; if (!f || nascostoPerTipo(ed.tipoAutore)) return;
            var lp = parseFloat(f.dataset.larghezza), ap = parseFloat(f.dataset.altezza);
            ed.evidenze.forEach(function (z) {
                var el = document.createElement('div');
                el.className = 'ea_evid corr_el' + (ed.stato === 2 ? ' confermata' : '') + (z.cerchio ? ' cerchio' : '');
                el.style.left = perc(z.x, lp);
                el.style.top = perc(z.y, ap);
                if (!z.cerchio) { el.style.width = perc(z.w, lp); el.style.height = perc(z.h, ap); }
                el.title = 'Edit avanzato (' + (ed.parte === 'descrizione' ? 'descrizione' : 'prezzi e azioni') + ') — ' +
                           ed.autore + (ed.stato === 2 ? ', confermata' : ', in attesa dell\'Agenzia');
                el.addEventListener('click', function (ev) { ev.stopPropagation(); apri(String(ed.idBox)); });
                f.appendChild(el);
            });
        });

        // pallini del pannello pagine: correzioni ancora da accettare
        document.querySelectorAll('.pannello_pagine .cella').forEach(function (c) {
            var idp = parseInt(c.dataset.idPagina, 10);
            var q = stato.note.filter(function (n) { return n.idPagina === idp && n.stato === 0; }).length +
                    stato.timbri.filter(function (t) { return t.idPagina === idp && t.stato === 0; }).length +
                    (stato.edit || []).filter(function (e) { return e.idPagina === idp && e.stato === 0; }).length +
                    // j225: anche le propagazioni attivate e non ancora fatte sono lavoro su questa pagina
                    (stato.propagate || []).filter(function (r) { return r.idPagina === idp && r.attivo && r.stato === 0; }).length;
            var badge = c.querySelector('.pag_notifica_errori');
            if (badge) { badge.textContent = q; badge.classList.toggle('nascosto', q === 0); }
        });

        var avv = document.getElementById('avvisoVol');
        var msg = stato.solaLettura ? 'Consultazione in sola lettura: versione ' + stato.versione + '.'
                : stato.bloccato ? 'Volantino bloccato: le correzioni non si possono salvare.'
                : (stato.scaduto && stato.puoScrivere ? 'Volantino scaduto: le correzioni sono chiuse.'
                : (stato.finestraChiusaPerTe ? 'La finestra dei Category per questa promo è chiusa: le correzioni non si possono salvare.'
                // j240: Michele vuole solo la data, senza la spiegazione in coda
                : (stato.puoAccettare && stato.finestraAperta
                   ? 'Finestra dei Category aperta fino al ' + dataBreve(stato.finestraFine) : '')));
        avv.textContent = msg;
        avv.classList.toggle('nascosto', !msg);

        disegnaStorico();
        seguiCostruzione();
        if (boxInModale && modale.classList.contains('visibile')) disegnaNoteModale();
    }

    /* ---------- popup ---------- */
    function chiudiPop() {
        pop.classList.remove('visibile');
        pop.innerHTML = '';
        if (timerPop) { clearInterval(timerPop); timerPop = null; }
    }
    function mostraPop(titolo, corpoHtml, ev) {
        if (timerPop) { clearInterval(timerPop); timerPop = null; }
        pop.innerHTML = '<div class="pc_testa"><span>' + titolo + '</span><span class="x" data-azione="chiudi">✕</span></div>' +
                        '<div class="pc_corpo">' + corpoHtml + '<div class="pc_errore" data-errore></div></div>';
        pop.classList.add('visibile');
        var w = pop.offsetWidth, h = pop.offsetHeight;
        var x = Math.min(ev.clientX + 12, window.innerWidth - w - 10);
        var y = Math.min(ev.clientY + 12, window.innerHeight - h - 10);
        pop.style.left = Math.max(110, x) + 'px';
        pop.style.top = Math.max(90, y) + 'px';
        pop.querySelector('[data-azione="chiudi"]').addEventListener('click', chiudiPop);
        var ta = pop.querySelector('textarea'); if (ta) ta.focus();
    }
    function errorePop(msg) { var e = pop.querySelector('[data-errore]'); if (e) e.textContent = msg || ''; }
    function suBottone(azione, fn) {
        var b = pop.querySelector('[data-azione="' + azione + '"]');
        if (b) b.addEventListener('click', fn);
        return b;
    }
    function inCorso(b, on) { if (b) { b.disabled = on; } }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') chiudiPop(); });

    function popNuovaNota(idBox, x, y, ev) {
        mostraPop('Nuova nota ' + badgeTipo(stato.tipoUtente),
            '<textarea placeholder="Scrivi la correzione…"></textarea>' +
            '<div class="pc_bottoni"><button class="bottone" data-azione="annulla">Annulla</button>' +
            '<button class="bottone primario" data-azione="salva">Salva</button></div>', ev);
        suBottone('annulla', chiudiPop);
        var bs = suBottone('salva', function () {
            inCorso(bs, true); errorePop('');
            api('/Correzioni/Nota', { idBox: Number(idBox), testo: pop.querySelector('textarea').value, x: x, y: y })
                .then(function (j) { if (j.ok) chiudiPop(); else { errorePop(j.messaggio); inCorso(bs, false); } });
        });
    }

    function popNota(id, ev) {
        var n = stato.note.filter(function (x) { return x.id === id; })[0];
        if (!n) return;
        var mia = n.idAutore === stato.idUtente;
        var modificabile = mia && n.stato === 0 && scrivibile();
        var meta = '<div class="pc_meta">Scritta da <b>' + esc(n.autore || '—') + '</b>' + badgeTipo(n.tipoAutore) +
                   '<br>Ultimo salvataggio ' + esc(dataBreve(n.dataModifica || n.dataInserimento)) +
                   (n.stato === 1 ? '<br><b>Accettata</b> da ' + esc(n.correttore) + ' il ' + esc(dataBreve(n.dataCorrezione)) : '') +
                   '</div>';
        var corpo = modificabile
            ? '<textarea>' + esc(n.testo) + '</textarea>' + meta +
              '<div class="pc_bottoni"><button class="bottone pericolo" data-azione="elimina">Elimina</button>' +
              '<button class="bottone primario" data-azione="salva">Salva</button></div>'
            : '<div class="pc_testo">' + esc(n.testo) + '</div>' + meta;
        if (stato.puoAccettare && n.stato === 0)
            corpo += '<div class="pc_bottoni"><button class="bottone accetta" data-azione="accetta">Accetta</button></div>';

        mostraPop(n.stato === 1 ? 'Nota accettata' : (modificabile ? 'La tua nota' : 'Nota'), corpo, ev);

        var bs = suBottone('salva', function () {
            inCorso(bs, true); errorePop('');
            api('/Correzioni/Nota/' + n.id, { testo: pop.querySelector('textarea').value })
                .then(function (j) { if (j.ok) chiudiPop(); else { errorePop(j.messaggio); inCorso(bs, false); } });
        });
        var be = suBottone('elimina', function () {
            if (be.dataset.conferma !== '1') { be.dataset.conferma = '1'; be.textContent = 'Sicuro? Elimina'; return; }
            inCorso(be, true); errorePop('');
            api('/Correzioni/Nota/' + n.id + '/Elimina')
                .then(function (j) { if (j.ok) chiudiPop(); else { errorePop(j.messaggio); inCorso(be, false); } });
        });
        var ba = suBottone('accetta', function () {
            inCorso(ba, true); errorePop('');
            api('/Correzioni/Nota/' + n.id + '/Accetta')
                .then(function (j) { if (j.ok) chiudiPop(); else { errorePop(j.messaggio); inCorso(ba, false); } });
        });
        if (ba) {
            var aggiorna = function () {
                var sec = secondiAllAccettazione(n);
                if (sec > 0) { ba.disabled = true; ba.textContent = 'Accetta tra ' + tempo(sec); }
                else { ba.disabled = false; ba.textContent = 'Accetta'; if (timerPop) { clearInterval(timerPop); timerPop = null; } }
            };
            aggiorna();
            if (secondiAllAccettazione(n) > 0) timerPop = setInterval(aggiorna, 1000);
        }
    }

    function popTimbro(id, ev) {
        var t = stato.timbri.filter(function (x) { return x.id === id; })[0];
        if (!t) return;
        var eliminabile = t.idAutore === stato.idUtente && t.stato === 0 && scrivibile();
        var corpo = '<div class="pc_timbro"><img src="' + IMG + esc(t.simbolo) + (t.stato === 1 ? '_ok' : '') + '.png" alt="">' +
                    '<div><b>' + esc(t.nome) + '</b><div class="pc_meta">Messo da <b>' + esc(t.autore) + '</b>' + badgeTipo(t.tipoAutore) +
                    '<br>' + esc(dataBreve(t.dataInserimento)) +
                    (t.stato === 1 ? '<br><b>Accettato</b> da ' + esc(t.correttore) + ' il ' + esc(dataBreve(t.dataCorrezione)) : '') +
                    '</div></div></div><div class="pc_bottoni">' +
                    (eliminabile ? '<button class="bottone pericolo" data-azione="elimina">Elimina</button>' : '') +
                    (stato.puoAccettare && t.stato === 0 ? '<button class="bottone accetta" data-azione="accetta">Accetta</button>' : '') +
                    '</div>';
        mostraPop('Timbro', corpo, ev);
        var be = suBottone('elimina', function () {
            if (be.dataset.conferma !== '1') { be.dataset.conferma = '1'; be.textContent = 'Sicuro? Elimina'; return; }
            inCorso(be, true); errorePop('');
            api('/Correzioni/Timbro/' + t.id + '/Elimina')
                .then(function (j) { if (j.ok) chiudiPop(); else { errorePop(j.messaggio); inCorso(be, false); } });
        });
        var ba = suBottone('accetta', function () {
            inCorso(ba, true); errorePop('');
            api('/Correzioni/Timbro/' + t.id + '/Accetta')
                .then(function (j) { if (j.ok) chiudiPop(); else { errorePop(j.messaggio); inCorso(ba, false); } });
        });
    }

    function popOk(idBox, ev) {
        var o = stato.ok.filter(function (x) { return String(x.idBox) === String(idBox); })[0];
        if (!o) return;
        var togli = stato.puoScrivere && scrivibile() && o.idAutore === stato.idUtente;
        mostraPop('OK visto',
            '<div class="pc_meta">Messo da <b>' + esc(o.autore) + '</b> il ' + esc(dataBreve(o.data)) + '</div>' +
            (togli ? '<div class="pc_bottoni"><button class="bottone" data-azione="togli">Togli OK</button></div>' : ''), ev);
        var bt = suBottone('togli', function () {
            inCorso(bt, true); errorePop('');
            api('/Correzioni/Box/' + idBox + '/Ok', { attivo: false })
                .then(function (j) { if (j.ok) chiudiPop(); else { errorePop(j.messaggio); inCorso(bt, false); } });
        });
    }

    function nuovoTimbro(idBox, simbolo, x, y, ev) {
        api('/Correzioni/Timbro', { idBox: Number(idBox), simbolo: simbolo, x: x, y: y })
            .then(function (j) {
                if (!j.ok) mostraPop('Timbro non messo', '<div class="pc_testo">' + esc(j.messaggio) + '</div>', ev);
            });
    }

    function cambiaOk(idBox, ev) {
        var presente = stato.ok.some(function (x) { return String(x.idBox) === String(idBox); });
        api('/Correzioni/Box/' + idBox + '/Ok', { attivo: !presente })
            .then(function (j) {
                if (!j.ok) mostraPop('OK visto', '<div class="pc_testo">' + esc(j.messaggio) + '</div>', ev);
            });
    }

    /* ---------- note nella modale del box ---------- */
    function disegnaNoteModale() {
        if (!boxInModale) return;
        var idb = Number(boxInModale.id);
        var note = stato.note.filter(function (n) { return n.idBox === idb; });
        document.getElementById('mNoteRuolo').textContent =
            stato.puoAccettare ? 'Agenzia: accetti le correzioni' : (stato.puoScrivere ? '' : 'sola lettura');
        document.getElementById('mNote').innerHTML = note.length === 0
            ? '<div class="vuoto">Nessuna nota su questo prodotto.</div>'
            : note.map(function (n) {
                return '<div class="nota_elenco' + (n.stato === 1 ? ' accettata' : (n.tipoAutore === 'Category' ? ' cat' : '')) +
                       '" data-nota="' + n.id + '" style="cursor:pointer;">' + esc(n.testo) +
                       '<div class="meta">' + esc(n.autore) + (n.tipoAutore ? ' (' + esc(n.tipoAutore) + ')' : '') +
                       ' &middot; ' + esc(dataBreve(n.dataModifica || n.dataInserimento)) +
                       (n.stato === 1 ? ' &middot; accettata' : '') + '</div></div>';
              }).join('');
        document.querySelectorAll('#mNote [data-nota]').forEach(function (el) {
            el.addEventListener('click', function (ev) { popNota(Number(el.dataset.nota), ev); });
        });

        var zona = document.getElementById('mNuovaNota');
        if (!stato.puoScrivere) { zona.innerHTML = ''; return; }
        if (!scrivibile()) { zona.innerHTML = '<div class="vuoto">' + esc(motivoNonScrivibile()) + '</div>'; return; }
        if (!zona.querySelector('textarea')) {
            zona.innerHTML = '<textarea rows="5" class="elInputVal" placeholder="Scrivi nota..."></textarea>' +
                '<div class="pc_errore" style="color:#c62828;font-weight:bold;" data-errore-modale></div>' +
                '<div style="margin-top:8px; text-align:right;"><button class="bottone primario" type="button">SALVA</button></div>';
            var bt = zona.querySelector('button');
            bt.addEventListener('click', function () {
                var ta = zona.querySelector('textarea'), er = zona.querySelector('[data-errore-modale]');
                bt.disabled = true; er.textContent = '';
                api('/Correzioni/Nota', { idBox: Number(boxInModale.id), testo: ta.value, x: boxInModale.x, y: boxInModale.y })
                    .then(function (j) {
                        bt.disabled = false;
                        if (j.ok) { ta.value = ''; } else { er.textContent = j.messaggio; }
                    });
            });
        }
    }

    /* =====================================================================
       Edit avanzato, passo 1 (j200): prezzi, altre azioni e descrizione.
       Cosa si puo' correggere lo dice lo schema del box (dati[id].schema, istruzioni del plugin).
       Le regole vere (ruolo, autore, blocco, scadenza, valori ammessi) le applica il server
       (ServizioCorrezioni.EditAvanzato.cs); qui si disegna e si nasconde cio' che rifiuterebbe.
       Due SALVA indipendenti come l'originale: descrizione (colonna 2) e offerta (colonna 3).
       ===================================================================== */
    var ETICHETTE_EA = {
        prezzo_promo: 'Prezzo Promo', prezzo_promo_kgl: 'Prezzo al Kg/Lt', prezzo_continuo: 'Prezzo Continuo',
        azione_pubblico: 'Sconto', tipo_offerta: 'Tipo offerta', nome_evento: 'Evento', note: 'Note'
    };
    // Scripts/CoopFi/agenzia.js getStileUniversale: le sole fasce che si possono scrivere.
    var FASCE_EDITABILI = ['DESCRIZIONE_TITOLO', 'DESCRIZIONE_BRAND', 'DESCRIZIONE_TIPO', 'DESCRIZIONE_GRAMMATURA'];
    var azioniScelte = [];   // altre azioni della scheda aperta: [{ id, campi: { field: valore } }]
    var lucchettiChiusi = {}; // "idBox|field" -> true: restano chiusi anche dopo SALVA o riapertura

    function chiaveTracciato(f) { return String(f).split('$').join('.'); }
    function etichettaEa(f) { return ETICHETTE_EA[chiaveTracciato(f)] || chiaveTracciato(f); }
    function editDi(id, parte) {
        return (stato.edit || []).filter(function (e) { return String(e.idBox) === String(id) && e.parte === parte; })[0];
    }
    function puoModificare(id, parte) {
        var ed = editDi(id, parte);
        return scrivibile() && !(ed && ed.stato === 0 && ed.idAutore !== stato.idUtente);
    }
    function numeroEa(s) {
        var t = String(s === null || s === undefined ? '' : s).replace(/€/g, '').replace(/\s/g, '').replace(',', '.');
        return t === '' ? NaN : Number(t);
    }
    function percentoEa(s) {
        var m = String(s === null || s === undefined ? '' : s).replace(',', '.').match(/-?\d+(\.\d+)?/);
        return m ? Number(m[0]) : NaN;
    }
    function stessoValore(tipo, a, b) {
        if (tipo === 'number') {
            var x = numeroEa(a), y = numeroEa(b);
            if (!isNaN(x) && !isNaN(y)) return Math.round(x * 100) === Math.round(y * 100);
        }
        return String(a === null || a === undefined ? '' : a).trim() === String(b === null || b === undefined ? '' : b).trim();
    }
    function compatta(s) { return String(s || '').replace(/\s+/g, ' ').trim(); }

    function riempiEdit(id, soloParte) {
        if (!soloParte || soloParte === 'descrizione') {
            disegnaDescrizione(id);
            inizializzaFotoELoghi(id);
            disegnaFoto(id);
            disegnaLoghi(id);
            piedeEdit(id, 'descrizione');
        }
        if (!soloParte || soloParte === 'offerta') { disegnaOfferta(id); piedeEdit(id, 'offerta'); }
        ombreRitaglio();
    }

    /* ---------- colonna prezzi ---------- */
    function campiOfferta(b) {
        var visti = {}, lista = [];
        (b.schema || []).forEach(function (a) {
            if (!a.label || a.label === 'base' || a.label === 'descrizione' || a.label === 'immagine') return;
            a.istruzioni.forEach(function (i) {
                if (i.valore.length === 1 || visti[i.field]) return;   // valore fisso: non si scrive
                visti[i.field] = true;
                lista.push(i);
            });
        });
        return lista;
    }
    function azioniBase(b) { return (b.schema || []).filter(function (a) { return a.label === 'base' && a.id > 0; }); }

    function disegnaOfferta(id) {
        var b = dati[id], ed = editDi(id, 'offerta');
        var abil = stato.puoScrivere && puoModificare(id, 'offerta');
        var orig = {};
        b.tracciato.forEach(function (c) { orig[c.Etichetta] = c.Valore; });
        var campi = campiOfferta(b);
        var cont = document.getElementById('mCampi');
        if (!b.schema || b.schema.length === 0) {
            cont.innerHTML = '<div class="vuoto">Questo prodotto non ha le istruzioni dell\'Edit avanzato: il volantino va riesportato da InDesign.</div>';
        } else if (campi.length === 0) {
            cont.innerHTML = '<div class="vuoto">Nessun prezzo da correggere su questo prodotto.</div>';
        } else {
            cont.innerHTML = campi.map(function (i) {
                var k = chiaveTracciato(i.field);
                var origine = orig[k] !== undefined ? orig[k] : '';
                var salvato = ed && ed.campi[k] !== undefined ? ed.campi[k] : null;
                var valore = salvato !== null ? salvato : origine;
                var attr = ' data-field="' + escA(i.field) + '" data-tipo="' + escA(i.tipo) + '" data-origine="' + escA(origine) + '"' +
                           (salvato !== null ? ' data-salvato="' + escA(salvato) + '"' : '') +
                           ' data-confermato="' + (ed && ed.stato === 2 ? '1' : '0') + '"' +
                           ' data-lock="' + (lucchettiChiusi[id + '|' + i.field] ? '2' : '1') + '"' + (abil ? '' : ' disabled');
                var campo = i.valore.length > 1
                    ? '<select class="elInputVal"' + attr + '>' + i.valore.map(function (v) {
                          return '<option value="' + escA(v) + '"' + (v === valore ? ' selected' : '') + '>' + esc(v) + '</option>';
                      }).join('') + '</select>'
                    : '<input class="elInputVal"' + attr + ' value="' + escA(valore) + '">';
                var lucchetto = (i.valore.length > 1 || !abil) ? ''
                    : '<img class="lock_img" src="' + IMG + (lucchettiChiusi[id + '|' + i.field] ? 'lock_campo.png' : 'unlock_campo.png') +
                      '" data-lucchetto="' + escA(i.field) + '" title="' + (lucchettiChiusi[id + '|' + i.field]
                          ? 'Campo bloccato: non si ricalcola' : 'Blocca il campo: non verrà ricalcolato') + '" alt="">';
                return '<div class="rigaEl"><div class="nome_campo">' + esc(etichettaEa(i.field)) + '</div>' +
                       '<div class="conLucchetto">' + lucchetto + campo + '</div></div>';
            }).join('');
        }
        cont.querySelectorAll('[data-field]').forEach(function (e) {
            segnaCampo(e, true);
            e.addEventListener('input', function () { segnaCampo(e); ricalcola(e.dataset.field); });
            e.addEventListener('change', function () { segnaCampo(e); });
        });
        cont.querySelectorAll('[data-lucchetto]').forEach(function (im) {
            im.addEventListener('click', function () {
                // changeLockState (correzioni.js:3475): state 2 = escluso dal ricalcolo
                var e = cont.querySelector('[data-field="' + im.dataset.lucchetto + '"]');
                var chiuso = e.dataset.lock !== '2';
                e.dataset.lock = chiuso ? '2' : '1';
                if (chiuso) lucchettiChiusi[id + '|' + im.dataset.lucchetto] = true;
                else delete lucchettiChiusi[id + '|' + im.dataset.lucchetto];
                im.src = IMG + (chiuso ? 'lock_campo.png' : 'unlock_campo.png');
                im.title = chiuso ? 'Campo bloccato: non si ricalcola' : 'Blocca il campo: non verrà ricalcolato';
            });
        });

        azioniScelte = ed ? ed.azioni.map(function (a) {
            var c = {}; Object.keys(a.campi).forEach(function (k) { c[k] = a.campi[k]; });
            return { id: a.id, campi: c };
        }) : [];
        disegnaAzioniScelte(id);
        document.getElementById('mReset').style.visibility = (abil && campi.length) ? 'visible' : 'hidden';
    }

    function segnaCampo(e, senzaOmbre) {
        var diverso = !stessoValore(e.dataset.tipo, e.value, e.dataset.origine);
        var confermato = e.dataset.confermato === '1' && e.dataset.salvato !== undefined &&
                         stessoValore(e.dataset.tipo, e.value, e.dataset.salvato);
        e.classList.toggle('borderFixed', diverso && confermato);
        e.classList.toggle('borderFix', diverso && !confermato);
        if (!senzaOmbre) ombreRitaglio();
    }

    // Ricalcolo (decisione dell'11/9): formule CoopFi di getIstruzioniAutocomplete (Scripts/CoopFi/agenzia.js),
    // adattate a Famila, dove lo sconto e' il testo "30%" di azione_pubblico. "old" = valore originale.
    // Un campo col lucchetto chiuso non si tocca (correzioni.js:3636).
    function ricalcola(cambiato) {
        var cont = document.getElementById('mCampi');
        function el(f) { return cont.querySelector('[data-field="' + f + '"]'); }
        function val(f) { var e = el(f); return e ? e.value : ''; }
        function old(f) { var e = el(f); return e ? e.dataset.origine : ''; }
        function scrivi(f, v) {
            var e = el(f);
            if (!e || e.disabled || e.dataset.lock === '2' || e.tagName === 'SELECT') return false;
            e.value = v; segnaCampo(e); return true;
        }
        function sconto(promo, continuo) {
            if (!(continuo > 0) || isNaN(promo)) return null;
            var s = Math.round(100 - promo / continuo * 100);
            return (s >= 0 && s <= 100) ? s + '%' : null;
        }
        var promo = numeroEa(val('prezzo_promo')), continuo = numeroEa(val('prezzo_continuo'));
        var oPromo = numeroEa(old('prezzo_promo')), oKgl = numeroEa(old('prezzo_promo_kgl'));
        var sc;
        if (cambiato === 'prezzo_promo') {
            if (oPromo > 0 && !isNaN(oKgl) && !isNaN(promo)) scrivi('prezzo_promo_kgl', (oKgl * promo / oPromo).toFixed(2));
            sc = sconto(promo, continuo); if (sc) scrivi('azione_pubblico', sc);
        } else if (cambiato === 'prezzo_continuo') {
            sc = sconto(promo, continuo); if (sc) scrivi('azione_pubblico', sc);
        } else if (cambiato === 'azione_pubblico') {
            var nuovoSc = percentoEa(val('azione_pubblico')), oSc = percentoEa(old('azione_pubblico'));
            if (!isNaN(nuovoSc) && !isNaN(oSc) && oSc < 100 && oPromo > 0 && nuovoSc >= 0 && nuovoSc < 100) {
                var nuovo = oPromo * (100 - nuovoSc) / (100 - oSc);
                if (scrivi('prezzo_promo', nuovo.toFixed(2)) && !isNaN(oKgl))
                    scrivi('prezzo_promo_kgl', (oKgl * nuovo / oPromo).toFixed(2));
            }
        }
    }

    document.getElementById('mReset').addEventListener('click', function () {
        // resetCampiOffertaAOriginale (correzioni.js:3488): solo i campi della colonna prezzi
        document.querySelectorAll('#mCampi [data-field]').forEach(function (e) {
            if (e.disabled) return;
            e.value = e.dataset.origine;
            segnaCampo(e, true);
        });
        ombreRitaglio();
    });

    /* ---------- altre azioni ---------- */
    function disegnaAzioniScelte(id) {
        var b = dati[id];
        var abil = stato.puoScrivere && puoModificare(id, 'offerta');
        var base = azioniBase(b);
        var cont = document.getElementById('mAzioniScelte');
        cont.innerHTML = azioniScelte.map(function (sc, idx) {
            var a = base.filter(function (x) { return x.id === sc.id; })[0];
            var titolo = a ? a.titolo : ('Azione ' + sc.id);
            var istr = a ? a.istruzioni : [];
            var fissi = istr.filter(function (i) { return i.valore.length === 1; }).map(function (i) {
                return esc(etichettaEa(i.field)) + ': ' + esc(i.valore[0] === '' ? '(vuoto)' : i.valore[0]);
            }).join(' &middot; ');
            var visti = {};
            var campi = istr.filter(function (i) {
                if (i.valore.length === 1 || visti[i.field]) return false;
                visti[i.field] = true; return true;
            }).map(function (i) {
                var k = chiaveTracciato(i.field), v = sc.campi[k] !== undefined ? sc.campi[k] : '';
                var attr = ' data-az="' + idx + '" data-campo="' + escA(k) + '"' + (abil ? '' : ' disabled');
                return '<div>' + esc(etichettaEa(i.field)) + '</div>' + (i.valore.length > 1
                    ? '<select class="elInputVal"' + attr + '>' + i.valore.map(function (o) {
                          return '<option value="' + escA(o) + '"' + (o === v ? ' selected' : '') + '>' + esc(o) + '</option>';
                      }).join('') + '</select>'
                    : '<input class="elInputVal"' + attr + ' value="' + escA(v) + '">');
            }).join('');
            return '<div class="azioneBaseContainer"><span class="titolo_azioneBase">' + esc(titolo) + '</span>' +
                   (fissi ? '<div class="fissi">' + fissi + '</div>' : '') + campi +
                   (abil ? '<span class="x" data-togli="' + idx + '" title="Togli questa azione">X</span>' : '') + '</div>';
        }).join('');
        cont.querySelectorAll('[data-az]').forEach(function (e) {
            var aggiorna = function () { azioniScelte[Number(e.dataset.az)].campi[e.dataset.campo] = e.value; };
            if (e.tagName === 'SELECT') aggiorna();
            e.addEventListener('input', aggiorna);
            e.addEventListener('change', aggiorna);
        });
        cont.querySelectorAll('[data-togli]').forEach(function (x) {
            x.addEventListener('click', function () { azioniScelte.splice(Number(x.dataset.togli), 1); disegnaAzioniScelte(id); });
        });

        var sel = document.getElementById('mAzioni');
        var libere = base.filter(function (a) { return !azioniScelte.some(function (s) { return s.id === a.id; }); });
        sel.innerHTML = '<option value="">Seleziona un azione</option>' + libere.map(function (a) {
            return '<option value="' + a.id + '">' + esc(a.titolo) + '</option>';
        }).join('');
        sel.style.display = (abil && libere.length) ? '' : 'none';
        sel.onchange = function () {
            var idAz = Number(sel.value);
            if (!idAz) return;
            azioniScelte.push({ id: idAz, campi: {} });
            disegnaAzioniScelte(id);
        };
    }

    /* ---------- descrizione ---------- */
    // Le fasce: <TAG>testo</TAG>, una riga per paragrafo (correzioni.js:2339-2425). Gli spazi fra una
    // fascia e l'altra si conservano, cosi' la descrizione ricomposta resta com'era fuori dal testo.
    function leggiFasce(grezza) {
        var out = [], re = /<([A-Z0-9_]+)>([\s\S]*?)<\/\1>/g, m, pos = 0, n = 0;
        grezza = grezza || '';
        while ((m = re.exec(grezza)) !== null) {
            var fuori = grezza.slice(pos, m.index);
            if (fuori.trim()) out.push({ blocco: n++, tag: '', righe: [fuori.trim()], dopo: '' });
            else if (fuori && out.length) out[out.length - 1].dopo = fuori;
            out.push({ blocco: n++, tag: m[1], righe: m[2].split('\n'), dopo: '' });
            pos = m.index + m[0].length;
        }
        var coda = grezza.slice(pos);
        if (coda.trim()) out.push({ blocco: n++, tag: '', righe: [coda.trim()], dopo: '' });
        else if (coda && out.length) out[out.length - 1].dopo = coda;
        return out;
    }
    function fasciaUniversale(tag) {
        for (var i = 0; i < FASCE_EDITABILI.length; i++) if (tag.indexOf(FASCE_EDITABILI[i]) === 0) return FASCE_EDITABILI[i];
        return '';
    }
    function componiDescrizione() {
        var blocchi = {}, ordine = [];
        document.querySelectorAll('#mDescrizione p[data-blocco]').forEach(function (p) {
            var k = p.dataset.blocco;
            if (!blocchi[k]) { blocchi[k] = { tag: p.dataset.tag, righe: [], dopo: decodeURIComponent(p.dataset.dopo || '') }; ordine.push(k); }
            blocchi[k].righe.push(p.textContent.replace(/[<>\r\n]/g, ''));
        });
        return ordine.map(function (k) {
            var bl = blocchi[k], t = bl.righe.join('\n');
            return (bl.tag ? '<' + bl.tag + '>' + t + '</' + bl.tag + '>' : t) + bl.dopo;
        }).join('');
    }
    function disegnaDescrizione(id) {
        var b = dati[id], ed = editDi(id, 'descrizione');
        var cont = document.getElementById('mDescrizione');
        document.getElementById('mDescrAvviso').classList.add('nascosto');
        cont.classList.remove('borderFix', 'borderFixed');
        if (!b.descrizioneGrezza) {
            cont.className = '';
            cont.innerHTML = (b.descrizione.length === 0)
                ? '<div class="fascia senza">nessuna descrizione</div>'
                : b.descrizione.map(function (d) {
                    return '<div class="fascia ' + (d.tag || 'senza') + '">' + esc(d.testo) + '</div>';
                  }).join('');
            return;
        }
        var abil = stato.puoScrivere && puoModificare(id, 'descrizione');
        var grezza = ed && ed.campi.descrizione !== undefined ? ed.campi.descrizione : b.descrizioneGrezza;
        cont.className = 'descr_edit';
        cont.dataset.origine = b.descrizioneGrezza;
        cont.dataset.salvato = ed ? grezza : '';
        cont.dataset.confermato = ed && ed.stato === 2 ? '1' : '0';
        cont.innerHTML = leggiFasce(grezza).map(function (f) {
            var classe = f.tag ? fasciaUniversale(f.tag) : '';
            var editabile = abil && !!classe;
            return f.righe.map(function (r) {
                return '<p class="' + (classe || 'senza') + '" data-blocco="' + f.blocco + '" data-tag="' + escA(f.tag) +
                       '" data-dopo="' + escA(encodeURIComponent(f.dopo)) + '" contenteditable="' + (editabile ? 'true' : 'false') +
                       '"' + (f.tag && !classe ? ' title="Questa fascia non si corregge da qui"' : '') + '>' + esc(r) + '</p>';
            }).join('');
        }).join('');
        cont.querySelectorAll('p[contenteditable=true]').forEach(function (p) {
            p.addEventListener('keydown', function (ev) { if (ev.key === 'Enter') ev.preventDefault(); });
            p.addEventListener('paste', function (ev) {
                ev.preventDefault();
                var t = ((ev.clipboardData || window.clipboardData).getData('text') || '').replace(/[\r\n<>]+/g, ' ');
                document.execCommand('insertText', false, t);
            });
            p.addEventListener('input', function () { segnaDescrizione(); });
        });
        segnaDescrizione(true);
    }
    function segnaDescrizione(senzaOmbre) {
        var cont = document.getElementById('mDescrizione');
        if (!cont.classList.contains('descr_edit')) return;
        var ora = componiDescrizione();
        var diverso = compatta(ora) !== compatta(cont.dataset.origine);
        var confermato = cont.dataset.confermato === '1' && compatta(ora) === compatta(cont.dataset.salvato);
        cont.classList.toggle('borderFix', diverso && !confermato);
        cont.classList.toggle('borderFixed', diverso && confermato);
        // getAlertsOnEditAvanzatoTextChanged (CoopFi): se cambiano i numeri, attenzione al peso. In Famila
        // il peso sta anche nel titolo ("300GR"), quindi si guarda tutta la descrizione.
        function numeri(x) { return (String(x).replace(/<[^>]*>/g, ' ').match(/\d+(?:[.,]\d+)?/g) || []).join('|'); }
        document.getElementById('mDescrAvviso').classList.toggle('nascosto', numeri(ora) === numeri(cont.dataset.origine));
        if (!senzaOmbre) ombreRitaglio();
    }

    /* ---------- stato, bottoni e chiamate ---------- */
    function piedeEdit(id, parte) {
        var b = dati[id], ed = editDi(id, parte);
        var el = document.getElementById(parte === 'offerta' ? 'eaOffertaPiede' : 'eaDescrPiede');
        var disponibile = parte === 'offerta' ? (b.schema && b.schema.length > 0)
                        : (!!b.descrizioneGrezza || !!(b.figli && b.figli.immagine));
        var html = '';
        if (ed) {
            html += '<div class="ea_stato ' + (ed.stato === 2 ? 'confermata' : 'registrata') + '"><b>' +
                    (ed.stato === 2 ? 'Confermata dall\'Agenzia' : 'In attesa dell\'Agenzia') + '</b><br>' +
                    'Correzione di ' + esc(ed.autore) + (ed.tipoAutore ? ' (' + esc(ed.tipoAutore) + ')' : '') +
                    ' &middot; ' + esc(dataBreve(ed.data)) + '</div>';
        }
        // j227: correzione arrivata da un altro volantino: si dice da dove, e non si tocca da qui
        if (ed && ed.propagata) {
            html += '<div class="ea_prop_da">Correzione <b>propagata</b> da <b>' + esc(ed.daPromo) + '</b> &middot; ' +
                    esc(ed.daVolantino) + (ed.daPagina ? ' (pag. ' + ed.daPagina + ')' : '') + '<br>' +
                    (stato.puoScrivere ? 'La propagazione si toglie dal volantino di partenza.'
                                       : 'Sul volantino di partenza trovi la correzione completa.') + '</div>';
            var bt2 = [];
            if (stato.puoAccettare && ed.stato === 0)
                // j246: il nome e la misura del vecchio
                bt2.push('<button class="bottone accetta grande" type="button" data-ea="conferma">CONFERMA CORREZIONE</button>');
            html += '<div class="ea_bottoni">' + bt2.join('') + '</div><div class="ea_errore" data-ea-errore></div>';
            el.innerHTML = html;
            el.querySelectorAll('[data-ea]').forEach(function (bt) {
                bt.addEventListener('click', function () {
                    eseguiEdit(id, parte, bt.dataset.ea, bt, el.querySelector('[data-ea-errore]'));
                });
            });
            return;
        }
        var bottoni = [];
        if (disponibile && stato.puoScrivere) {
            if (!scrivibile()) {
                html += '<div class="ea_stato">' + esc(motivoNonScrivibile()) + '</div>';
            } else if (ed && ed.stato === 0 && ed.idAutore !== stato.idUtente) {
                html += '<div class="ea_stato">Può modificarla o annullarla solo chi l\'ha fatta. Per segnalare altro usa una nota.</div>';
            } else {
                // j246: nel vecchio il bottone del salvataggio si chiamava «CONFERMA CORREZIONE»
                bottoni.push('<button class="bottone grande" type="button" data-ea="salva">CONFERMA CORREZIONE</button>');
                if (ed && ed.stato === 0) bottoni.push('<button class="bottone pericolo" type="button" data-ea="annulla">ANNULLA CORREZIONE</button>');
            }
        } else if (stato.puoAccettare && ed && ed.stato === 0) {
            bottoni.push('<button class="bottone accetta grande" type="button" data-ea="conferma">CONFERMA CORREZIONE</button>');
        }
        html += '<div class="ea_bottoni">' + bottoni.join('') + '</div><div class="ea_errore" data-ea-errore></div>';
        el.innerHTML = html;
        el.querySelectorAll('[data-ea]').forEach(function (bt) {
            bt.addEventListener('click', function () {
                // annullare chiede un secondo clic, come l'eliminazione delle note (niente confirm())
                if (bt.dataset.ea === 'annulla' && bt.dataset.sicuro !== '1') {
                    bt.dataset.sicuro = '1'; bt.textContent = 'SICURO? ANNULLA';
                    return;
                }
                eseguiEdit(id, parte, bt.dataset.ea, bt, el.querySelector('[data-ea-errore]'));
            });
        });
    }

    /* ---------- propagazione dell'Edit avanzato (j227) ----------
       La colonna "Propagazioni" della finestra, come nell'originale (correzioni.js:2537-2600):
       chi scrive decide a mano su quali volantini gemelli portare la correzione. Una sezione per
       parte, perche' in Correggo4 prezzi e descrizione si salvano e si confermano separatamente. */
    var NOMI_PARTE = { offerta: 'Prezzi e azioni', descrizione: 'Descrizione, foto e loghi' };

    function disegnaPropagazioniEdit(id) {
        var cont = document.getElementById('mPropagazioni');
        var html = '', quante = 0;
        ['offerta', 'descrizione'].forEach(function (parte) {
            var ed = editDi(id, parte);
            if (!ed) return;
            quante++;
            html += '<div class="ea_prop" data-parte="' + parte + '">' +
                    '<div class="ea_prop_tit">' + NOMI_PARTE[parte] + '</div>';
            if (ed.propagata) {
                html += '<div class="ea_prop_vuoto">Correzione <b>propagata</b> da <b>' + esc(ed.daPromo) +
                        '</b><br>' + esc(ed.daVolantino) + (ed.daPagina ? ' &middot; pag. ' + ed.daPagina : '') + '</div>';
            } else {
                html += '<div class="ea_prop_vuoto" data-gemelli="' + parte + '">Cerco i prodotti gemelli…</div>';
            }
            html += '</div>';
        });
        if (quante === 0)
            html = '<div class="vuoto">' + (stato.puoScrivere
                ? 'Salva una correzione: poi qui scegli su quali volantini gemelli portarla.'
                : 'nessuna propagazione') + '</div>';
        cont.innerHTML = html;
        cont.querySelectorAll('[data-gemelli]').forEach(function (d) {
            caricaGemelliEdit(id, d.dataset.gemelli, d.parentNode);
        });
    }

    function caricaGemelliEdit(id, parte, cassetta) {
        apiGet('/Correzioni/Edit/' + id + '/Gemelli/' + parte).then(function (j) {
            if (!document.body.contains(cassetta)) return;
            if (!j.ok) {
                var v = cassetta.querySelector('.ea_prop_vuoto');
                if (v) v.textContent = j.messaggio || 'Gemelli non disponibili.';
                return;
            }
            disegnaGemelliEdit(id, parte, cassetta, j.dati || []);
        });
    }

    function disegnaGemelliEdit(id, parte, cassetta, lista) {
        /* j246 (Michele, 16/9): come nel vecchio, una pastiglia per volantino gemello con la «i»
           e il solo nome del volantino. Il conteggio nel titolo non si scrive piu' e i dettagli
           (promo, pagina, versione, prodotto, stato) stanno nel suggerimento del mouse.
           Le vecchie righe con tutti i dati in chiaro (classe .ea_prop_riga) non si disegnano piu':
           lo stile resta nel file, DEPRECATO, perche' non serve piu' a nessuno ma dice com'era. */
        var html = '<div class="ea_prop_tit">' + NOMI_PARTE[parte] + '</div>';
        if (lista.length === 0) {
            html += '<div class="ea_prop_vuoto">Questo prodotto non compare su altri volantini aperti.</div>';
        } else {
            html += lista.map(function (g) {
                // l'Agenzia l'elenco lo legge e basta: le propagazioni le decide chi scrive
                var bloccato = !stato.puoScrivere || g.fatto || g.proprio || g.bloccato || g.scaduto;
                var dettagli = g.promo + ' \u00b7 ' + g.volantino + ' \u00b7 pag. ' + g.pagina +
                               ' \u00b7 vers. ' + g.versione + '\n' + g.etichetta + '\n' + g.statoTesto;
                return '<label class="ea_pill' + (g.propagato ? ' on' : '') + (bloccato ? ' ferma' : '') +
                       '" title="' + escA(dettagli) + '">' +
                       '<input type="checkbox" data-gem="' + g.idBox + '"' + (g.propagato ? ' checked' : '') +
                       (bloccato ? ' disabled' : '') + '>' +
                       '<span class="i">i</span><span class="nome">' + esc(g.volantino) + '</span></label>';
            }).join('');
        }
        cassetta.innerHTML = html;
        cassetta.querySelectorAll('[data-gem]').forEach(function (cb) {
            cb.addEventListener('change', function () {
                cb.disabled = true;
                api('/Correzioni/Edit/' + id + '/Propaga/' + parte,
                    { idGemello: Number(cb.dataset.gem), propaga: cb.checked })
                    .then(function (j) {
                        if (!j.ok) suggerisci(j.messaggio || 'Non si e\' potuto propagare.', 7000);
                        caricaGemelliEdit(id, parte, cassetta);
                    });
            });
        });
    }

    function raccogliOfferta() {
        var campi = [];
        document.querySelectorAll('#mCampi [data-field]').forEach(function (e) {
            if (!stessoValore(e.dataset.tipo, e.value, e.dataset.origine))
                campi.push({ field: chiaveTracciato(e.dataset.field), valore: e.value });
        });
        return {
            campi: campi,
            azioni: azioniScelte.map(function (a) {
                return { id: a.id, campi: Object.keys(a.campi).map(function (k) { return { field: k, valore: a.campi[k] }; }) };
            })
        };
    }

    function eseguiEdit(id, parte, azione, bottone, errore) {
        var url = '/Correzioni/Edit/' + encodeURIComponent(id) + '/', corpo = {};
        if (azione === 'salva') {
            if (parte === 'offerta') { url += 'Offerta'; corpo = raccogliOfferta(); }
            else {
                url += 'Descrizione'; corpo = raccogliScheda();
                if (corpo.foto && corpo.foto.length) {
                    var p = Object.keys(fotoCorrenti).filter(function (k) { return fotoCorrenti[k].stato === 1; }).length;
                    if (p !== 1) {
                        errore.textContent = p === 0 ? 'Deve esserci una foto primaria (P).'
                                                     : 'Ci può essere una sola foto primaria (P): togli la P dalle altre.';
                        return;
                    }
                }
            }
        } else {
            url += parte + '/' + (azione === 'annulla' ? 'Annulla' : 'Conferma');
        }
        bottone.disabled = true;
        errore.textContent = '';
        api(url, corpo).then(function (j) {
            if (!j.ok) {
                bottone.disabled = false;
                if (bottone.dataset.ea === 'annulla') { bottone.dataset.sicuro = ''; bottone.textContent = 'ANNULLA CORREZIONE'; }
                errore.textContent = j.messaggio || 'Operazione non riuscita.';
                return;
            }
            if (boxInModale && String(boxInModale.id) === String(id)) riempiEdit(id, parte);
        });
    }

    /* ---------- foto P/S e loghi (passo 2, j206) ----------
       Le referenze del gruppo, la foto scelta, P/S e i loghi arrivano da Istanta (GET /Correzioni/Edit/{id}/Scheda);
       sopra si applica la correzione registrata. Istanta alla conferma applica solo il cambio di foto
       (decisione dell'11/9, come l'originale): P/S e loghi l'Agenzia li riporta a mano. */
    var schedaFoto = null;     // { id, stato: 'carico' | 'ok' | 'errore', foto: [...], errore }
    var fotoCorrenti = {};     // codice -> { guid, stato }   stato 1 P, 2 S, 3 niente
    var loghiAlterati = {};    // guidId -> { guidId, sigla, nome, stato }   4 aggiungi, 5 togli
    var catalogoLoghi = null;  // { lista } | { errore }
    var tabLoghi = 'prodotto'; // 'prodotto' | 'store'

    function apiGet(url) {
        return fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
            .then(function (r) {
                return r.json().catch(function () {
                    return { ok: false, messaggio: 'Risposta non valida dal server (' + r.status + '): ricarica la pagina.' };
                });
            })
            .catch(function () { return { ok: false, messaggio: 'Server non raggiungibile.' }; });
    }
    function miniatura(guid, larghezza) {
        return urlFoto + '?width=' + larghezza + '&guidId=' + encodeURIComponent(guid);
    }
    function statoIstanta(f) { return (f.statoSelezione === 1 || f.statoSelezione === 2) ? f.statoSelezione : 3; }

    function caricaSchedaFoto(id) {
        schedaFoto = { id: String(id), stato: 'carico' };
        tabLoghi = 'prodotto';
        apiGet('/Correzioni/Edit/' + encodeURIComponent(id) + '/Scheda').then(function (j) {
            if (!schedaFoto || schedaFoto.id !== String(id)) return;   // nel frattempo si e' aperto un altro prodotto
            schedaFoto = j.ok ? { id: String(id), stato: 'ok', foto: j.dati.foto || [] }
                              : { id: String(id), stato: 'errore', errore: j.messaggio };
            inizializzaFotoELoghi(id);
            disegnaFoto(id);
            disegnaLoghi(id);
            ombreRitaglio();
        });
    }

    function inizializzaFotoELoghi(id) {
        fotoCorrenti = {};
        loghiAlterati = {};
        if (!schedaFoto || schedaFoto.id !== String(id) || schedaFoto.stato !== 'ok') return;
        schedaFoto.foto.forEach(function (f) { fotoCorrenti[f.codice] = { guid: f.guidFoto, stato: statoIstanta(f) }; });
        var ed = editDi(id, 'descrizione');
        ((ed && ed.foto) || []).forEach(function (v) {
            if (v.stato >= 1 && v.stato <= 3 && fotoCorrenti[v.codice]) fotoCorrenti[v.codice] = { guid: v.guidId, stato: v.stato };
            if (v.stato === 4 || v.stato === 5) loghiAlterati[v.guidId] = { guidId: v.guidId, sigla: v.codice, nome: v.nomeFile, stato: v.stato };
        });
    }

    function disegnaFoto(id) {
        var b = dati[id], cont = document.getElementById('mFoto');
        if (!schedaFoto || schedaFoto.id !== String(id) || schedaFoto.stato === 'carico') {
            cont.innerHTML = '<div class="vuoto">Carico le foto da Istanta…</div>';
            return;
        }
        if (schedaFoto.stato === 'errore') {
            cont.innerHTML = '<div class="ea_stato">Foto non disponibili: ' + esc(schedaFoto.errore) +
                             '<br>La descrizione si può correggere lo stesso.</div>';
            return;
        }
        if (schedaFoto.foto.length === 0) { cont.innerHTML = '<div class="vuoto">Istanta non ha referenze per questo prodotto.</div>'; return; }
        var ed = editDi(id, 'descrizione');
        var abil = stato.puoScrivere && puoModificare(id, 'descrizione');
        var sintesi = b.campi.map(function (c) { return esc(c.Etichetta) + ':' + esc(c.Valore); }).join('<br>');
        cont.innerHTML = schedaFoto.foto.map(function (f) {
            var c = fotoCorrenti[f.codice];
            var salvata = ((ed && ed.foto) || []).filter(function (v) { return v.codice === f.codice && v.stato <= 3; })[0];
            var bordo = (salvata && ed.stato === 2 && salvata.guidId === c.guid && salvata.stato === c.stato) ? ' borderFixed'
                      : ((c.guid !== f.guidFoto || c.stato !== statoIstanta(f)) ? ' borderFix' : '');
            var classe = c.stato === 1 ? ' primaria' : (c.stato === 2 ? ' secondaria' : ' nessuna');
            var dis = abil ? '' : ' disabled';
            return '<div class="scheda_foto' + classe + bordo + '" data-codice="' + escA(f.codice) + '">' +
                   (c.guid ? '<img src="' + escA(miniatura(c.guid, 88)) + '" alt="">'
                           : '<img class="senza_foto" src="' + escA(IMG + 'nofoto.png') + '" alt="nessuna foto"' +
                             ' title="A sistema non c\'e\' una foto per questa referenza">') +
                   '<div class="ps">' +
                     '<label><input type="checkbox" data-ps="1"' + (c.stato === 1 ? ' checked' : '') + dis + '> P</label>' +
                     '<label><input type="checkbox" data-ps="2"' + (c.stato === 2 ? ' checked' : '') + dis + '> S</label>' +
                   '</div>' +
                   '<div class="dati">' +
                     '<div class="codice">' + esc(f.codice) + ' &ndash; ' + esc(f.descrizione) + '</div>' + sintesi +
                     '<div class="pulsanti">' +
                       '<button type="button" class="bottone" data-cambia' + dis + '>Cambia</button>' +
                       '<button type="button" class="bottone" data-carica' + (dis || (caricando[f.codice] ? ' disabled' : '')) + '>' +
                         (caricando[f.codice] ? 'Carico…' : 'Carica nuova foto') + '</button>' +
                     '</div>' +
                   '</div></div>';
        }).join('');
        cont.querySelectorAll('.scheda_foto').forEach(function (card) {
            var codice = card.dataset.codice;
            card.querySelectorAll('[data-ps]').forEach(function (cb) {
                cb.addEventListener('change', function () {
                    // P e S si escludono sulla stessa referenza; niente spunta = non selezionata (correzioni.js:4296)
                    fotoCorrenti[codice].stato = cb.checked ? Number(cb.dataset.ps) : 3;
                    disegnaFoto(id);
                    ombreRitaglio();
                });
            });
            var bc = card.querySelector('[data-cambia]');
            if (bc) bc.addEventListener('click', function () { apriSceltaFoto(id, codice); });
            var bn = card.querySelector('[data-carica]');
            if (bn) bn.addEventListener('click', function () { scegliFotoNuova(id, codice); });
        });
    }

    /* ---------- carica nuova foto (j217): come editAvanzato_SceltaFotoNuova dell'originale ----------
       Il file va subito in archivio su Olimpo; la correzione si registra poi col SALVA descrizione. */
    var caricando = {};            // codice -> true mentre il file sta salendo
    var attesaFoto = null;         // { id, codice } fra il clic e la scelta del file
    var ESTENSIONI_FOTO = ['jpg', 'jpeg', 'png', 'tif', 'tiff', 'webp', 'psd'];
    var inputFotoNuova = document.getElementById('fileFotoNuova');

    function scegliFotoNuova(id, codice) {
        attesaFoto = { id: id, codice: codice };
        inputFotoNuova.value = '';
        inputFotoNuova.click();
    }
    inputFotoNuova.addEventListener('change', function () {
        var file = inputFotoNuova.files && inputFotoNuova.files[0];
        if (!file || !attesaFoto) return;
        var id = attesaFoto.id, codice = attesaFoto.codice;
        attesaFoto = null;
        var est = (file.name.split('.').pop() || '').toLowerCase();
        if (ESTENSIONI_FOTO.indexOf(est) < 0) {
            suggerisci('«' + file.name + '» non è un\'immagine: si possono caricare ' + ESTENSIONI_FOTO.join(', ') + '.', 6000);
            return;
        }
        if (!confirm('Sicuro di voler caricare la nuova foto «' + file.name + '» per il codice ' + codice + '?')) return;
        caricaFotoNuova(id, codice, file);
    });

    function caricaFotoNuova(id, codice, file) {
        caricando[codice] = true;
        disegnaFoto(id);
        suggerisci('Carico «' + file.name + '»… con i file grandi ci vuole qualche minuto.', 8000);
        var corpo = new FormData();
        corpo.append('file', file, file.name);
        fetch('/Correzioni/Edit/' + id + '/Foto/' + encodeURIComponent(codice), {
            method: 'POST', credentials: 'same-origin',
            headers: { 'RequestVerificationToken': token() }, body: corpo
        })
        .then(function (r) { return r.json().catch(function () { return { ok: false, messaggio: 'Risposta inattesa dal server.' }; }); })
        .then(function (j) {
            delete caricando[codice];
            if (!j.ok) { suggerisci(j.messaggio || 'La foto non è stata caricata.', 7000); disegnaFoto(id); return; }
            if (fotoCorrenti[codice]) fotoCorrenti[codice].guid = j.dati.guidId;
            disegnaFoto(id);
            ombreRitaglio();
            suggerisci('Foto «' + j.dati.nomeFile + '» caricata: adesso premi SALVA descrizione per registrare la correzione.', 8000);
        })
        .catch(function () {
            delete caricando[codice];
            disegnaFoto(id);
            suggerisci('La foto non è stata caricata: controlla il collegamento e riprova.', 7000);
        });
    }

    function apriSceltaFoto(id, codice) {
        var ov = document.getElementById('sceltaFoto'), gr = document.getElementById('sfGriglia');
        document.getElementById('sfTitolo').textContent = 'Foto di ' + codice + ' in Istanta: clicca quella da usare';
        gr.innerHTML = '<div class="vuoto">Carico le foto…</div>';
        ov.classList.add('visibile');
        apiGet('/Correzioni/Foto/' + encodeURIComponent(codice)).then(function (j) {
            if (!ov.classList.contains('visibile')) return;
            if (!j.ok) { gr.innerHTML = '<div class="ea_errore">' + esc(j.messaggio) + '</div>'; return; }
            var corrente = fotoCorrenti[codice] ? fotoCorrenti[codice].guid : '';
            gr.innerHTML = (j.dati || []).length === 0 ? '<div class="vuoto">Nessuna foto per questo codice.</div>'
                : j.dati.map(function (f) {
                    return '<div class="voce_foto' + (f.guidId === corrente ? ' corrente' : '') + '" data-guid="' + escA(f.guidId) + '" title="' + escA(f.nome) + '">' +
                           '<img src="' + escA(miniatura(f.guidId, 220)) + '" alt="">' + esc(f.nome) +
                           (f.guidId === corrente ? '<br><b>in uso</b>' : '') + '</div>';
                  }).join('');
            gr.querySelectorAll('[data-guid]').forEach(function (el) {
                el.addEventListener('click', function () {
                    if (fotoCorrenti[codice]) fotoCorrenti[codice].guid = el.dataset.guid;
                    ov.classList.remove('visibile');
                    disegnaFoto(id);
                    ombreRitaglio();
                });
            });
        });
    }
    document.getElementById('sfChiudi').addEventListener('click', function () {
        document.getElementById('sceltaFoto').classList.remove('visibile');
    });

    function loghiDelProdotto() {
        var visti = {}, out = [];
        ((schedaFoto && schedaFoto.foto) || []).forEach(function (f) {
            (f.loghi || []).forEach(function (l) { if (!visti[l.guidId]) { visti[l.guidId] = true; out.push(l); } });
        });
        return out;
    }

    function disegnaLoghi(id) {
        var cont = document.getElementById('mLoghi');
        var abil = stato.puoScrivere && puoModificare(id, 'descrizione');
        if (!abil) tabLoghi = 'prodotto';   // all'Agenzia resta solo la linguetta del prodotto (correzioni.js:2834)
        document.getElementById('lingLoghi').classList.toggle('attiva', tabLoghi === 'prodotto');
        document.getElementById('lingStore').classList.toggle('attiva', tabLoghi === 'store');
        document.getElementById('lingStore').style.visibility = abil ? 'visible' : 'hidden';
        // j246: all'Agenzia resterebbe una linguetta sola, e nel vecchio in quel caso non si
        // vedeva nessuna linguetta: si nasconde tutta la barra.
        document.getElementById('lingLoghi').parentNode.style.display = abil ? 'flex' : 'none';
        if (!schedaFoto || schedaFoto.id !== String(id) || schedaFoto.stato === 'carico') { cont.innerHTML = '<span class="vuoto">Carico…</span>'; return; }
        if (schedaFoto.stato === 'errore') { cont.innerHTML = '<span class="vuoto">Loghi non disponibili.</span>'; return; }
        var ed = editDi(id, 'descrizione');
        var confermati = {};
        if (ed && ed.stato === 2) (ed.foto || []).forEach(function (v) { if (v.stato >= 4) confermati[v.guidId] = v.stato; });
        var presenti = loghiDelProdotto();

        if (tabLoghi === 'prodotto') {
            var righe = presenti.map(function (l) {
                var alt = loghiAlterati[l.guidId];
                return rigaLogo(l, alt && alt.stato === 5 ? 'togli' : 'presente', abil, confermati);
            });
            Object.keys(loghiAlterati).forEach(function (k) {
                var a = loghiAlterati[k];
                if (a.stato === 4) righe.push(rigaLogo(a, 'aggiungi', abil, confermati));
            });
            cont.innerHTML = righe.length ? righe.join('') : 'Nessuno';
        } else {
            if (catalogoLoghi === null) {
                cont.innerHTML = '<span class="vuoto">Carico il catalogo…</span>';
                catalogoLoghi = { caricamento: true };
                apiGet('/Correzioni/Loghi').then(function (j) {
                    catalogoLoghi = j.ok ? { lista: j.dati || [] } : { errore: j.messaggio };
                    if (boxInModale && String(boxInModale.id) === String(id)) disegnaLoghi(id);
                });
                return;
            }
            if (catalogoLoghi.caricamento) return;
            if (catalogoLoghi.errore) { cont.innerHTML = '<div class="ea_errore">' + esc(catalogoLoghi.errore) + '</div>'; catalogoLoghi = null; return; }
            var gia = {};
            presenti.forEach(function (l) { gia[l.guidId] = true; });
            Object.keys(loghiAlterati).forEach(function (k) { gia[k] = true; });
            var liberi = catalogoLoghi.lista.filter(function (l) { return !gia[l.guidId]; });
            cont.innerHTML = liberi.length
                ? liberi.map(function (l) { return rigaLogo(l, 'catalogo', abil, confermati); }).join('')
                : 'Tutti i loghi del catalogo sono già sul prodotto.';
        }
        cont.querySelectorAll('[data-logo]').forEach(function (bt) {
            bt.addEventListener('click', function () {
                var g = bt.dataset.logo, az = bt.dataset.azione;
                if (az === 'togli') {
                    var l = presenti.filter(function (x) { return x.guidId === g; })[0];
                    loghiAlterati[g] = { guidId: g, sigla: l ? l.sigla : '', nome: l ? l.nome : '', stato: 5 };
                } else if (az === 'aggiungi') {
                    var c = catalogoLoghi.lista.filter(function (x) { return x.guidId === g; })[0];
                    loghiAlterati[g] = { guidId: g, sigla: c ? c.sigla : '', nome: c ? c.nome : '', stato: 4 };
                    tabLoghi = 'prodotto';
                } else {
                    delete loghiAlterati[g];
                }
                disegnaLoghi(id);
                ombreRitaglio();
            });
        });
    }

    function rigaLogo(l, modo, abil, confermati) {
        // modo: presente | togli (da togliere) | aggiungi (da aggiungere) | catalogo
        var cls = modo === 'togli' ? ' uscente' : (modo === 'aggiungi' ? ' entrante' : '');
        if (modo === 'togli' || modo === 'aggiungi')
            cls += confermati[l.guidId] === (modo === 'togli' ? 5 : 4) ? ' borderFixed' : ' borderFix';
        var nota = modo === 'togli' ? 'da togliere' : (modo === 'aggiungi' ? 'da aggiungere' : (l.automatico ? 'automatico' : ''));
        var bottone = '';
        if (abil) {
            if (modo === 'presente') bottone = '<button type="button" class="bottone" data-logo="' + escA(l.guidId) + '" data-azione="togli">Togli</button>';
            else if (modo === 'catalogo') bottone = '<button type="button" class="bottone" data-logo="' + escA(l.guidId) + '" data-azione="aggiungi">Aggiungi</button>';
            else bottone = '<button type="button" class="bottone" data-logo="' + escA(l.guidId) + '" data-azione="ripristina" title="Annulla questa modifica">&#8630;</button>';
        }
        return '<div class="riga_logo' + cls + '"><img src="' + escA(miniatura(l.guidId, 60)) + '" alt="">' +
               '<div class="nome">' + esc(l.sigla || l.nome) + (l.nome && l.sigla ? '<small>' + esc(l.nome) + '</small>' : '') +
               (nota ? '<small>' + nota + '</small>' : '') + '</div>' + bottone + '</div>';
    }
    document.getElementById('lingLoghi').addEventListener('click', function () {
        if (!boxInModale) return; tabLoghi = 'prodotto'; disegnaLoghi(boxInModale.id);
    });
    document.getElementById('lingStore').addEventListener('click', function () {
        if (!boxInModale) return; tabLoghi = 'store'; disegnaLoghi(boxInModale.id);
    });

    function raccogliScheda() {
        var d = document.getElementById('mDescrizione');
        var corpo = { testo: d.classList.contains('descr_edit') ? componiDescrizione() : null, foto: null, loghi: null };
        if (schedaFoto && boxInModale && schedaFoto.id === String(boxInModale.id) && schedaFoto.stato === 'ok') {
            corpo.foto = schedaFoto.foto.filter(function (f) {
                var c = fotoCorrenti[f.codice];
                return c && (c.guid !== f.guidFoto || c.stato !== statoIstanta(f));
            }).map(function (f) {
                return { codice: f.codice, guidId: fotoCorrenti[f.codice].guid, stato: fotoCorrenti[f.codice].stato };
            });
            corpo.loghi = Object.keys(loghiAlterati).map(function (k) { return { guidId: k, stato: loghiAlterati[k].stato }; });
        }
        return corpo;
    }

    /* ---------- ombre nel ritaglio ---------- */
    function ombreRitaglio() {
        var cont = document.getElementById('mRitaglio');
        cont.querySelectorAll('.spaceShadow').forEach(function (x) { x.remove(); });
        if (!boxInModale) return;
        var b = dati[boxInModale.id];
        if (!b || !b.pw || !b.ph || !b.figli) return;
        var lc = cont.clientWidth, hc = cont.clientHeight, sc = Math.min(lc / b.pw, hc / b.ph);
        var ox = (lc - b.pw * sc) / 2, oy = (hc - b.ph * sc) / 2;
        var colore = {};
        document.querySelectorAll('#mCampi [data-field]').forEach(function (e) {
            var c = e.classList.contains('borderFix') ? 'red' : (e.classList.contains('borderFixed') ? 'green' : null);
            if (!c) return;
            (b.schema || []).forEach(function (a) {
                if (a.label && a.label !== 'base' && a.istruzioni.some(function (i) { return i.field === e.dataset.field; }) &&
                    colore[a.label] !== 'red') colore[a.label] = c;
            });
        });
        var d = document.getElementById('mDescrizione');
        if (d.classList.contains('borderFix')) colore.descrizione = 'red';
        else if (d.classList.contains('borderFixed')) colore.descrizione = 'green';
        // checkFixSuFotoE_P_S (correzioni.js:4360): rossa se foto o loghi cambiati, verde se confermati
        if (document.querySelector('#mFoto .borderFix, #mLoghi .borderFix')) colore.immagine = 'red';
        else if (document.querySelector('#mFoto .borderFixed, #mLoghi .borderFixed')) colore.immagine = 'green';
        Object.keys(colore).forEach(function (lab) {
            var f = b.figli[lab]; if (!f) return;
            var o = document.createElement('div');
            o.className = 'spaceShadow';
            o.style.background = colore[lab];
            o.style.left = (ox + (f[0] - b.px) * sc) + 'px';
            o.style.top = (oy + (f[1] - b.py) * sc) + 'px';
            o.style.width = Math.max(f[2] * sc, 3) + 'px';
            o.style.height = Math.max(f[3] * sc, 3) + 'px';
            cont.appendChild(o);
        });
    }

    /* ---------- REPORT CORREZIONI (j214): reports.js dell'originale ---------- */
    // Il bottone apre la finestra sulla versione aperta; OK/VISTO e TOTALE ricaricano; la stampante apre
    // la pagina stampabile. L'icona sul prodotto apre lo "Storico correzioni sulla referenza".
    var repVelo = document.getElementById('reportVelo');
    var repFinestra = document.getElementById('reportFinestra');
    var repOk = document.getElementById('rOkVisto'), repTot = document.getElementById('rTotale');
    var repBox = null;        // null = tutto il volantino; id del box = storico del prodotto
    var repRichiesta = 0;
    var ID_VOL = document.getElementById('tReport').dataset.idVol;

    function caricaReport() {
        var base = '/Storico/Report/' + ID_VOL + '/' + stato.versione;
        var q = repBox ? 'box=' + encodeURIComponent(repBox) : 'tutte=' + repTot.checked + '&ok=' + repOk.checked;
        document.getElementById('rStampa').href = base + '?tutte=' + repTot.checked + '&ok=' + repOk.checked;
        repOk.disabled = repTot.disabled = true;
        repFinestra.innerHTML = '<div class="rp_vuoto">Caricamento…</div>';
        var mia = ++repRichiesta;
        fetch(base + '?incorporato=true&' + q, { credentials: 'same-origin' })
            .then(function (r) { if (!r.ok || r.redirected) throw new Error(String(r.status)); return r.text(); })
            .then(function (h) { if (mia === repRichiesta) repFinestra.innerHTML = h; })
            .catch(function () {
                if (mia === repRichiesta) repFinestra.innerHTML = '<div class="rp_vuoto">Il report non si è potuto caricare. Riprova.</div>';
            })
            .then(function () { repOk.disabled = repTot.disabled = false; });
    }
    function apriReport(idBox) {
        chiudiPop();
        repBox = idBox || null;
        document.getElementById('reportScelte').classList.toggle('nascosto', !!repBox);
        repVelo.classList.add('visibile');
        repFinestra.scrollTop = 0;
        caricaReport();
    }
    function chiudiReport() {
        repVelo.classList.remove('visibile');
        repFinestra.innerHTML = '';
        repTot.checked = false;   // come reports.abilitaReport: chiudendo si toglie TOTALE
    }
    document.getElementById('tReport').addEventListener('click', function () {
        if (repVelo.classList.contains('visibile')) chiudiReport(); else apriReport(null);
    });
    document.getElementById('rChiudi').addEventListener('click', chiudiReport);
    repOk.addEventListener('change', caricaReport);
    repTot.addEventListener('change', caricaReport);
    repVelo.addEventListener('click', function (ev) { if (ev.target === repVelo) chiudiReport(); });

    // Icona dello storico (getPageRefsStorico + showIconeHasStorico): sui prodotti con correzioni in questa o in
    // altre versioni. L'Agenzia la vede sempre (stato_utente 2); chi scrive con il cassetto note o icone aperto.
    function chiaveBox(id) { var b = dati[String(id)]; return b && b.basecode ? 'c:' + b.basecode : 'b:' + id; }
    function disegnaStorico() {
        document.querySelectorAll('.ico_storico').forEach(function (e) { e.remove(); });
        var cassettoAperto = document.querySelector('#flyNote.aperto, #flyTimbri.aperto');
        if (stato.tipoUtente !== 'Agenzia' && !cassettoAperto) return;
        var con = {};
        (stato.basecodeStorico || []).forEach(function (bc) { con['c:' + bc] = true; });
        stato.note.concat(stato.timbri, stato.edit || []).forEach(function (c) { if (c.idBox) con[chiaveBox(c.idBox)] = true; });
        document.querySelectorAll('.foglio .zona').forEach(function (z) {
            var id = z.dataset.box, b = dati[id];
            if (!b || !con[chiaveBox(id)]) return;
            var im = document.createElement('img');
            im.className = 'ico_storico';
            im.src = IMG + 'notificaoff.png';
            im.alt = 'Storico';
            im.title = 'Storico correzioni del prodotto';
            im.dataset.box = id;
            im.style.left = perc(b.px, b.pagW);
            im.style.top = perc(b.py + b.ph, b.pagH);
            im.addEventListener('click', function (ev) { ev.stopPropagation(); apriReport(id); });
            z.parentNode.appendChild(im);
        });
    }

    /* ---------- la finestra dei gemelli (j223): #propagazione dell'originale ---------- */
    var catVelo = document.getElementById('catVelo');
    var catFinestra = document.getElementById('catFinestra');
    var catCatena = null;      // la catena aperta adesso
    var catTimer = null;       // ricarica mentre il demone sta ancora lavorando

    function apriCatena(id) {
        chiudiPop();
        catCatena = null;
        catVelo.classList.add('visibile');
        catFinestra.innerHTML = '<div class="cat_vuoto">Carico la propagazione…</div>';
        // j246: titolo e conteggi non si scrivono piu' (vedi il markup di #catTitolo)
        document.getElementById('catSel').classList.add('nascosto');
        document.getElementById('catTutti').classList.add('nascosto');
        document.getElementById('catElimina').classList.add('nascosto');
        caricaCatena(id);
    }

    function chiudiCatena() {
        catVelo.classList.remove('visibile');
        catFinestra.innerHTML = '';
        catCatena = null;
        if (catTimer) { clearInterval(catTimer); catTimer = null; }
    }

    function caricaCatena(id) {
        apiGet('/Correzioni/Propagazione/' + id).then(function (j) {
            if (!catVelo.classList.contains('visibile')) return;
            if (!j.ok) { catFinestra.innerHTML = '<div class="cat_vuoto">' + esc(j.messaggio || 'Propagazione non disponibile.') + '</div>'; return; }
            catCatena = j.dati;
            disegnaCatena();
            // mentre il demone lavora la finestra si ricarica da sola, come il polling dell'originale
            if (catCatena.inCostruzione && !catTimer) {
                catTimer = setInterval(function () { if (catCatena) caricaCatena(catCatena.id); }, 5000);
            } else if (!catCatena.inCostruzione && catTimer) {
                clearInterval(catTimer); catTimer = null;
            }
        });
    }

    function badgeScadenza(g) {
        if (g < 0) return '<span class="cat_scad chiuso">VOL CHIUSO</span>';
        if (g <= 2) return '<span class="cat_scad">IN CHIUSURA</span>';
        return '';
    }

    /* chi ha confermato una riga e quando (j224) */
    function chiHaConfermato(r) {
        if (r.stato !== 1) return '';
        return '<span class="cat_chi">' + (r.correttore ? 'fatta da ' + esc(r.correttore) : 'fatta') +
               (r.dataCorrezione ? ' il ' + esc(dataBreve(r.dataCorrezione)) : '') + '</span>';
    }

    /* la spunta verde dell'Agenzia: conferma l'attuazione di quella riga (done.png dell'originale) */
    function spuntaConferma(chiave, valore, titolo, classi) {
        return '<img class="cat_conferma' + (classi ? ' ' + classi : '') + '" src="' + escA(IMG + 'done.png') +
               '" alt="conferma" title="' + escA(titolo) + '" data-' + chiave + '="' + valore + '">';
    }

    /* j232: il ritaglio del prodotto di una riga. Il contenitore porta la geometria negli attributi
       e l'immagine la posiziona disegnaRitagli() quando la finestra e' in pagina (serve la misura
       vera del contenitore). */
    function cellaRitaglio(r, grande) {
        if (!r.urlPagina || !r.pw || !r.ph) return '<div class="cat_rit' + (grande ? ' grande' : '') + '"></div>';
        return '<div class="cat_rit' + (grande ? ' grande' : '') + '" data-url="' + escA(r.urlPagina) +
               '" data-px="' + r.px + '" data-py="' + r.py + '" data-pw="' + r.pw + '" data-ph="' + r.ph +
               '" data-pagw="' + r.pagW + '" data-pagh="' + r.pagH + '"></div>';
    }

    function disegnaRitagli() {
        catFinestra.querySelectorAll('.cat_rit[data-url]').forEach(function (c) {
            var pw = parseFloat(c.dataset.pw), ph = parseFloat(c.dataset.ph),
                pagw = parseFloat(c.dataset.pagw), pagh = parseFloat(c.dataset.pagh),
                px = parseFloat(c.dataset.px), py = parseFloat(c.dataset.py);
            if (!pw || !ph || !pagw || !pagh) return;
            var lc = c.clientWidth, hc = c.clientHeight;
            var s = Math.min(lc / pw, hc / ph);
            var im = document.createElement('img');
            im.src = c.dataset.url;
            im.alt = '';
            im.style.width = (pagw * s) + 'px';
            im.style.height = (pagh * s) + 'px';
            im.style.left = (-px * s + (lc - pw * s) / 2) + 'px';
            im.style.top = (-py * s + (hc - ph * s) / 2) + 'px';
            c.appendChild(im);
        });
    }

    /* i codici radice del gruppo, spaziati come nel vecchio */
    function codiciGruppo(r) { return esc((r.codici || '').split(',').join(', ')); }

    /* j232: «Origine della propagazione», il riquadro nero del vecchio: data e autore con la spunta
       grande, il volantino incolonnato, il ritaglio del prodotto, il testo della correzione e i
       codici radice del gruppo. */
    function rigaPilota(p, c) {
        var testa = '<div class="cat_fascia">Origine della propagazione:' +
                    '<span class="dx">Codici radice che compongono il gruppo:</span></div>';
        if (!p) return testa;
        var azione = '';
        if (c.puoConfermare && p.puoConfermare) {
            azione = spuntaConferma('confpilota', c.id, 'Conferma la correzione di partenza', 'grande') +
                     '<label class="cat_seletta"><input type="checkbox" class="cat_sel" id="catSelPilota"> seleziona</label>';
        } else if (p.stato === 1) {
            azione = '<div class="cat_seletta">' + chiHaConfermato(p) + '</div>';
        }
        return testa + '<div class="cat_pilota"><table class="cat_orig"><tr>' +
               '<td class="cat_col_orig">' + esc(dataBreve(c.data)) + '<br><b>' + esc(c.autore) + '</b>' +
               badgeTipo(c.tipoAutore) + azione + '</td>' +
               '<td class="cat_col_vol"><span class="cat_promo">' + esc(p.promo) + '</span><br><b>' +
               esc(p.volantino) + '</b><br>Pag. ' + p.pagina + '<br>Versione ' + p.versione + ' ' +
               badgeScadenza(p.giorniAllaScadenza) + '</td>' +
               '<td>' + cellaRitaglio(p, true) + '</td>' +
               '<td>' + (c.tipo === 'timbro' ? '<img class="cat_timbro" src="' + escA(IMG + c.simbolo + '.png') + '" alt="">' : '') +
               '<span style="white-space:pre-wrap"><b>' + esc(c.testo) + '</b></span>' +
               '<div class="cat_prodotto">' + esc(p.etichetta) + '</div></td>' +
               '<td class="cat_codici">' + codiciGruppo(p) + '</td>' +
               '</tr></table></div>';
    }

    /* la domanda dell'originale, la stessa della spunta rossa nell'editor */
    var DOMANDA_CONFERMA = 'Sicuro di voler confermare l\'attuazione della correzione?';
    /* la domanda dell'originale (correzioni.js:5507) sull'ELIMINA DEFINITIVAMENTE */
    var DOMANDA_ELIMINA = 'Sicuro di voler eliminare l\'intera propagazione?';

    function conferma(selezionati, ancheIlPilota) {
        return api('/Correzioni/Propagazione/' + catCatena.id + '/Conferma',
                   { selezionati: selezionati, ancheIlPilota: !!ancheIlPilota })
            .then(function (j) {
                if (!j.ok) suggerisci(j.messaggio || 'Non si e\' potuto confermare.', 7000);
                else if (j.dati && j.dati.motivo) suggerisci(j.dati.confermati + ' confermate, ' + j.dati.saltati + ' saltate (' + j.dati.motivo + ').', 7000);
                if (catCatena) caricaCatena(catCatena.id);
                aggiornaStato();
            });
    }

    function disegnaCatena() {
        var c = catCatena;
        if (!c) return;
        /* j246: DEPRECATO, non si scrive piu' niente in cima alla finestra.
           Prima qui si scrivevano il tipo della propagazione ("Propagazione: nota") e i conteggi
           ("3 gemelli · 1 attivati · 0 fatti · 0%"). Michele li ha chiesti via: nel vecchio non
           c'erano, e i numeri si leggono comunque riga per riga nella colonna dello stato.
           Riattivandoli tornerebbero le due scritte nella barra dei bottoni. */

        // ---- j230: «ELIMINA DEFINITIVAMENTE» (Main.aspx:501): questa correzione non si propaga.
        // Solo per chi scrive, a catena costruita e finche' nessuno ha eseguito niente: il server
        // ricontrolla tutto. La correzione resta, sparisce solo la propagazione.
        var be = document.getElementById('catElimina');
        be.classList.toggle('nascosto', !c.puoEliminare);
        be.disabled = false;
        be.onclick = function () {
            if (!confirm(DOMANDA_ELIMINA)) return;
            be.disabled = true;
            api('/Correzioni/Propagazione/' + c.id + '/Elimina', {}).then(function (j) {
                if (!j.ok) {
                    be.disabled = false;
                    suggerisci(j.messaggio || 'Non si e\' potuto eliminare la propagazione.', 7000);
                    caricaCatena(c.id);
                    return;
                }
                chiudiCatena();
                suggerisci('Propagazione eliminata: la correzione resta solo su questo volantino.', 6000);
                aggiornaStato();
            });
        };

        var html = rigaPilota(c.pilota, c);
        if (c.inCostruzione) {
            html += '<div class="cat_barra">Proposte di propagazioni:</div>' +
                    '<div class="cat_vuoto">Analisi di propagazione in corso… la finestra si aggiorna da sola.</div>';
        } else if (c.propagati.length === 0) {
            html += '<div class="cat_barra">Proposte di propagazioni:</div>' +
                    '<div class="cat_vuoto">Nessuna proposta: questo prodotto non compare su altri volantini aperti.</div>';
        } else {
            html += '<div class="cat_barra">Proposte di propagazioni:</div>' +
                    '<table class="cat_tab">' +
                    c.propagati.map(function (r, i) {
                        var cella;
                        if (c.puoConfermare) {
                            // Agenzia (j224): spunta verde per riga e casella di selezione
                            if (r.stato === 1) cella = '';
                            else if (r.bloccato) cella = '<img class="cat_lucchetto" src="' + escA(IMG + 'locked.png') +
                                                         '" alt="" title="Bloccato in ripubblicazione">';
                            else if (r.puoConfermare) cella = '<input type="checkbox" class="cat_sel" data-sel="' + r.id + '">' +
                                                              spuntaConferma('conf', r.id, 'Conferma l\'attuazione');
                            // j232: lo stato ha la sua colonna a sinistra, qui non si ripete
                            else cella = '';
                        }
                        else if (!c.puoAttivare) cella = '';
                        else if (r.bloccato) cella = '<img class="cat_lucchetto" src="' + escA(IMG + 'locked.png') +
                                                     '" alt="" title="Bloccato in ripubblicazione">';
                        else if (r.stato === 1) cella = '<b>fatta</b>';
                        else cella = '<input type="checkbox" class="cat_spunta" data-prop="' + r.id + '"' + (r.attivo ? ' checked' : '') + '>';
                        return '<tr class="' + (i % 2 ? 'zebra' : '') + (r.versioneSuperata ? ' superata' : '') + '">' +
                               '<td class="cat_col_stato"><span class="cat_stato ' +
                               (r.stato === 1 ? 'fatta' : (r.attivo ? 'dafare' : '')) + '">' + esc(r.statoTesto) + '</span>' +
                               (r.stato === 1 ? '<br>' + chiHaConfermato(r) : '') + '</td>' +
                               '<td class="cat_col_azione">' + cella + '</td>' +
                               '<td class="cat_col_vol"><span class="cat_promo">' + esc(r.promo) + '</span><br><b class="cat_vol">' +
                               esc(r.volantino) + '</b><br>Pag. ' + r.pagina + '<br>Versione ' + r.versione + ' ' +
                               badgeScadenza(r.giorniAllaScadenza) +
                               (r.versioneSuperata ? '<br><b>VERSIONE SUPERATA</b>' : '') + '</td>' +
                               '<td><div class="cat_prodotto">' + esc(r.etichetta) + '</div></td>' +
                               '<td>' + cellaRitaglio(r, false) + '</td>' +
                               '<td class="cat_codici">' + codiciGruppo(r) + '</td></tr>';
                    }).join('') + '</table>';
        }
        // «Aggiorna lista propagazione» del vecchio (Main.aspx:576): ricarica senza chiudere
        html += '<div class="cat_fondo"><button type="button" class="cat_bott" id="catAggiorna">' +
                'Aggiorna lista propagazione</button></div>';
        catFinestra.innerHTML = html;
        disegnaRitagli();
        var ba = document.getElementById('catAggiorna');
        if (ba) ba.onclick = function () { ba.disabled = true; caricaCatena(c.id); aggiornaStato(); };

        catFinestra.querySelectorAll('[data-prop]').forEach(function (cb) {
            cb.addEventListener('change', function () {
                cb.disabled = true;
                api('/Correzioni/Propagazione/Elemento/' + cb.dataset.prop + '/Attiva', { attiva: cb.checked })
                    .then(function (j) {
                        if (!j.ok) { suggerisci(j.messaggio || 'Non si e\' potuto cambiare.', 6000); }
                        caricaCatena(c.id);
                        aggiornaStato();
                    });
            });
        });

        // ---- Agenzia (j224): spunta per riga, selezione, "Conferma selezione" e "Conferma tutti"
        catFinestra.querySelectorAll('[data-conf]').forEach(function (im) {
            im.addEventListener('click', function () {
                if (!confirm(DOMANDA_CONFERMA)) return;
                im.style.pointerEvents = 'none';
                conferma([Number(im.dataset.conf)], false);
            });
        });
        var pil = catFinestra.querySelector('[data-confpilota]');
        if (pil) pil.addEventListener('click', function () {
            if (!confirm(DOMANDA_CONFERMA)) return;
            pil.style.pointerEvents = 'none';
            conferma([], true);
        });

        var confermabili = c.propagati.filter(function (r) { return r.puoConfermare; }).map(function (r) { return r.id; });
        var pilotaDaConfermare = !!(c.pilota && c.pilota.puoConfermare);

        var bs = document.getElementById('catSel');
        bs.classList.toggle('nascosto', !c.puoConfermare || (confermabili.length === 0 && !pilotaDaConfermare));
        bs.disabled = true;
        function aggiornaSelezione() {
            var quante = catFinestra.querySelectorAll('.cat_sel:checked').length;
            bs.disabled = quante === 0;
            bs.textContent = quante > 1 ? 'Conferma le ' + quante + ' selezionate' : 'Conferma selezione';
        }
        catFinestra.querySelectorAll('.cat_sel').forEach(function (cb) {
            cb.addEventListener('change', aggiornaSelezione);
        });
        aggiornaSelezione();
        bs.onclick = function () {
            var scelte = [], pilota = false;
            catFinestra.querySelectorAll('.cat_sel:checked').forEach(function (cb) {
                if (cb.id === 'catSelPilota') pilota = true; else scelte.push(Number(cb.dataset.sel));
            });
            if (scelte.length === 0 && !pilota) return;
            if (!confirm(DOMANDA_CONFERMA)) return;
            bs.disabled = true;
            conferma(scelte, pilota);
        };

        // "Attiva su tutti" / "Disattiva su tutti" per chi scrive, "Conferma tutti" per l'Agenzia
        var bt = document.getElementById('catTutti');
        var attivabili = c.propagati.filter(function (r) { return !r.attivo && !r.bloccato && r.stato !== 1; }).length;
        var disattivabili = c.propagati.filter(function (r) { return r.attivo && !r.bloccato && r.stato !== 1; }).length;
        bt.disabled = false;
        if (c.puoConfermare) {
            // regola dell'originale (correzioni.js:4959-4979): con una cosa sola da confermare
            // il bottone massivo non serve, basta la spunta della riga
            bt.classList.toggle('nascosto', confermabili.length + (pilotaDaConfermare ? 1 : 0) <= 1);
            bt.textContent = 'Conferma tutti';
            bt.onclick = function () {
                if (c.promoDiverse &&
                    !confirm('ATTENZIONE, ci sono propagazioni appartenenti a promo diverse. Confermo comunque tutto?')) return;
                if (!c.promoDiverse && !confirm(DOMANDA_CONFERMA)) return;
                bt.disabled = true;
                conferma(confermabili, pilotaDaConfermare);
            };
            return;
        }
        bt.classList.toggle('nascosto', !c.puoAttivare || (attivabili === 0 && disattivabili === 0));
        bt.textContent = attivabili > 0 ? 'Attiva su tutti' : 'Disattiva su tutti';
        bt.onclick = function () {
            var attiva = attivabili > 0;
            if (attiva && c.promoDiverse &&
                !confirm('ATTENZIONE, ci sono propagazioni appartenenti a promo diverse. Attivo comunque su tutti?')) return;
            bt.disabled = true;
            api('/Correzioni/Propagazione/' + c.id + '/AttivaTutti', { attiva: attiva }).then(function (j) {
                if (!j.ok) suggerisci(j.messaggio || 'Non si e\' potuto cambiare.', 6000);
                else if (j.dati && j.dati.saltati > 0) suggerisci(j.dati.cambiati + ' cambiati, ' + j.dati.saltati + ' saltati (bloccati o già fatti).', 6000);
                caricaCatena(c.id);
                aggiornaStato();
            });
        };
    }

    document.getElementById('catChiudi').addEventListener('click', chiudiCatena);
    catVelo.addEventListener('click', function (ev) { if (ev.target === catVelo) chiudiCatena(); });

    /* Ricarica lo stato delle correzioni senza ricaricare la pagina: serve dopo un'attivazione e
       mentre il demone costruisce le catene (il megafono passa da "in costruzione" a lampeggiante). */
    function aggiornaStato() {
        return apiGet('/Correzioni/Stato/' + ID_VOL).then(function (j) {
            if (j.ok && j.dati && j.dati.stato) { stato = j.dati.stato; aggiornaScarto(); disegna(); }
        });
    }

    var timerCostruzione = null;
    function seguiCostruzione() {
        var inCorso = stato.note.concat(stato.timbri).some(function (c) {
            return c.propagazione && c.propagazione.inCostruzione;
        });
        if (inCorso && !timerCostruzione) timerCostruzione = setInterval(aggiornaStato, 5000);
        else if (!inCorso && timerCostruzione) { clearInterval(timerCostruzione); timerCostruzione = null; }
    }

    // strumenti di scrittura solo per Category e Marketing (il server rifiuterebbe comunque).
    // j244 (Michele, 16/9): all'Agenzia non deve comparire nemmeno il bottone del cassetto
    // "NOTE" (tNote). Dentro c'era solo Edit avanzato, ed era anche l'unico modo per aprire un
    // prodotto: da adesso l'Agenzia non apre piu' il modale dell'Edit avanzato e non lo conferma
    // piu' da qui. Conseguenza dichiarata e accettata; dove confermarlo e' una decisione aperta.
    // Accettare note e timbri con la spunta continua a funzionare: non passa dagli strumenti.
    if (!stato.puoScrivere) {
        ['tNote', 'tTimbri', 'tOk', 'strNota'].forEach(function (id) { document.getElementById(id).classList.add('nascosto'); });
    }
    disegna();

    // j236: la policy dei prodotti si legge all'apertura, per chi scrive (l'Agenzia non ha limiti).
    // Sta qui, in coda all'avvio, perche' prima `stato` non e' ancora stato letto.
    if (stato.puoScrivere) {
        caricaPolicy().then(function (d) {
            if (!d || !d.conPolicy) return;
            applicaBoxFuoriPolicy();
            applicaTimbriEsclusi(d.timbriEsclusi);
        });
    }

    applicaZoom(48);

    /* barra strumenti ferma (j215) */
    var barra = document.querySelector('.barra'), barraDentro = document.getElementById('barraDentro');
    function adattaBarra() {
        barraDentro.style.transform = ''; barraDentro.style.marginBottom = '';
        var disponibile = barra.clientHeight - 10, serve = barraDentro.scrollHeight;
        var scala = serve > disponibile ? Math.max(0.5, disponibile / serve) : 1;
        barraDentro.style.transform = scala < 1 ? 'scale(' + scala.toFixed(3) + ')' : '';
        // lo spazio tolto dalla scala si toglie anche dall'impaginazione, cosi' non resta niente da scorrere
        barraDentro.style.marginBottom = scala < 1 ? -Math.ceil(serve * (1 - scala)) + 'px' : '';
        barra.scrollTop = 0; barra.scrollLeft = 0;
    }
    window.addEventListener('resize', adattaBarra);
    window.addEventListener('load', adattaBarra);
    adattaBarra();

    /* ---------- IL GANCIO PER IL TIMONE (j286) ----------
       Michele, 29/09: «un bottone vicino al cestino, con una matita come icona, che sta a
       significare modifica referenza. Se ci cliccano dovranno vedere la stessa cosa che di solito
       vedono in edit avanzato e poter fare le stesse identiche cose: modificare prezzi, foto,
       loghi, azioni.»

       Tutto questo script sta dentro un involucro `(function () { ... })()` e wwwroot/js/timone.js
       viene caricato subito dopo, fuori da qui: da li' apri() non si vede nemmeno. Quindi la
       scheda non si rifa' - sarebbe la stessa roba scritta due volte, e due volte da mantenere -
       ma si espone l'unica porta che serve per aprirla.

       Questo blocco e' SOLO ADDITIVO: non cambia niente di quello che c'e' sopra. Chi legge in
       futuro: se lo togli, la matita del timone dice «scheda non disponibile» e basta, il resto
       dell'editor continua a funzionare come prima.

       I permessi NON li decide il timone. Li decide la scheda, che li ha giusti da j200/j206:
       piedeEdit() mostra SALVA e ANNULLA a chi scrive le correzioni (Category e Marketing) e
       CONFERMA all'Agenzia, e il server rifiuta comunque il resto. Il Category il timone non lo
       vede nemmeno (403). Nota storica: con j244 all'Agenzia e' stato tolto il cassetto NOTE, che
       era anche l'unico modo di aprire un prodotto, e li' era rimasta aperta la domanda «dove la
       conferma l'Agenzia». La matita del timone e' la risposta. */
    window.correggo4 = window.correggo4 || {};

    /* j308: IL TIMONE DEVE POTER DIRE ALL'EDITOR «RIFATTI DARE LO STATO».
       Michele, 29/09: «ho provato a invertire due box e salvare, ma appena uscita dal timone non
       vedo nessuna schermata con quello che ti ho chiesto». Il velo delle pagine in attesa lo
       disegna disegna(), che legge stato.pagineDaSistemare; ma quell'elenco arriva col resto dello
       stato quando si apre la pagina, e il salvataggio del timone non lo cambia. Quindi il server
       sapeva benissimo che la pagina 1 era in attesa - lo diceva - e l'editor continuava a leggere
       la fotografia di prima: il velo si vedeva solo ricaricando a mano.
       Da qui il timone chiama questa, e l'editor si rifa' dare lo stato vero. */
    window.correggo4.ricaricaStato = function () {
        try { return aggiornaStato(); } catch (e) { return null; }
    };

    window.correggo4.schedaBox = {
        apri: function (idBox) {
            var k = String(idBox);
            if (!dati[k]) return 'box_sconosciuto';
            if (fuoriPolicy(k)) return 'fuori_policy';
            apri(k);
            return 'ok';
        },
        chiudi: chiudiModale,
        aperta: function () { return modale.classList.contains('visibile'); }
    };
})();
</script>
@* La versione nell'indirizzo serve a una cosa sola: fare in modo che il browser si accorga che
   il file e' cambiato. Era rimasta a j286 mentre il timone e' andato avanti fino a j306, e con una
   copia vecchia in cache si vedono cose che sul server non ci sono piu' - e' il genere di dubbio
   che fa perdere mezz'ora a tutti e due. Va cambiata ogni volta che si cambia timone.js. *@
<script src="/js/timone.js?v=j328"></script>
</body>
</html>
