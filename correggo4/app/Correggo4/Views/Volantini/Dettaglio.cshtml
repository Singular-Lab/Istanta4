    /* ---------- cassetto pagine ---------- */
    .pannello_pagine {
        position: fixed; right: 10px; top: 90px; width: 300px; height: 85%;
        background-color: aliceblue; border: 2px solid black; z-index: 98;
        display: flex; flex-direction: column;
    }
    /* testata nera a tre zone: libro a sinistra, interruttore al centro, CHIUDI a destra */
    .pannello_pagine .testa {
        width: 100%; background-color: black; height: 37px; flex: 0 0 37px;
        display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    }
    .pannello_pagine .testa .sx { display: flex; align-items: center; padding-left: 6px; }
    .pannello_pagine .testa .sx img { height: 24px; width: auto; display: block; cursor: pointer; }
    .pannello_pagine .testa .centro { display: flex; align-items: center; justify-content: center; }
    .pannello_pagine .testa .dx { text-align: right; }
    /* interruttore "solo pagine correggibili". toggle_policypag.png e' 100x80 con la pillola
       in x 6..95, y 21..57 (36px): scalata a 26px d'altezza (x0,722) e ritagliata sulla pillola,
       cosi' il bottone e' grande quanto la pillola e si centra davvero nella barra.
       Prima era un bottone 78x60 con margin-top:-13px e il rullino posizionato a occhio:
       la pillola usciva sopra la barra. */
    .interruttore_pag {
        position: relative; display: block; width: 64px; height: 26px; padding: 0; border: 0;
        cursor: pointer; background: transparent url('@img/toggle_policypag.png') no-repeat;
        background-size: 72px 58px; background-position: -4px -15px;
    }
    .interruttore_pag .rullino_pag {
        position: absolute; left: 2px; top: 50%; width: 22px; height: auto;
        transform: translateY(-50%); pointer-events: none; transition: left .18s;
    }
    /* j235: acceso = filtro attivo, e il pallino va a destra come nell'originale
       (tool.js:637-652 lo animava da 19px a 57px su un bottone da 78px). */
    .interruttore_pag:not(.spento) .rullino_pag { left: 40px; }
    /* pagine dove non hai prodotti tuoi: sbiadite e non cliccabili (tool.js:686-700) */
    .pannello_pagine .cella.fuori_policy { opacity: .3; pointer-events: none; }
    /* j236: prodotti che la tua policy non copre. L'originale li disegnava neri al 40% e li
       marcava restricted="true" (page.js:159-163): si vede a colpo d'occhio cosa non e' tuo, e
       il clic non apre niente. Il clic resta sulla zona (non pointer-events:none) perche' il
       messaggio lo dà lei: cosi' non finisce sul foglio e non nasce una nota lì sotto. */
    .zona.fuori_policy, body.modo_edit .zona.fuori_policy {
        background-color: #000; opacity: .4; box-shadow: none; cursor: not-allowed;
    }
    /* j307: LA PAGINA IN ATTESA CHE L'AGENZIA SISTEMI L'IMPAGINATO.
       Michele, 29/09: «dovra' essere tutto oscurato con la scritta "In attesa che l'Agenzia sistemi
       l'impaginato."». Il velo copre il foglio per intero e si prende i clic: non serve spegnere
       un pulsante alla volta, sotto non ci si arriva. Il server rifiuta comunque (attesa_impaginato),
       perche' un blocco che vive solo qui non e' un blocco.
       COL TIMONE APERTO IL VELO SPARISCE DA SE', e non e' un caso: la regola del timone
       (body.tim_on .foglio > *:not(img):not(.tim_casella)...) porta all'opacita' 5% e toglie i clic
       a tutto quello che sta nel foglio e non e' del timone - quindi anche a questo velo. Ed e'
       esattamente quello che serve: «il marketing a quel punto potra' solo ed esclusivamente
       utilizzare il timone». Se un domani si aggiungesse .attesa_agenzia a quella lista di
       eccezioni, il velo resterebbe sopra il timone e il timone non si potrebbe usare. */
    .foglio .attesa_agenzia {
        position: absolute; inset: 0; z-index: 90; background: rgba(14, 20, 24, 0.82);
        display: flex; align-items: center; justify-content: center; cursor: not-allowed;
    }
    .foglio .attesa_agenzia span {
        background: #7a1e2d; color: #fff; font-size: 15px; font-weight: bold; text-align: center;
        padding: 10px 18px; border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.5);
        max-width: 80%;
    }
    /* nel pannello delle pagine si vede quali aspettano: serve anche all'Agenzia, che il velo non
       ce l'ha e deve sapere dove mettere le mani */
    .pannello_pagine .cella.attesa { outline: 3px solid #7a1e2d; outline-offset: -3px; }

    .pannello_pagine .testa .dx a {
        cursor: pointer; color: #fff; margin-right: 10px; font-family: inherit; font-size: 13px;
    }
    /* j240: la linguetta per riaprire il pannello delle pagine. Il vecchio aveva solo l'icona
       pages.png in alto a destra (Main.aspx:381) e chiuso il cassetto non si capiva come tornare:
       Michele ha chiesto una freccetta a destra, a mezza altezza. Compare solo a pannello chiuso. */
    .riapri_pagine {
        position: fixed; right: 0; top: 50%; transform: translateY(-50%); z-index: 97;
        width: 28px; height: 78px; padding: 0; cursor: pointer; font-family: inherit;
        background: aliceblue; color: #1d5b55; font-size: 30px; font-weight: bold; line-height: 74px;
        border: 2px solid #000; border-right: 0; border-radius: 9px 0 0 9px;
        box-shadow: -2px 2px 7px rgba(0,0,0,.3);
    }
    .riapri_pagine:hover { background: #d7ecff; }
    /* griglia a doppia pagina, come il Correggo originale: la copertina e' una pagina destra
       (colonna 2), poi 2|3, 4|5... Le righe stanno in alto e non si allungano: prima la griglia
       aveva height:94% e le righe si spartivano tutto lo spazio, con buchi enormi fra le pagine. */
    .pannello_pagine .griglia {
        flex: 1 1 auto; min-height: 0;
        display: grid; grid-template-columns: 1fr 1fr; column-gap: 8px; row-gap: 12px;
        align-content: start; align-items: start;
        padding: 16px 10px 20px; overflow-y: auto; overflow-x: hidden;
    }
    .pannello_pagine .cella { text-align: center; font-size: 11px; cursor: pointer; position: relative; padding: 4px; }
    .pannello_pagine .cella.copertina { grid-column: 2; }
    .pannello_pagine .cella img {
        width: 100%; display: block; border: 0; background: #fff;
        box-shadow: 0 1px 3px rgba(0,0,0,.30);
    }
    .pannello_pagine .cella:hover img { box-shadow: 0 0 0 2px #46a9a2; }
    /* IL BORDINO GIALLO DELLA PAGINA SCELTA (j320, rifatto in j321).
       Michele (01/10), prima: «quando viene selezionata una pagina vorrei un bordino giallo intorno
       alla pagina selezionata». Poi, vedendolo: «il bordo giallo non lo farei cosi'. Lo farei fuori
       dalla scritta "Pag. 2", quello che penso attualmente fai di colore bordeaux».
       Quindi il giallo NON sta stretto intorno alla miniatura (com'era in j320, e come prima era il
       nero): sta intorno a TUTTA LA CELLA, numero di pagina compreso. E' anche piu' facile da
       vedere con la coda dell'occhio, perche' e' un rettangolo piu' grande.
       Vale SU TUTTO, come ha chiesto Michele: sta nel foglio di stile dell'editor, quindi si vede
       sempre - timone aperto o chiuso, e per qualsiasi ruolo.
       PERCHE' box-shadow E NON outline, che sarebbe venuto piu' naturale: il contrassegno delle
       pagine che aspettano l'Agenzia (j307) e' gia' un outline sulla stessa cella, e un elemento
       puo' avere UN SOLO outline - vince l'ultimo scritto. Provato: con due outline, su una pagina
       che aspetta ed e' anche la pagina scelta, il giallo mangiava il bordeaux e l'Agenzia perdeva
       l'informazione che li' c'e' da lavorare. Con box-shadow convivono: giallo fuori, bordeaux
       subito dentro, si leggono tutti e due.
       La miniatura torna all'ombra di sempre: il suo anello non serve piu' a niente. */
    .pannello_pagine .cella.pag_selected { box-shadow: 0 0 0 3px #f5b700; }
    .pannello_pagine .cella .didascalia { margin-top: 7px; font-weight: bold; color: #222; }
    .pag_notifica_errori {
        width: 30px; height: 30px; border-radius: 50%; background-color: red;
        position: absolute; left: -4px; top: -10px; color: white; font-weight: bold;
        line-height: 30px; font-size: 14px; z-index: 2; box-shadow: 0 1px 2px rgba(0,0,0,.35);
    }

