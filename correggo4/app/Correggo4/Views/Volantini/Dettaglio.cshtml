    collegaInterruttore('tVisMKT', function (visibile) { vedi.marketing = visibile; disegna(); });
    collegaInterruttore('tVisCAT', function (visibile) { vedi.category = visibile; disegna(); });
    /* ---------- il lucchetto del pannello pagine (j235) ----------
       L'originale (tool.js:637-706) accendeva il filtro, chiedeva una volta sola
       getPolicyPag/<volantino> e poi sbiadiva al 30% le pagine dove l'utente non aveva nessun
       prodotto permesso dalla sua policy, togliendo anche il clic. Qui uguale: la risposta si
       tiene da parte (come l'attributo policyLoaded del vecchio) e spegnendo l'interruttore le
       pagine tornano tutte normali. */
    var policyPagine = null;   // null = non ancora chiesta al server
    var policyBox = null;      // Set degli id dei prodotti che non sono tuoi (j236)
    var policyPromessa = null; // la lettura si fa una volta sola, come il vecchio policyLoaded

    function fuoriPolicy(idBox) { return !!policyBox && policyBox.has(String(idBox)); }

    /* j236: i prodotti fuori policy, neri e non correggibili. Si chiede all'apertura della pagina
       (solo per chi scrive: l'Agenzia non ha limiti) e la risposta serve anche al lucchetto. */
    function caricaPolicy() {
        if (policyPromessa) return policyPromessa;
        policyPromessa = apiGet('/Correzioni/PolicyPagine/' + ID_VOL).then(function (j) {
            if (!j.ok) { policyPromessa = null; return null; }
            policyPagine = {};
            (j.dati.pagine || []).forEach(function (p) { policyPagine[p.numero] = p.policyOk; });
            policyBox = new Set((j.dati.box || []).map(String));
            return j.dati;
        });
        return policyPromessa;
    }

    /* j237: i timbri esclusi dalla policy. Nell'originale PolicyManager toglieva ai Category i
       quattro di dimensione (`_3_*`), che in Correggo4 non ci sono nemmeno nel pannello: vale per
       qualunque timbro la policy escluda. Il server rifiuta comunque (timbro_fuori_policy). */
    function applicaTimbriEsclusi(lista) {
        (lista || []).forEach(function (s) {
            var bt = document.querySelector('.timbro_img[data-simbolo="' + s + '"]');
            if (bt) bt.classList.add('nascosto');
        });
    }

    function applicaBoxFuoriPolicy() {
        document.querySelectorAll('.foglio .zona').forEach(function (z) {
            var fuori = fuoriPolicy(z.dataset.box);
            z.classList.toggle('fuori_policy', fuori);
            var nota = ' — non e\' fra i prodotti che puoi correggere';
            if (fuori && (z.title || '').indexOf(nota) < 0) z.title = (z.title || '') + nota;
        });
    }

    function applicaPolicyPagine(acceso) {
        document.querySelectorAll('.pannello_pagine .cella').forEach(function (c) {
            var n = Number(c.dataset.pagina);
            var fuori = acceso && policyPagine && policyPagine[n] === false;
            c.classList.toggle('fuori_policy', !!fuori);
        });
    }

    function filtroPolicy(acceso) {
        if (!acceso) { applicaPolicyPagine(false); return; }
        if (policyPagine) { applicaPolicyPagine(true); return; }
        caricaPolicy().then(function (d) {
            if (!d) {
                suggerisci('Non si e\' potuto leggere i permessi delle pagine.', 6000);
                return;
            }
            if (!d.conPolicy) {
                suggerisci('Non hai limiti di reparto: tutte le pagine restano aperte.', 5000);
            } else if (Object.keys(policyPagine).filter(function (k) { return policyPagine[k]; }).length === 0) {
                suggerisci('Attenzione: su questo volantino non hai nessun prodotto da correggere.', 7000);
            }
            applicaBoxFuoriPolicy();
            applicaPolicyPagine(true);
        });
    }

    collegaInterruttore('soloCorreggibili', filtroPolicy);

    /* ---------- cassetti degli strumenti ---------- */
    function collegaCassetto(bottone, cassettoId, strumentoIniziale) {
