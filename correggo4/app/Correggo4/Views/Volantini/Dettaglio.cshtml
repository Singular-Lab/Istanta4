    /* ---------- Edit avanzato, passo 1 (j200) ----------
       Evidenziatori sulla pagina come Main.aspx:205 (.editAvanzatoEvidenziatore #e6ff00 opacita' .65),
       verdi quando l'Agenzia ha confermato (correzioni.js:643-690); bordi dei campi borderFix rosso /
       borderFixed verde (Main.aspx:319-325); ombre nel ritaglio come spaceShadow (correzioni.js:3380). */
    .ea_evid { position: absolute; background-color: #e6ff00; opacity: .65; z-index: 4; cursor: pointer; }
    .ea_evid.confermata { background-color: rgb(131, 215, 131); }
    .ea_evid.cerchio { width: 34px; height: 34px; border-radius: 50%; transform: translate(-50%, -50%); }
    /* Pallino dell'Agenzia (j219, richiesta di Michele del 14/9): l'Agenzia non vede il rettangolo sul campo
       cambiato ma un pallino sulla referenza, come il bollo delle azioni sul box dell'originale
       (correzioni.js:648-656: 60x60, border-radius 100%, in alto al centro). Le 60 misure sono pixel
       dell'immagine di pagina, non dello schermo: la misura la mette disegna() in % del foglio, cosi' il
       pallino resta grande come nel vecchio Correggo a ogni zoom (j220). */
    .ea_pallino { position: absolute; background-color: #e6ff00; opacity: .65; z-index: 4; cursor: pointer;
                  border-radius: 50%; aspect-ratio: 1; min-width: 12px; transform: translate(-50%, 0); }
