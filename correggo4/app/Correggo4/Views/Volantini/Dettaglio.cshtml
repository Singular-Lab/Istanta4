<script>
(function () {
    var dati = JSON.parse(document.getElementById('datiBox').textContent);
    var urlFoto = @Html.Raw(jsonUrlFoto);

    function esc(s) {
        return (s === null || s === undefined) ? '' : String(s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function escA(s) { return esc(s).replace(/"/g, '&quot;'); }

    /* ---------- zoom ---------- */
    var zoom = document.getElementById('zoom');
    function applicaZoom(v) {
        document.querySelectorAll('.foglio').forEach(function (f) { f.style.width = v + '%'; });
        document.getElementById('zoomval').textContent = v + '%';
        zoom.value = v;
        if (typeof sistemaTutteLeIcone === 'function') sistemaTutteLeIcone();   // j240
    }
    zoom.addEventListener('input', function () { applicaZoom(parseInt(zoom.value, 10)); });
    document.getElementById('zoom100').addEventListener('click', function () { applicaZoom(100); });
    // 48% (j215): la pagina intera si vede tutta, anche aprendo il volantino.
    document.getElementById('zoomFit').addEventListener('click', function () { applicaZoom(48); });

    /* ---------- pagine ---------- */
    function vaiAPagina(n) {
        document.querySelectorAll('.foglio').forEach(function (f) {
            f.style.display = (f.dataset.numero === String(n)) ? 'inline-block' : 'none';
        });
        document.querySelectorAll('.pannello_pagine .cella').forEach(function (c) {
            c.classList.toggle('pag_selected', c.dataset.pagina === String(n));
        });
        var f = document.getElementById('fPagina');
        if (f) f.value = n;
        document.getElementById('area').scrollTop = 0;
        // j240: la pagina appena aperta ora si puo' misurare: le icone vanno al posto giusto
        if (typeof sistemaTutteLeIcone === 'function') sistemaTutteLeIcone();
    }
    document.querySelectorAll('.pannello_pagine .cella').forEach(function (c) {
        c.addEventListener('click', function () { vaiAPagina(c.dataset.pagina); });
    });

    var pannello = document.getElementById('pannelloPagine');
    var linguettaPagine = document.getElementById('riapriPagine');
    function mostraPannello(v) {
        pannello.style.display = v ? 'flex' : 'none';
        linguettaPagine.classList.toggle('nascosto', v);   // j240: la freccetta solo a pannello chiuso
    }
    linguettaPagine.addEventListener('click', function () { mostraPannello(true); });
    document.getElementById('chiudiPagine').addEventListener('click', function () { mostraPannello(false); });
    document.getElementById('riapriLibro').addEventListener('click', function () {
        mostraPannello(pannello.style.display === 'none');
    });

    /* ---------- j243: il semaforo suona anche a volantino aperto ----------
       Chi sta dentro l'editor ad aspettare il via non deve ricaricare la pagina: ogni minuto si
       chiede al server se e' arrivata una notifica di semaforo (finestra dei Category aperta o
       chiusa). Se si': din-don, barra verde in alto e numero nella linguetta del browser.
       Il primo giro serve solo a sapere da che numero partire, quindi non suona mai.
       I browser non lasciano suonare una pagina prima di un clic dell'utente: qui dentro il clic
       c'e' sempre, ma se non ci fosse restano barra e titolo. */
    (function semaforo() {
        var stile = document.createElement('style');
        stile.textContent =
            '#semBarra{position:fixed;left:0;right:0;top:0;z-index:400;background:#1d7a34;color:#fff;' +
            'padding:10px 14px;display:flex;align-items:center;gap:12px;font-weight:600;' +
            'box-shadow:0 2px 10px rgba(0,0,0,.25);font-size:14px}' +
            '#semBarra a{color:#fff;text-decoration:underline}' +
            '#semBarra button{margin-left:auto;border:0;background:#ffffff2e;color:#fff;' +
            'border-radius:6px;padding:3px 9px;cursor:pointer;font:inherit}';
        document.head.appendChild(stile);

        var TITOLO = document.title, ultimoId = 0, suono = null, orologio = null;

        function dindon() {
            try {
                var C = window.AudioContext || window.webkitAudioContext;
                if (!C) return;
                suono = suono || new C();
                if (suono.state === 'suspended') suono.resume();
                var t0 = suono.currentTime;
                [[784, 0], [1046, 0.17]].forEach(function (nota) {
                    var o = suono.createOscillator(), g = suono.createGain();
                    o.type = 'sine'; o.frequency.value = nota[0];
                    g.gain.setValueAtTime(0.0001, t0 + nota[1]);
                    g.gain.exponentialRampToValueAtTime(0.22, t0 + nota[1] + 0.02);
                    g.gain.exponentialRampToValueAtTime(0.0001, t0 + nota[1] + 0.40);
                    o.connect(g); g.connect(suono.destination);
                    o.start(t0 + nota[1]); o.stop(t0 + nota[1] + 0.45);
                });
            } catch (e) { /* niente suono: resta la barra */ }
        }

        function barra(testo, link) {
            var b = document.getElementById('semBarra');
            if (!b) { b = document.createElement('div'); b.id = 'semBarra'; document.body.appendChild(b); }
            b.textContent = '';
            var s = document.createElement('span'); s.textContent = testo; b.appendChild(s);
            if (link) {
                var a = document.createElement('a'); a.href = link; a.textContent = 'Vai alla home';
                b.appendChild(a);
            }
            var x = document.createElement('button'); x.type = 'button'; x.innerHTML = '&times;';
            x.addEventListener('click', function () { b.remove(); });
            b.appendChild(x);
            clearTimeout(orologio);
            orologio = setTimeout(function () {
                var v = document.getElementById('semBarra'); if (v) v.remove();
            }, 120000);
        }

        function giro() {
            fetch('/Notifiche/Nuove?dopo=' + ultimoId, { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (j) {
                    if (!j || !j.ok) return;
                    var d = j.dati;
                    document.title = d.quanteNonLette > 0 ? '(' + d.quanteNonLette + ') ' + TITOLO : TITOLO;
                    if (d.ultimoId > ultimoId) {
                        ultimoId = d.ultimoId;
                        var semafori = (d.nuove || []).filter(function (x) { return x.semaforo; });
                        if (semafori.length) { dindon(); barra(semafori[0].testo, semafori[0].link); }
                    }
                })
                .catch(function () { });
        }
        giro();
        setInterval(giro, 60000);
        document.addEventListener('visibilitychange', function () { if (!document.hidden) giro(); });
    })();

    /* ---------- interruttori di visibilita' ---------- */
    function collegaInterruttore(id, azione) {
        var el = document.getElementById(id);
        if (!el) return;
        el.addEventListener('click', function () {
            el.classList.toggle('spento');
            var gruppo = el.closest('.gruppo_toggle');
            if (gruppo) gruppo.classList.toggle('spento', el.classList.contains('spento'));
            azione(!el.classList.contains('spento'));
        });
    }
    var vedi = { correzioni: true, accettate: true, ok: true, marketing: true, category: true, ea: true };
    collegaInterruttore('tVisNote', function (visibile) { vedi.correzioni = visibile; disegna(); });
    collegaInterruttore('tSugg', function () { /* i suggerimenti non sono ancora portati */ });
    collegaInterruttore('tFatte', function (visibile) { vedi.accettate = visibile; disegna(); });
    collegaInterruttore('tVisOk', function (visibile) { vedi.ok = visibile; disegna(); });
