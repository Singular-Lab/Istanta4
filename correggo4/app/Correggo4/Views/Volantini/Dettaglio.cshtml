@model Correggo4.Models.Vista.VolantinoInCorrezione
@using System.Globalization
@{
    ViewData["Title"] = Model.Titolo;
    Layout = null;
    var ci = CultureInfo.InvariantCulture;
    bool puoCorreggere = User.IsInRole("GDO");
    int pagAttiva = int.TryParse(Context.Request.Query["pag"], out int pq) ? pq : 1;
    var img = "/immagini-correggo";
    var co = Model.Correzioni;
    // Correzioni aperte per pagina (note e timbri non ancora accettati): il pallino del pannello.
    Func<int, int> aperteDiPagina = idp =>
        co.Note.Count(n => n.IdPagina == idp && n.Stato == 0) + co.Timbri.Count(t => t.IdPagina == idp && t.Stato == 0);
}
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@Model.Titolo &middot; Correggo4</title>
<style>
    /* Misure e colori presi dal sorgente vero (Correggo/Main.aspx), non stimati:
       barra 80px #60cabb, rail 100px #9cdcd8 con bordo 2px #46a9a2,
       cassetto pagine 300px aliceblue bordo nero 2px, .pag_selected 4px nero,
       .pag_notifica_errori 35px rosso, sfondo pattern-background.png. */
    * { box-sizing: border-box; }
    body {
        margin: 0; overflow: hidden;
        background-image: url('@img/pattern-background.png');
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande',
                     'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
    }
    input:focus, textarea:focus, select:focus { outline: 0; }
    button { font-family: inherit; }

    /* ---------- barra alta (80px, #60cabb) ---------- */
    .barra_alta {
        position: fixed; left: 0; right: 0; top: 0; height: 80px; z-index: 100;
        background-color: #60cabb; color: #fff;
    }
    .barra_alta .logo { float: left; width: 80px; margin-right: 10px; cursor: pointer; }
    .barra_alta .titolo_zona {
        float: left; margin-top: 20px; margin-left: 12px;
        display: flex; align-items: center; font-size: 20px;
    }
    .barra_alta .titolo_zona .dropdown { width: 20px; margin-right: 5px; cursor: pointer; }
    .barra_alta .postit { width: 50px; margin-left: 15px; margin-top: -5px; cursor: pointer; }
    .barra_alta .destra { float: right; display: flex; align-items: center; height: 80px; }
    .barra_alta .pagine_btn { width: 100px; margin: 5px; cursor: pointer; }
    .barra_alta .utente { font-size: 14px; font-weight: bold; margin-right: 20px; }
    /* LEGENDA (j216): iconcina del manuale accanto al nome dell'utente */
    .barra_alta .legenda_btn { display: inline-flex; align-items: center; margin-right: 16px; }
    .barra_alta .legenda_btn img { width: 32px; height: 32px; display: block; }
    .barra_alta .legenda_btn:hover img { filter: brightness(1.15); }
    .chiudi_bar {
        background: none; border: 0; padding: 0; cursor: pointer; color: #fff;
        font-size: 14px; font-weight: bold; margin-right: 20px;
    }
    .chiudi_bar:hover { text-decoration: underline; }

    /* ---------- rail strumenti (100px, #9cdcd8) ---------- */
    .barra {
        position: fixed; left: 0; top: 80px; width: 100px; bottom: 0;
        background-color: #9cdcd8; text-align: center; padding: 5px 0;
        border-top: 2px solid #46a9a2; z-index: 99; overflow: hidden;
    }
    /* j215: la barra non scorre piu' (prima si spostava a destra e sinistra). Se gli strumenti non entrano
       in altezza, adattaBarra() li rimpicciolisce quanto basta. */
    .barra_dentro { transform-origin: top center; }
    .strumento {
        background-color: transparent; border: 0; cursor: pointer; display: block;
        margin: 0 auto; background-repeat: no-repeat; background-position: center;
    }
    .s_note  { width: 100px; height: 60px; background-image: url('@img/tool_noteoff.png'); background-size: cover; }
    .s_note.acceso { background-image: url('@img/tool_noteon.png'); }
    .s_board { width: 100px; height: 60px; background-image: url('@img/boardoff.png'); background-size: cover; }
    .s_board.acceso { background-image: url('@img/boardon.png'); }
    .s_ok    { width: 50px;  height: 54px; margin-top: 15px;
               background-image: url('@img/okoff.png'); background-size: contain; }
    .s_ok.acceso { background-image: url('@img/okon.png'); }
    .s_report { width: 80px; height: 66px; margin: 0 auto;
                background-image: url('@img/reportoff.png'); background-size: contain; }
    .s_scala { width: 50px; height: 50px; background-size: contain; }
    .s_100 { background-image: url('@img/scale_100.png'); }
    .s_fit { background-image: url('@img/scale_fit.png'); }

    /* gli interruttori: immagine di fondo + rullino sovrapposto */
    .gruppo_toggle { position: relative; }
    .toggle_base {
        width: 100px; height: 80px; border: 0; cursor: pointer; background-color: transparent;
        background-image: url('@img/toggle_correzioni.png'); background-size: contain;
        background-repeat: no-repeat; background-position: center;
    }
    /* Come l'originale (tool.js toggleCorrezioni/toggleOkVisto/toggleEA): da acceso a spento il
       pallino scorre da margin-left 9px a 62px. Prima l'interruttore si ingrigiva. */
    .rullino { position: absolute; margin-top: 24px; margin-left: 9px; pointer-events: none;
               transition: margin-left .35s ease; }
    .gruppo_toggle.spento .rullino { margin-left: 62px; }
    .occhietto {
        width: 60px; height: 40px; border: 0; cursor: pointer; background-color: transparent;
        background-size: contain; background-repeat: no-repeat; background-position: center;
    }
    .oc_fatte { background-image: url('@img/Correzioni-FATTE-vedo.png'); }
    .oc_fatte.spento { background-image: url('@img/Correzioni-FATTE-NON-vedo.png'); }
    .oc_sugg { background-image: url('@img/Suggerimenti-vedo.png'); }
    .oc_sugg.spento { background-image: url('@img/Suggerimenti-NON-vedo.png'); }

    .zona_zoom { width: 100%; margin-top: 30px; }
    .zona_zoom input[type=range] { width: 75px; margin-left: 7px; }
    .zoomval { width: 100%; text-align: center; font-size: 12px;
               margin: 5px 0; color: #275653; }

    /* cassetto note: left 100, width 60, #68a7a3 */
    .cassetto {
        position: fixed; left: 100px; top: 80px; width: 60px; bottom: 0;
        background-color: #68a7a3; text-align: center; padding: 5px 0;
        border-top: 2px solid #46a9a2; z-index: 99; display: none;
    }
    .cassetto.aperto { display: block; }
    .cassetto .fbtn {
        width: 44px; height: 38px; background: #fff; border: 1px solid #46a9a2;
        cursor: pointer; font-size: 14px; color: #1d5b55; display: block;
        margin: 0 auto 6px auto;
    }
    /* la lavagna dei timbri sta nello stesso posto ma e' larga due colonne */
    .cassetto.lavagna { width: 116px; }
    .griglia_timbri { display: grid; grid-template-columns: repeat(2, 50px); gap: 4px; justify-content: center; }
    .timbro {
        height: 44px; border: 0; border-radius: 3px; cursor: pointer; color: #fff;
        font-size: 8px; font-weight: bold; line-height: 1.05; padding: 3px 1px;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .timbro .glifo { font-size: 15px; }

    /* ---------- area di lavoro ---------- */
    .area {
        position: fixed; left: 100px; right: 0; top: 80px; bottom: 0;
        overflow: auto; padding: 10px 12px 40px 12px;
    }
    .foglio { position: relative; display: inline-block; background: #fff;
              box-shadow: 0 1px 6px rgba(0,0,0,.22); vertical-align: top; }
    .foglio img.pagina { display: block; width: 100%; height: auto; }

    /* I box non si disegnano: la pagina si vede pulita, anche al passaggio del mouse (11/9: prima
       c'era un rettangolo giallo in hover, che l'originale non ha). Solo in Edit avanzato ogni box
       diventa un rettangolo celeste cliccabile: .baseEditAvanzato di Scripts/tool.js:284,
       background #cfdbf563. */
    .zona { position: absolute; background: transparent; }
    /* Bordino (richiesta dell'11/9): senza, due referenze affiancate sembrano un unico rettangolo.
       Disegnato con box-shadow inset, cosi' non cambia la misura del box. */
    body.modo_edit .zona { background: #cfdbf563; cursor: pointer; box-shadow: inset 0 0 0 1px #5b7fc7; }
    .zona.aperta { outline: 2px solid red; }

    /* La nota di correzione: etichetta gialla calamitata al prodotto,
       col megafono della propagazione a sinistra (prop.gif). */
    .nota_chiusa {
        /* j229: bordo sottile e grigio (prima 1px #333, 2px sulle proprie: Michele lo vedeva
           troppo spesso). Il rettangolo resta della stessa misura. */
        position: absolute; background-color: yellow; border: 1px solid #8a8a8a; z-index: 5;
        font-size: 11px; line-height: 1.25; padding: 3px 6px; cursor: pointer;
        /* come l'originale (.span_nota_correzione): un rettangolo che cresce e va a capo, si legge
           tutta la nota senza aprirla (j221) */
        max-width: 240px; white-space: pre-wrap; overflow-wrap: break-word; color: #000;
        /* alone sfocato dell'originale (correzioni.js:936-938): giallo in attesa, verde accettata.
           Nell'originale stava solo sui timbri; il 14/9 Michele l'ha chiesto anche sulle note. */
        box-shadow: 1px 1px 20px 11px rgb(255,235,0);
    }
    .nascosto { display: none !important; }

    /* ---------- correzioni (11/9/2026): colori del Correggo originale ----------
       nota Category rgb(255,187,155), Marketing gialla, accettata verde rgb(57,232,57)
       (Scripts/agenzia.js:333-346, correzioni.js:573-576); timbri <simbolo>.png / _ok.png. */
    .nota_chiusa.cat { background-color: rgb(255,187,155); }
    /* Accettata: sfondo verde e bordo 6px del colore di chi l'ha scritta (correzioni.js:410-422). */
    .nota_chiusa.accettata { background-color: rgb(57,232,57); border: 6px solid yellow;
                             box-shadow: 1px 1px 20px 11px rgb(0,255,102); }
    .nota_chiusa.accettata.cat { border-color: rgb(255,187,155); }
    /* la nota propria si riconosce dal bordo piu' scuro, non piu' dallo spessore (j229) */
    .nota_chiusa.mia:not(.accettata) { border-color: #333; }
    .corr_timbro { position: absolute; width: 40px; height: 40px; z-index: 6; cursor: pointer;
                   transform: translate(-50%, -50%); box-shadow: 1px 1px 20px 11px rgb(255,235,0); }
    .corr_timbro.accettato { box-shadow: 1px 1px 20px 11px rgb(0,255,102); }
    /* Spunta dell'Agenzia: done.png dell'originale (Main.aspx:711 .done_nota_correzione / .done_disegnoicon,
       mostrata a stato_utente 2 sulle correzioni ancora da accettare, correzioni.js:535). Un clic accetta. */
    .spunta_ok { position: absolute; width: 30px; height: 30px; cursor: pointer; z-index: 8;
                 filter: drop-shadow(0 1px 2px rgba(0,0,0,.45)); }
    .nota_chiusa .spunta_ok { left: -34px; top: -3px; }
    .spunta_timbro { transform: translate(-145%, -50%); }
    /* ---------- megafono delle propagazioni (j223): prop.gif / prop_lampeggiante.gif /
       megafono_progress.gif, come l'originale (Main.aspx:710,717 e correzioni.js:383-407) ---------- */
    .megafono { position: absolute; width: 30px; height: 30px; cursor: pointer; z-index: 8;
                filter: drop-shadow(0 1px 2px rgba(0,0,0,.45)); }
    /* j234: come il vecchio. Nel template della nota (Main.aspx:710-711) megafono e spunta hanno
       la stessa posizione esatta (margin-left:-31px, margin-top:-3px) perche' non si vedono mai
       insieme: correzioni.js:529-543 mostra il megafono se la correzione ha una propagazione, la
       spunta (o il cestino, per chi scrive) soltanto se non ce l'ha. Il j233 li aveva affiancati
       (megafono a destra), ma non e' quello che faceva l'originale. */
    .nota_chiusa .megafono { left: -34px; top: -3px; }
    /* j239: su una correzione vicina al bordo sinistro della pagina le icone finivano fuori dal
       foglio (anche nell'originale, che le teneva a margin-left:-31px). Se a sinistra non ci stanno
       si spostano a destra; se non c'e' spazio da nessuna delle due parti restano dentro, appoggiate
       all'angolo. Lo decide sistemaIcone() misurando la nota nel foglio. */
    .nota_chiusa.icone_a_destra .spunta_ok,
    .nota_chiusa.icone_a_destra .megafono { left: auto; right: -34px; }
    .nota_chiusa.icone_dentro .spunta_ok,
    .nota_chiusa.icone_dentro .megafono { left: 1px; top: -1px; opacity: .92; }
    /* sui timbri le icone sono appoggiate a sinistra col transform: qui si specchia */
    .spunta_timbro.icona_a_destra, .megafono_timbro.icona_a_destra { transform: translate(45%, -50%); }
    /* sui timbri vale la stessa cosa: stessa posizione della spunta (done_disegnoicon e
       prop_disegnoicon dell'originale, Main.aspx:717-718) */
    .megafono_timbro { transform: translate(-145%, -50%); }
    /* propagazioni ricevute da un altro volantino (j225): come l'originale, appoggiate sul prodotto e
       **sbiadite** finche' sono solo proposte non attivate (correzioni.js:374-379 .correzione_suggerita) */
    .propagata { border-style: dashed; }
    .propagata.suggerita { opacity: .5; }
    img.propagata.suggerita { opacity: .45; }
    /* DEPRECATO (j231): era la riga "propagata da <autore>" sotto il testo delle note arrivate da un
       altro volantino (j225, come il ramo //PROPAGAZIONI dell'originale che mandava anche l'autore).
       Il 16/09 Michele ha chiesto di non vedere chi ha propagato la correzione: la riga non viene piu'
       creata (vedi il commento in disegna(), propagazioni ricevute) e questo stile non si applica a
       niente. Riattivandolo tornerebbe la scritta piccola grigia sotto il testo della nota, e le note
       impilate sullo stesso prodotto si allungherebbero di una riga. */
    .propagata_da { font-size: 10px; color: #444; display: block; }
    /* l'alone lampeggiante dell'originale (Main.aspx:137-175): rosso/giallo se la catena e' da fare,
       verde/giallo quando tutta la catena e' stata corretta */
    @@keyframes lampeggiaProp {
        0% { box-shadow: 1px 1px 20px 11px red; }
        50% { box-shadow: 1px 1px 20px 0 rgb(241,228,78); }
        100% { box-shadow: 1px 1px 20px 11px red; }
    }
    @@keyframes lampeggiaPropFatta {
        0% { box-shadow: 1px 1px 20px 11px rgb(0,255,102); }
        50% { box-shadow: 1px 1px 20px 0 rgb(241,228,78); }
        100% { box-shadow: 1px 1px 20px 11px rgb(0,255,102); }
    }
    .prop_lampeggia { animation: lampeggiaProp 1s infinite; }
    .prop_fatta { animation: lampeggiaPropFatta 1s infinite; }

    /* ---------- finestra dei gemelli (#propagazione dell'originale, Main.aspx:497-521) ---------- */
    .cat_velo { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: #36383a94; z-index: 150; display: none; }
    .cat_velo.visibile { display: block; }
    .cat_menu { width: 94%; max-width: 1500px; margin: 26px auto 0; display: flex; align-items: center; gap: 8px;
                flex-wrap: wrap; }
    .cat_menu .tit { background: #bbbbbb; padding: 4px 10px; font-size: 12px; font-weight: bold; }
    .cat_chiudi { margin-left: auto; font-size: 12px; border: 1px solid #888; background: #efefef; padding: 2px 10px; cursor: pointer; }
    .cat_bott { font-size: 12px; border: 1px solid #888; background: #efefef; padding: 3px 10px; cursor: pointer; font-family: inherit; }
    .cat_bott[disabled] { opacity: .5; cursor: default; }
    /* j230: «ELIMINA DEFINITIVAMENTE», il bottone dell'originale che spegne l'intera propagazione */
    .cat_bott.pericolo { border-color: #8b3a3a; background: #d76868; color: #fff; font-weight: bold;
                         margin-left: auto; }
    .cat_finestra { width: 94%; max-width: 1500px; max-height: calc(100vh - 96px); margin: 0 auto; overflow-y: auto;
                    background: #bbbbbb; border: 3px solid #545050; font-size: 12px; padding: 0 0 4px; box-sizing: border-box; }
    /* j232: la finestra rifatta come il vecchio (Main.aspx:497-521 e correzioni.js:4580-5000):
       due fascette rosso mattone, il riquadro nero della correzione di partenza, le righe alte
       con il ritaglio del prodotto. Prima era una tabella compatta: Michele leggeva meglio quella
       del vecchio. */
    .cat_fascia { background: #9a4f5c; color: #fff; font-weight: bold; padding: 7px 14px; display: flex;
                  align-items: baseline; gap: 12px; }
    .cat_fascia .dx { margin-left: auto; font-weight: normal; font-size: 11px; color: #f0dfe2; }
    .cat_pilota { border: 3px solid #000; background: #d6d3d3; margin: 10px 12px; }
    table.cat_orig { width: 100%; border-collapse: collapse; }
    table.cat_orig td { padding: 10px 12px; vertical-align: top; }
    .cat_barra { background: #9a4f5c; color: #fff; font-weight: bold; padding: 7px 14px; margin: 0; }
    table.cat_tab { width: 100%; border-collapse: collapse; background: transparent; }
    table.cat_tab td { padding: 9px 12px; border-bottom: 2px solid #bbbbbb; vertical-align: middle;
                       background: #b9c9c7; }
    table.cat_tab tr.zebra td { background: #c9d6d4; }
    table.cat_tab tr.superata td { color: #7a2020; }
    /* il ritaglio del prodotto: la pagina intera spostata e scalata, come fa il ritaglio della
       scheda nell'editor (l'originale invece chiamava thumbnailbox.aspx) */
    .cat_rit { width: 170px; height: 86px; overflow: hidden; position: relative; background: #fff;
               border: 1px solid #8f8f8f; }
    .cat_rit.grande { width: 240px; height: 108px; }
    .cat_rit img { position: absolute; max-width: none; }
    .cat_col_stato { width: 140px; font-size: 11px; }
    .cat_col_azione { width: 78px; text-align: center; }
    .cat_col_vol { width: 24%; line-height: 1.45; }
    .cat_col_orig { width: 190px; line-height: 1.45; }
    .cat_prodotto { color: #333; margin-top: 3px; }
    .cat_codici { font-size: 11px; color: #333; width: 15%; }
    .cat_seletta { display: block; margin-top: 6px; font-size: 11px; }
    .cat_fondo { padding: 12px 14px; text-align: center; }
    .cat_timbro { width: 26px; vertical-align: middle; margin-right: 6px; }
    .cat_spunta { width: 18px; height: 18px; }
    .cat_promo { font-weight: bold; }
    .cat_vol { color: #333; }
    .cat_stato { font-weight: bold; }
    .cat_stato.fatta { color: #1d7a45; }
    .cat_stato.dafare { color: #8a5a00; }
    .cat_scad { background: #dd7800; color: #fff; padding: 1px 5px; font-size: 10px; font-weight: bold; }
    .cat_scad.chiuso { background: #c62828; }
    .cat_vuoto { padding: 20px; text-align: center; }
    .cat_lucchetto { width: 20px; height: 20px; vertical-align: middle; }
    /* conferma dell'Agenzia (j224): la spunta done.png dell'originale, come nell'editor */
    .cat_conferma { width: 22px; height: 22px; cursor: pointer; vertical-align: middle; margin-left: 4px; }
    /* nel riquadro della correzione di partenza la spunta e' grande come nel vecchio */
    .cat_conferma.grande { width: 52px; height: 52px; margin: 6px 0 0; display: block; }
    .cat_chi { color: #1d7a45; font-size: 11px; }
    .cat_sel { width: 16px; height: 16px; vertical-align: middle; }
    /* OK visto (j215, richiesta di Michele): al centro del prodotto e grande, non piu' 36px in alto a destra.
       La larghezza la mette disegna() in % del foglio (32% del lato corto del box), cosi' segue lo zoom.
       j238: era il 40% con minimo 60px, Michele l'ha chiesto un po' piu' piccolo. */
    .corr_ok { position: absolute; min-width: 48px; height: auto; z-index: 6; cursor: pointer;
               transform: translate(-50%, -50%); filter: drop-shadow(1px 1px 2px rgba(0,0,0,.4)); }
    body.con_strumento .zona { cursor: crosshair; }

    .cassetto .fbtn.scelto { background: #1d5b55; color: #fff; }
    /* Cassetto note con le immagini dell'originale (Main.aspx:419-428): 50px, on/off per lo scelto. */
    .cassetto .fbtn_img { display: block; width: 50px; margin: 0 auto 6px auto; padding: 0; border: 0;
                          background: transparent; cursor: pointer; }
    .cassetto .fbtn_img img { width: 50px; display: block; }
    .timbro_img { width: 50px; height: 50px; padding: 0; border: 2px solid transparent; border-radius: 6px;
                  background: transparent; cursor: pointer; }
    .timbro_img img { width: 100%; height: 100%; display: block; }
    .timbro_img.scelto { border-color: #fff; box-shadow: 0 0 0 2px #1d5b55; }
    .s_ok.scelto { background-image: url('@img/okon.png'); }

    .suggerimento {
        position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 120;
        background: #1c1c1c; color: #fff; font-size: 12px; padding: 7px 14px; border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,.3); display: none;
    }
    .avviso_vol {
        position: fixed; left: 100px; right: 0; top: 80px; z-index: 97; background: #c62828; color: #fff;
        font-size: 13px; font-weight: bold; text-align: center; padding: 6px;
    }

    .pop_corr {
        position: fixed; z-index: 130; width: 290px; background: #fff; border: 1px solid #333;
        box-shadow: 0 4px 16px rgba(0,0,0,.35); font-size: 12px; display: none;
    }
    .pop_corr.visibile { display: block; }
    .pop_corr .pc_testa { background: #1c1c1c; color: #fff; padding: 5px 8px; font-weight: bold;
                          display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .pop_corr .pc_testa .x { cursor: pointer; font-weight: normal; }
    .pop_corr .pc_corpo { padding: 8px; }
    .pop_corr .pc_meta { color: #555; font-size: 10.5px; margin: 5px 0 0; line-height: 1.4; }
    .pop_corr .pc_testo { white-space: pre-wrap; background: #fafafa; border: 1px solid #ddd; padding: 6px; }
    .pop_corr textarea { width: 100%; min-height: 90px; font-family: inherit; font-size: 12px;
                         border: 1px solid #9a9a9a; padding: 5px; resize: vertical; }
    .pop_corr .pc_bottoni { display: flex; justify-content: flex-end; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
