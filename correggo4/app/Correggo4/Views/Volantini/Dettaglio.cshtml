    .riga_logo .bottone { padding: 1px 6px; font-size: 10px; }
    .scelta_foto { position: fixed; left: 140px; right: 40px; top: 110px; bottom: 40px; z-index: 110; display: none;
                   flex-direction: column; background: #d3d3d3; border: 1px solid #7a7a7a; box-shadow: 0 4px 18px rgba(0,0,0,.35); }
    .scelta_foto.visibile { display: flex; }
    .scelta_foto .testa { display: flex; justify-content: space-between; align-items: center; padding: 5px 8px;
                          font-weight: bold; font-size: 12px; border-bottom: 1px solid #9a9a9a; }
    .scelta_foto .testa .chiudi { font-weight: normal; border: 1px solid #888; background: #efefef; padding: 1px 8px; cursor: pointer; font-size: 11px; }
    .griglia_foto { flex: 1; overflow-y: auto; padding: 10px; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
                    gap: 10px; align-content: start; }
    .voce_foto { background: #fff; border: 4px solid transparent; padding: 5px; cursor: pointer; text-align: center; font-size: 10.5px; }
    .voce_foto img { width: 100%; height: 170px; object-fit: contain; display: block; margin-bottom: 4px; }
    .voce_foto:hover { border-color: #5b7fc7; }
    .voce_foto.corrente { border-color: #e6d600; }
    /* ---------- REPORT CORREZIONI (j214): la finestra #report di Main.aspx e reports.js ---------- */
    .report_velo { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: #36383a94; z-index: 140; display: none; }
    .report_velo.visibile { display: block; }
    .report_menu { width: 800px; max-width: calc(100% - 40px); height: 29px; margin: 100px auto 0; display: flex; align-items: center; }
    .report_scelte { background: #bbbbbb; padding: 3px 12px 3px 6px; font-size: 12px; display: inline-flex; align-items: center; gap: 8px; }
    .report_scelte label { display: inline-flex; align-items: center; gap: 3px; cursor: pointer; }
    .report_scelte img { width: 21px; margin-left: 12px; vertical-align: middle; }
    .report_chiudi { margin-left: auto; font-size: 12px; border: 1px solid #888; background: #efefef; padding: 2px 10px; cursor: pointer; }
    .report_finestra { width: 800px; max-width: calc(100% - 40px); height: calc(100vh - 150px); margin: 0 auto; overflow-y: auto; overflow-x: hidden;
                       background: #bbbbbb; border: 3px solid #545050; font-size: 12px; padding: 2px 20px 20px; box-sizing: border-box; }
    .report_finestra .rp_versione { font-size: 14px; font-weight: bold; margin: 18px 0 4px; }
    .report_finestra .rp_pag { background: #8fa7a7; padding: 10px; font-weight: bold; margin: 20px 0 12px; }
    .report_finestra .rp_pag_piccola { padding: 4px 10px; margin: 10px 0 8px; }
    .report_finestra .rp_prodotto { font-weight: bold; margin: -4px 0 8px; }
    .report_finestra .rp_voce { display: flex; margin: 0 0 16px; }
    .report_finestra .rp_lab { width: 150px; flex: 0 0 150px; border-right: 1px solid #000; padding-right: 10px; font-weight: bold; }
    .report_finestra .rp_cont { flex: 1; padding-left: 10px; min-width: 0; }
    .report_finestra .rp_det { margin-bottom: 3px; }
    .report_finestra .rp_t { white-space: pre-wrap; }
    .report_finestra .rp_simbolo { width: 40px; vertical-align: middle; margin-right: 5px; }
    .report_finestra .rp_foto div { display: flex; align-items: center; gap: 6px; margin-top: 3px; }
    .report_finestra .rp_foto img { width: 50px; height: 50px; object-fit: contain; background: #fff; }
    .report_finestra .rp_esito { margin-top: 3px; padding: 2px 5px; font-weight: bold; }
    .report_finestra .rp_esito.accettata { background: #a3eca3; }
    .report_finestra .rp_esito.irrisolta { background: #dd7800; }
    .report_finestra .rp_esito.attesa { background: #fff0c2; }
    .report_finestra .rp_vuoto { padding: 30px; text-align: center; }
    /* icona dello storico sul prodotto (icon_has_strorico, 35px in basso a sinistra del box) */
    .ico_storico { position: absolute; width: 30px; height: 30px; z-index: 7; cursor: pointer; transform: translate(6px, calc(-100% - 6px)); }
</style>
