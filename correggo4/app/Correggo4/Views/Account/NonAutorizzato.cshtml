@{
    ViewData["Title"] = "Utente non autorizzato";
    Layout = null;
    string nome = ViewBag.Nome as string ?? "";
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Correggo4 &middot; utente non autorizzato</title>
    <script src="~/js/ingrandimento.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<div class="container" style="max-width: 28rem; margin-top: 12vh;">
    <h1 class="h4 mb-1">Correggo4</h1>
    <p class="text-muted small mb-4">Correttore di bozze del volantino</p>

    <div class="alert alert-warning">
        @if (nome != "")
        {
            <strong>@nome</strong><br />
        }
        Il tuo utente non ha i permessi per accedere a Correggo4.
        Contatta l'amministratore per farti abilitare.
    </div>
</div>
</body>
</html>
