@model Correggo4.Models.Vista.RevocaVersione
@{
    // Conferma della revoca (j209): prima si vedono le correzioni che si archiviano (decisione dell'11/9).
    Layout = null;
    string nome = (ViewBag.Nome as string) ?? "";
    var c = Model.Correzioni;
    string Stato(short s) => s == 0 ? "in attesa" : "accettata";
    string Data(DateTime? d) => d == null ? "" : Correggo4.Servizi.FinestreCategory.Locale(d.Value).ToString("dd/MM HH:mm");
    int totale = c.Note.Count + c.Timbri.Count + c.Edit.Count;
}
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Revoca versione &middot; Correggo4</title>
<style>
:root{--teal:#60cbbb;--teal-700:#2a8a7c;--co:#8dc63f;--ink:#1f2a30;--ink-2:#4a5860;--ink-3:#7c8a91;--line:#dfe5e8;--bg:#f1f4f5;
      --lock:#c8352e;--ok-bg:#dcf3e6;--ok-fg:#1d7a45;--rev-bg:#fff0c2;--rev-fg:#8a5a00;--shadow:0 1px 2px rgba(20,40,50,.06),0 2px 8px rgba(20,40,50,.06)}
*{box-sizing:border-box}
body{margin:0;font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;color:var(--ink);background:var(--bg);font-size:14px}
.hdr{background:#fff;border-top:4px solid var(--teal);box-shadow:0 1px 0 var(--line)}
.hdr-in{display:flex;align-items:center;gap:16px;padding:10px 28px;min-height:64px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}
.brand .co{width:36px;height:36px;border-radius:8px;background:var(--co);color:#fff;display:grid;place-items:center;font-weight:800}
.brand small{display:block;font-size:11px;color:var(--ink-3);margin-top:-2px}
.sp{flex:1}
main{max-width:900px;margin:24px auto;padding:0 20px}
.card{background:#fff;border-radius:10px;box-shadow:var(--shadow);padding:18px 20px;margin-bottom:16px}
h1{font-size:21px;margin:0 0 6px}
h2{font-size:14px;margin:0 0 8px}
.avviso{background:var(--rev-bg);color:var(--rev-fg);border-radius:8px;padding:12px 14px;font-weight:600;margin-bottom:16px}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--ink-3);font-weight:600;font-size:12px}
.pill{font-size:11px;font-weight:700;padding:1px 8px;border-radius:10px;background:var(--rev-bg);color:var(--rev-fg);white-space:nowrap}
.pill.acc{background:var(--ok-bg);color:var(--ok-fg)}
.btn{border:1px solid var(--line);background:#fff;border-radius:8px;height:36px;padding:0 14px;cursor:pointer;color:var(--ink-2);
     font-size:14px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;font-family:inherit}
.btn.pericolo{background:var(--lock);border-color:var(--lock);color:#fff}
.bottoni{display:flex;gap:10px;margin-top:6px}
.vuoto{color:var(--ink-3);font-style:italic}
</style>
</head>
<body>
<header class="hdr">
  <div class="hdr-in">
    <a class="brand" href="~/Volantini"><span class="co">Co</span><span><b>Correggo</b><small>Gestisci promo</small></span></a>
    <div class="sp"></div>
    <span style="color:var(--ink-2);font-weight:600">@nome</span>
  </div>
</header>
<main>
  <div class="card">
    <h1>Revoca della versione @Model.Versione</h1>
    <p style="margin:0 0 14px;color:var(--ink-2)"><b>@Model.Titolo</b> (@Model.Classificazione) tornerà alla <b>versione @Model.Precedente</b>.</p>
    @if (totale == 0)
    {
        <div class="avviso" style="background:var(--ok-bg);color:var(--ok-fg)">Sulla versione @Model.Versione non ci sono correzioni: la revoca non fa perdere niente.</div>
    }
    else
    {
        <div class="avviso">Sulla versione @Model.Versione ci sono @totale correzioni. Controllale: se procedi vengono archiviate e non si vedranno più.</div>
    }

    @if (c.Note.Count > 0)
    {
      <h2>Note (@c.Note.Count)</h2>
      <table>
        <tr><th>Pag.</th><th>Testo</th><th>Autore</th><th>Data</th><th>Stato</th></tr>
        @foreach (var n in c.Note)
        {
          <tr><td>@n.Pagina</td><td>@n.Testo</td><td>@n.Autore @(n.TipoAutore != "" ? "(" + n.TipoAutore + ")" : "")</td>
              <td>@Data(n.DataModifica ?? n.DataInserimento)</td><td><span class="pill @(n.Stato == 0 ? "" : "acc")">@Stato(n.Stato)</span></td></tr>
        }
      </table><br>
    }
    @if (c.Timbri.Count > 0)
    {
      <h2>Timbri (@c.Timbri.Count)</h2>
      <table>
        <tr><th>Pag.</th><th>Timbro</th><th>Autore</th><th>Data</th><th>Stato</th></tr>
        @foreach (var t in c.Timbri)
        {
          <tr><td>@t.Pagina</td><td>@t.Nome</td><td>@t.Autore</td><td>@Data(t.DataInserimento)</td>
              <td><span class="pill @(t.Stato == 0 ? "" : "acc")">@Stato(t.Stato)</span></td></tr>
        }
      </table><br>
    }
    @if (c.Edit.Count > 0)
    {
      <h2>Edit avanzato (@c.Edit.Count)</h2>
      <table>
        <tr><th>Pag.</th><th>Prodotto</th><th>Cosa</th><th>Autore</th><th>Data</th><th>Stato</th></tr>
        @foreach (var e in c.Edit)
        {
          <tr><td>@e.Pagina</td><td>#@e.IdBox</td>
              <td>@(e.Parte == "offerta" ? "prezzi e altre azioni" : "descrizione, foto e loghi")</td>
              <td>@e.Autore</td><td>@Data(e.Data)</td>
              <td><span class="pill @(e.Stato == 0 ? "" : "acc")">@(e.Stato == 0 ? "in attesa" : "confermata")</span></td></tr>
        }
      </table><br>
    }

    <div class="bottoni">
      <form method="post" action="@Url.Content($"~/Promo/Revoca/{Model.IdVolantino}")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="versione" value="@Model.Versione">
        <input type="hidden" name="promo" value="@Model.Classificazione">
        <button class="btn pericolo" type="submit">Procedi con la revoca</button>
      </form>
      <a class="btn" href="@Url.Content("~/Promo/Gestisci?promo=" + Uri.EscapeDataString(Model.Classificazione))">Annulla</a>
    </div>
  </div>
</main>
</body>
</html>
