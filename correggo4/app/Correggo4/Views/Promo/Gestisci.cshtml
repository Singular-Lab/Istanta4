@model Correggo4.Models.Vista.GestionePromo
@using System.Globalization
@{
    // GESTISCI PROMO (j209): pagina autonoma come la home, solo Agenzia.
    Layout = null;
    var ci = CultureInfo.InvariantCulture;
    string nome = (ViewBag.Nome as string) ?? "";
    string statoFinestra = Model.FinestraStato switch
    {
        "aperta" => "Aperta: i Category possono correggere",
        "da_aprire" => "Non ancora aperta",
        "chiusa" => "Chiusa: i Category non entrano, l'Agenzia accetta le correzioni",
        _ => "Non impostata: i Category non vedono questa promo"
    };
    bool promoTuttaBloccata = Model.Volantini.Count > 0 && Model.Volantini.All(v => v.Bloccato);
    // j253: lo stato della finestra del Marketing sul timone, messo qui dal controller
    var ft = (ViewBag.FinestraTimone as Correggo4.Servizi.ServizioTimone.StatoFinestra)
             ?? new Correggo4.Servizi.ServizioTimone.StatoFinestra(false, false, null, null, "", null);
    string statoTimone = ft.Stato switch
    {
        "aperta" => "Aperta: il timone lo muove il Marketing",
        "da_aprire" => "Non ancora aperta",
        "chiusa" => "Chiusa: il timone lo sistema l'Agenzia",
        _ => "Non impostata: il Marketing non puo' toccare il timone"
    };
}
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gestisci promo &middot; Correggo4</title>
<style>
:root{
  --teal:#60cbbb; --teal-700:#2a8a7c; --teal-50:#e8f7f4; --co:#8dc63f;
  --ink:#1f2a30; --ink-2:#4a5860; --ink-3:#7c8a91; --line:#dfe5e8; --bg:#f1f4f5; --card:#fff;
  --ok-bg:#dcf3e6; --ok-fg:#1d7a45; --rev-bg:#fff0c2; --rev-fg:#8a5a00; --lock:#c8352e;
  --shadow:0 1px 2px rgba(20,40,50,.06),0 2px 8px rgba(20,40,50,.06); --r:10px;
}
*{box-sizing:border-box}
body{margin:0;font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;color:var(--ink);background:var(--bg);font-size:14px}
.hdr{background:#fff;border-top:4px solid var(--teal);box-shadow:0 1px 0 var(--line),0 2px 10px rgba(20,40,50,.05)}
.hdr-in{display:flex;align-items:center;gap:16px;padding:10px 28px;min-height:64px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}
.brand .co{width:36px;height:36px;border-radius:8px;background:var(--co);color:#fff;display:grid;place-items:center;font-weight:800}
.brand small{display:block;font-size:11px;color:var(--ink-3);margin-top:-2px}
.sp{flex:1}
.btn{border:1px solid var(--line);background:#fff;border-radius:8px;height:34px;padding:0 12px;cursor:pointer;color:var(--ink-2);
     font-size:13px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:6px;font-family:inherit}
.btn:hover{border-color:#c4ced3;color:var(--ink)}
.btn.primario{background:var(--teal-700);border-color:var(--teal-700);color:#fff}
.btn.primario:hover{background:#237467}
.btn.pericolo{color:var(--lock);border-color:#efc3c0}
.btn.pericolo:hover{background:#fdf1f0}
main{max-width:1100px;margin:24px auto;padding:0 20px}
h1{font-size:22px;margin:0 0 4px}
.sotto{color:var(--ink-3);margin:0 0 18px}
.msg{padding:10px 14px;border-radius:8px;margin-bottom:14px;font-weight:600}
.msg.ok{background:var(--ok-bg);color:var(--ok-fg)}
.msg.ko{background:#fde2e0;color:#9b2a22}
.card{background:var(--card);border-radius:var(--r);box-shadow:var(--shadow);padding:18px 20px;margin-bottom:16px}
.card h2{font-size:15px;margin:0 0 12px;display:flex;align-items:center;gap:10px}
.riga{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end}
label.campo{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--ink-2);font-weight:600}
input[type=date],input[type=datetime-local],select{height:34px;border:1px solid var(--line);border-radius:8px;padding:0 10px;
     font-family:inherit;font-size:14px;color:var(--ink);background:#fff}
select.promo{min-width:320px;font-weight:600}
.pill{font-size:11.5px;font-weight:700;padding:2px 9px;border-radius:10px;background:var(--bg);color:var(--ink-2)}
.pill.aperta{background:var(--ok-bg);color:var(--ok-fg)}
.pill.chiusa{background:#e9edef;color:var(--ink-2)}
.pill.da_aprire{background:var(--rev-bg);color:var(--rev-fg)}
.pill.vuota{background:#fde2e0;color:#9b2a22}
.pill.lock{background:#fde2e0;color:var(--lock)}
.nota{font-size:12px;color:var(--ink-3);margin-top:8px}
.vol{border:1px solid var(--line);border-radius:var(--r);padding:14px 16px;margin-bottom:12px}
.vol-t{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.vol-t b{font-size:15px}
.vol-azioni{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;padding-top:12px;border-top:1px dashed var(--line);align-items:center}
.check{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--ink-2);height:34px}
form{margin:0}
</style>
</head>
<body>
<header class="hdr">
  <div class="hdr-in">
    <a class="brand" href="~/Volantini"><span class="co">Co</span><span><b>Correggo</b><small>Gestisci promo</small></span></a>
    <div class="sp"></div>
    <span style="color:var(--ink-2);font-weight:600">@nome</span>
    <a class="btn" href="~/Volantini">&larr; Torna ai volantini</a>
  </div>
</header>

<main>
  <h1>Gestisci promo</h1>
  <p class="sotto">Finestra dei Category, date, blocco e revoca delle versioni. I volantini arrivano da fidelity: qui non si caricano.</p>

  @if (TempData["Fatto"] is string fatto) { <div class="msg ok">@fatto</div> }
  @if (TempData["Errore"] is string err) { <div class="msg ko">@err</div> }

  <div class="card">
    <form method="get" action="~/Promo/Gestisci" class="riga">
      <label class="campo">Promo
        <select name="promo" class="promo" onchange="this.form.submit()">
          <option value="">Scegli una promo…</option>
          @foreach (var p in Model.Promo)
          {
              <option value="@p" selected="@(p == Model.Scelta)">@p</option>
          }
        </select>
      </label>
      <noscript><button class="btn" type="submit">Apri</button></noscript>
    </form>
  </div>

  @if (Model.Scelta != null)
  {
    <div class="card">
      <h2>Finestra dei Category
        <span class="pill @(Model.FinestraStato == "" ? "vuota" : Model.FinestraStato)">@statoFinestra</span>
      </h2>
      <form method="post" action="~/Promo/Finestra" class="riga">
        @Html.AntiForgeryToken()
        <input type="hidden" name="promo" value="@Model.Scelta">
        <label class="campo">Apre il
          <input type="datetime-local" name="inizio" required value="@(Model.FinestraInizio?.ToString("yyyy-MM-dd'T'HH:mm", ci))">
        </label>
        <label class="campo">Chiude il
          <input type="datetime-local" name="fine" required value="@(Model.FinestraFine?.ToString("yyyy-MM-dd'T'HH:mm", ci))">
        </label>
        <button class="btn primario" type="submit">Salva finestra</button>
      </form>
      <div class="nota">Vale per tutta la promo. Fuori finestra i Category non vedono la promo. Il Marketing corregge sempre: la sua finestra qui sotto riguarda soltanto il timone.</div>
    </div>

    @* j253 - la finestra del Marketing sul TIMONE. Gemella di quella dei Category: vale per
       tutta la promo, e mentre è aperta il timone lo muove il Marketing e l'Agenzia guarda.
       Si può aprire anche dalla barra del timone, dentro l'editor: fa la stessa cosa. *@
    <div class="card">
      <h2>Finestra per timone
        <span class="pill @(ft.Stato == "" ? "vuota" : ft.Stato)">@statoTimone</span>
      </h2>
      <div class="riga">
        <form method="post" action="~/Promo/FinestraTimone" class="riga">
          @Html.AntiForgeryToken()
          <input type="hidden" name="promo" value="@Model.Scelta">
          <label class="campo">Apre il
            <input type="datetime-local" name="inizio"
                   value="@((ft.Inizio ?? DateTime.UtcNow).ToLocalTime().ToString("yyyy-MM-dd'T'HH:mm", ci))">
          </label>
          <label class="campo">Chiude il
            <input type="datetime-local" name="fine" required
                   value="@((ft.Fine ?? DateTime.UtcNow.AddDays(7)).ToLocalTime().ToString("yyyy-MM-dd'T'HH:mm", ci))">
          </label>
          <button class="btn primario" type="submit">Salva finestra</button>
        </form>
        @if (ft.Impostata && ft.Aperta)
        {
          <form method="post" action="~/Promo/FinestraTimone/Chiudi">
            @Html.AntiForgeryToken()
            <input type="hidden" name="promo" value="@Model.Scelta">
            <button class="btn pericolo" type="submit">Chiudi adesso</button>
          </form>
        }
      </div>
      <div class="nota">
        Mentre è aperta, il Marketing sposta le referenze nel timone e l'Agenzia lo vede in sola
        lettura. Chiusa la finestra, il timone lo sistema l'Agenzia. Le correzioni non c'entrano:
        il timone è uno strato a parte e non le tocca.
        @if (ft.Impostata && ft.Autore != null) { <text>Aperta da @ft.Autore.</text> }
      </div>
    </div>

    <div class="card">
      <h2>Blocco di tutta la promo
        @if (promoTuttaBloccata) { <span class="pill lock">Bloccata</span> }
      </h2>
      <div class="riga">
        <form method="post" action="~/Promo/Blocco">
          @Html.AntiForgeryToken()
          <input type="hidden" name="promo" value="@Model.Scelta"><input type="hidden" name="tutta" value="true"><input type="hidden" name="blocca" value="true">
          <button class="btn pericolo" type="submit">Blocca tutti i volantini (1 ora)</button>
        </form>
        <form method="post" action="~/Promo/Blocco">
          @Html.AntiForgeryToken()
          <input type="hidden" name="promo" value="@Model.Scelta"><input type="hidden" name="tutta" value="true"><input type="hidden" name="blocca" value="false">
          <button class="btn" type="submit">Sblocca tutti</button>
        </form>
      </div>
      <div class="nota">Finché un volantino è bloccato nessuno può salvare correzioni. Il blocco finisce da solo dopo un'ora.</div>
    </div>

    <div class="card">
      <h2>Volantini della promo</h2>
      @if (Model.Volantini.Count == 0) { <div class="nota">Nessun volantino.</div> }
      @foreach (var v in Model.Volantini)
      {
        <div class="vol">
          <div class="vol-t">
            <b>@v.Titolo</b>
            <span class="pill">Versione @v.Versione</span>
            @if (v.Bloccato)
            {
                <span class="pill lock">Bloccato ancora @(v.BloccoMinuti) min @(v.BloccatoDa != "" ? "· da " + v.BloccatoDa : "")</span>
            }
          </div>
          <form method="post" action="~/Promo/Date" class="riga">
            @Html.AntiForgeryToken()
            <input type="hidden" name="promo" value="@Model.Scelta">
            <input type="hidden" name="idVol" value="@v.Id">
            <label class="campo">Validità dal
              <input type="date" name="inizio" required value="@v.ValiditaInizio.ToString("yyyy-MM-dd", ci)">
            </label>
            <label class="campo">al
              <input type="date" name="fine" required value="@v.ValiditaFine.ToString("yyyy-MM-dd", ci)">
            </label>
            <label class="campo">Invio previsto (chiusura correzioni)
              <input type="date" name="scadenza" required value="@v.Scadenza.ToString("yyyy-MM-dd", ci)">
            </label>
            <label class="check"><input type="checkbox" name="estendi" value="true"> estendi a tutta la promo</label>
            <button class="btn primario" type="submit">Salva date</button>
          </form>
          <div class="vol-azioni">
            <form method="post" action="~/Promo/Blocco">
              @Html.AntiForgeryToken()
              <input type="hidden" name="promo" value="@Model.Scelta"><input type="hidden" name="idVol" value="@v.Id">
              <input type="hidden" name="blocca" value="@(v.Bloccato ? "false" : "true")">
              <button class="btn @(v.Bloccato ? "" : "pericolo")" type="submit">@(v.Bloccato ? "Sblocca" : "Blocca (1 ora)")</button>
            </form>
            @if (v.Revocabile)
            {
                <a class="btn" href="@Url.Content($"~/Promo/Revoca/{v.Id}")">Revoca la versione @v.Versione…</a>
            }
            else
            {
                <span class="nota" style="margin:0">Una sola versione: niente da revocare.</span>
            }
          </div>
        </div>
      }
    </div>
  }
</main>
</body>
</html>
