# fidelity.env - ambiente iniettato nel container fidelity.
# Contiene credenziali: sul target va chmod 600 e non finisce in git.
#
# ATTENZIONE: server/core/config/index.ts valida questo ambiente con Zod all'avvio
# e, se manca anche una sola variabile obbligatoria, stampa l'elenco e fa exit(1).
# Il container muore subito, `up --wait` fallisce e il Runner esegue il rollback.
# Tutte le variabili sotto "Obbligatorie" devono avere un valore; quelle marcate
# come URL devono essere URL assoluti, non path relativi.
#
# NON mettere qui NODE_ENV, NODE_PORT, WS_PORT, REDIS_URL, ICONE_INSEGNA_DIR,
# MONGO_URL, MONGO_DB_NAME ne' alcuna DB_POSTGRESQL_*: le imposta il compose e `environment` vince comunque su
# `env_file`. Le credenziali del database stanno in release.env, perche' devono
# restare identiche a quelle con cui il container PostgreSQL e' stato
# inizializzato.

# ---------------------------------------------------------------- Obbligatorie

# URL con cui il browser raggiunge l'applicazione.
# Deve iniziare con http:// se non c'è TLS: con https:// il cookie di sessione
# diventa secure e il login non funziona.
CLIENT_URL=

# Segreti applicativi.
FICO_SECRET=
SESSION_SECRET=
EPHEMERAL_TOKEN_SECRET=
SALT_ROUNDS=10

# Servizi esterni. Tutti URL assoluti.
ISTANTA_IP_ADDRESS=
PROXY_URL=
VITE_API_URL=
OLYMPUS_IP_ADDRESS=http://olimpo:3000
VITE_OLYMPUS_IP_ADDRESS=
OLYMPUS_IP_ADDRESS_CORS=
VITE_OLYMPUS_IP_ADDRESS_CORS=

# OpenAI.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
API_KEY_AI=
ASSISTANT_ID=
OPEN_AI_ASSISTANT_ID=
OPEN_AI_ASSISTANT_ID_TRANSLATION=

# SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- Facoltative

# Identificativo dell'istanza cliente: seleziona le logiche custom di agenzia_lib.
CLIENT_ID=default

# Protezione CSRF (letta direttamente da process.env, fuori dallo schema Zod).
CSRF_SECRET=

# Worker HTTP del cluster node.
HTTP_WORKERS=2

# Pool e diagnostica query.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_SLOW_QUERY_THRESHOLD=1000
# Lo schema lo sincronizza l'entrypoint con models:sync: lasciare false.
DB_AUTO_SYNC=false

# Altri servizi della suite.
# CORREGGO_IP_ADDRESS=
# CLIENT_API_URL=
# FICO_BASE_URL=
# DBUNO_URL=
# SMTP_FROM=
# ALLOWED_ORIGINS=
