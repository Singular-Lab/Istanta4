# release.env - file passato a docker compose come --env-file dal Runner.
# Serve solo alla sostituzione delle variabili dentro compose.production.yaml,
# non viene iniettato nei container (per quello ci sono fidelity.env e olimpo.env).
#
# Il Runner aggiunge e aggiorna da solo FIDELITY_IMAGE e OLIMPO_IMAGE a ogni
# release, pinnate a digest. Tutte le altre righe restano come le scrivi tu:
# il Runner riscrive esclusivamente le variabili immagine.

# Isola container, rete e volumi di questa istanza. Va cambiato se sulla stessa
# macchina gira piu' di un cliente.
COMPOSE_PROJECT_NAME=istanta4

# Modalita' di Fidelity. Lasciare vuoto o assente significa `production`.
# Impostare `development` SOLO su macchine di prova raggiunte in http senza
# proxy TLS: disattiva l'enforcement della CSP (che altrimenti pretende https
# per ogni risorsa) e rende permissivo il CORS. Non usarlo in produzione.
#FIDELITY_NODE_ENV=development

# Porte pubblicate sull'host.
FIDELITY_HTTP_PORT=3010
FIDELITY_WS_PORT=3400
OLIMPO_HTTP_PORT=3300

# Database nel container PostgreSQL di questo deployment set.
#
# Questi valori sono la fonte unica: al primo avvio il container li usa per
# creare database e ruoli, e il compose li passa alle applicazioni. Non
# ripeterli in fidelity.env e olimpo.env, verrebbero comunque ignorati.
#
# ATTENZIONE: l'inizializzazione avviene UNA VOLTA SOLA, quando il volume
# postgres_data e' vuoto. Cambiare una password qui dopo il primo avvio non la
# cambia dentro il database: l'applicazione smette di connettersi. Per cambiarla
# davvero serve un ALTER ROLE dentro il container, e poi allineare questo file.
FIDELITY_DB_NAME=fidelity
FIDELITY_DB_USER=fidelity
FIDELITY_DB_PASSWORD=
OLIMPO_DB_NAME=olimpo
OLIMPO_DB_USER=olimpo
OLIMPO_DB_PASSWORD=

# Primo utente amministratore di Fidelity, creato da seed-fidelity.sh DOPO il
# primo avvio: le tabelle le crea Sequelize quando Fidelity parte, quindi non si
# possono riempire durante l'inizializzazione di PostgreSQL.
#
# La password viene registrata cifrata con bcrypt, ma qui resta in chiaro:
# chmod 600 su questo file, e non riusare una password usata altrove.
FIDELITY_ADMIN_EMAIL=
FIDELITY_ADMIN_PASSWORD=
FIDELITY_ADMIN_NOME=Amministratore
FIDELITY_ADMIN_COGNOME=Sistema

# Database MongoDB di Fidelity (configurazione WebPliant). Il servizio non ha
# autenticazione e non pubblica porte: vive solo nella rete del progetto.
FIDELITY_MONGO_DB=fidelity

# Porta di manutenzione, esposta solo su 127.0.0.1 dell'host: serve per psql e
# pg_dump. 5433 per non collidere con un PostgreSQL gia' installato sulla
# macchina.
POSTGRES_HOST_PORT=5433

# Directory host con i file di configurazione di fidelity montati in /app/config.
# Deve esistere prima del primo avvio: se manca, Docker la crea vuota e di
# proprieta' di root, e l'errore si manifesta solo dentro l'applicazione.
POSTGRES_INIT_DIR=/opt/company-ai/projects/istanta4/postgres-init
FIDELITY_CONFIG_DIR=/opt/company-ai/projects/istanta4/fidelity-config
PROXY_TEMPLATE_DIR=/opt/company-ai/projects/istanta4/proxy-templates
# Deve contenere fullchain.pem e privkey.pem.
PROXY_CERT_DIR=/opt/company-ai/projects/istanta4/proxy-certs

# Porta HTTPS pubblicata dal proxy: e' l'indirizzo con cui si usa Fidelity, e
# CLIENT_URL in fidelity.env deve coincidere, schema https compreso. Le porte
# 3010 e 3400 restano esposte ma non vanno usate dal browser: la SPA funziona
# solo passando di qui.
PROXY_HTTPS_PORT=8081
