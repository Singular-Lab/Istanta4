# olimpo.env - ambiente iniettato nel container olimpo.
# Contiene credenziali: sul target va chmod 600 e non finisce in git.
#
# NODE_ENV, FTP_ROOT e tutte le DB_* NON vanno messe qui: le imposta il compose e
# vincono comunque su questo file. Le credenziali del database stanno in
# release.env, perche' devono restare identiche a quelle con cui il container
# PostgreSQL e' stato inizializzato.

# Origini ammesse per le chiamate dal browser, separate da virgola.
CORS_ORIGINS=

# Percorso di estrazione degli zip, risolto dall'applicazione a partire da
# dist/src: tenerlo dentro /app/uploads per non perderlo agli aggiornamenti.
EXTRACTION_PATH=../../uploads/estrazioni

# Integrazione con Istanta per la conversione foto.
ISTANTA_IP_FOTO=
ISTANTA_AUTH_TOKEN=

# Dashboard privata.
PRIVATE_DASHBOARD_SECRET=
PRIVATE_DASHBOARD_ALLOWED_IPS=
PRIVATE_SESSION_TTL_HOURS=8
PRIVATE_SESSION_IDLE_MINUTES=30

FICO_SECRET=
FORCE_SECURE_COOKIES=true
