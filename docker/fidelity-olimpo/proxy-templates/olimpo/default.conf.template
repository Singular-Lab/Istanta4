# Terminazione TLS davanti a Olimpo, per il server che ospita solo Olimpo
# (PROXY_UPSTREAM=olimpo in release.env). Olimpo non gestisce TLS da se': il
# proxy serve per raggiungerlo in https, per esempio https://olimpo.dominio.it.
#
# A differenza di Fidelity, Olimpo serve pagine, API e WebSocket sulla stessa
# porta (3000, fissata dal Dockerfile), quindi basta una sola location che
# inoltri anche l'Upgrade.
#
# Reso da envsubst all'avvio come il template di Fidelity; qui non ci sono
# variabili da sostituire, e quelle di nginx come $http_upgrade restano intatte
# grazie a NGINX_ENVSUBST_FILTER nel compose.

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    # Olimpo accetta upload multipart fino a 1 TB (src/main.ts): il limite lo
    # decide lui, non il proxy. Senza buffering il file passa in streaming
    # invece di essere scritto prima su disco nel container di nginx.
    client_max_body_size 0;
    proxy_request_buffering off;

    # Il resolver di Docker, usato insieme alla variabile qui sotto: nginx
    # risolve il nome a ogni richiesta, quindi parte anche se Olimpo non e'
    # ancora su e segue il container quando il Runner lo ricrea.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        set $app_upstream http://olimpo:3000;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Download e upload di file grandi e WebSocket aperti a lungo.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# Connection: upgrade solo per le richieste WebSocket, close per le altre.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
