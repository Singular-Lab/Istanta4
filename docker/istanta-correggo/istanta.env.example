# istanta.env - ambiente aggiuntivo del container Istanta.
# Contiene credenziali: sul target va chmod 600 e non finisce in git.
#
# La configurazione principale di Istanta NON sta qui: sta nel file montato
# come /app/appsettings.json (ISTANTA_APPSETTINGS_FILE in release.env), che e'
# il modello per cliente descritto in Istanta/appsettings.famila.template.json.
#
# NON mettere qui ASPNETCORE_ENVIRONMENT, ASPNETCORE_HTTP_PORTS,
# external_paths__pathLib ne' le ConnectionStrings: le imposta il compose e
# "environment" vince comunque su "env_file". Le credenziali del database
# stanno in release.env, perche' devono restare identiche a quelle con cui il
# container PostgreSQL e' stato inizializzato.

# Sovrascritture puntuali della configurazione, con la sintassi a doppio
# underscore di .NET. Esempi di cio' che conviene tenere qui invece che nel
# file JSON, perche' e' segreto o cambia da macchina a macchina:

#fico__secretKey=
#fico__nomeCliente=

# Indirizzi dei servizi della suite. Dentro la rete del progetto si usano i
# nomi dei servizi, non 127.0.0.1: il localhost di un container e' se stesso.
#fico__correggoServerUrl=http://correggo4:8080
#fico__olympusServerUrl=
#fico__fpServerUrl=
