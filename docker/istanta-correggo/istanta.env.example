# istanta.env - configurazione completa del container Istanta.
# Contiene credenziali: sul target va chmod 600 e non finisce in git.
#
# Questo file È la configurazione, non un complemento: nell'immagine NON c'è
# alcun appsettings.json, perché `appsettings*.json` è gitignorato e la CI
# costruisce da un clone pulito. Il container parte quindi senza valori di
# default, e ogni chiave che serve va dichiarata qui.
#
# SINTASSI: le chiavi di configurazione .NET si scrivono con doppio underscore
# al posto dei due punti, e gli elementi di un array con l'indice numerico.
#
#   appsettings.json                   variabile d'ambiente
#   fico.secretKey                     fico__secretKey
#   sync_options.extPreLavorazione[0]  sync_options__extPreLavorazione__0
#   fico.userDataPolicy[1].dest        fico__userDataPolicy__1__dest
#
# I valori sono quelli di Istanta/appsettings.famila.template.json, adattati al
# container: sostituisci "Famila" con il cliente di questa installazione.

# --------------------------------------------- impostate dal compose: NON qui
# ASPNETCORE_ENVIRONMENT, ASPNETCORE_HTTP_PORTS
# ConnectionStrings__IstandaConnectionDb, ConnectionStrings__IstantaSession
# external_paths__pathLib
# Ridefinirle qui non ha effetto: `environment` del compose vince su `env_file`.

# ----------------------------------------------------------- da NON impostare
# Urls: nel modello vale http://0.0.0.0:5077, ma in container la porta la
# governa ASPNETCORE_HTTP_PORTS=8080 insieme al mapping del compose e al proxy.
# Impostandola, Kestrel ascolterebbe altrove e nginx non troverebbe nessuno.

# ---------------------------------------------------------------- diagnostica
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
AllowedHosts=*

# -------------------------------------------------------------------- percorsi
# /data è il volume persistente (ISTANTA_DATA_DIR). Tutto ciò che deve
# sopravvivere alla ricreazione del container va lì: un percorso relativo come
# "wwwroot/..." finisce nel filesystem dell'immagine e si perde a ogni release.
jpg_path_foto__path=/data/jpg/
path_to_export__path=/data/exported_files/
path_to_import__path=/data/imported_files/

# I Source*.json del cliente: l'applicazione non li legge soltanto, li CREA e li
# popola progressivamente a runtime. Il percorso resta quello dell'immagine
# perche' il compose vi monta sopra un volume nominato, `istanta_external_source`,
# che alla prima creazione viene seminato dall'immagine e poi preservato a ogni
# release. La cartella del cliente e la sorella `vergine` con i modelli arrivano
# quindi da sole, senza passaggi manuali.
external_paths__pathSource=wwwroot/external_source/Famila/

# ----------------------------------------------------------------- sync_options
sync_options__extractPath=/data/estrazioni/

# Dentro la rete del progetto si usa il nome del servizio: 127.0.0.1, per un
# container, è se stesso.
sync_options__ipUploadGate=http://correggo4:8080

sync_options__extPreLavorazione__0=.jpg
sync_options__delimitersQuery__0=_
# Array vuoti nel modello. Non essendoci un appsettings.json da cui ereditare,
# restano vuoti anche non dichiarandoli: le righe sono qui per ricordare che
# esistono e come si popolano.
#sync_options__extPostLavorazione__0=
#sync_options__delimitersIndexRules__0=
#sync_options__fotoAmbientateKeyWordsToSearch__0=
#sync_options__loghiKeyWordsToSearch__0=
#sync_options__bolliniKeyWordsToSearch__0=

# ---------------------------------------------------------------- antlr_options
# Struttura annidata: una lista di livelli, e per ogni livello una lista di
# pattern. Si esprime per indici; per aggiungerne altri si incrementa __0, __1.
antlr_options__patternsDescrizioneRegionale__livelli__0__nome=Livello 1
antlr_options__patternsDescrizioneRegionale__livelli__0__patterns__0__condizione=iniziativa==2505AC || settore==8305
antlr_options__patternsDescrizioneRegionale__livelli__0__patterns__0__valore=LOC

# ------------------------------------------------------------------------- fico
fico__nomeCliente=Famila
# Obbligatoria: chiedila a chi gestisce il cliente.
fico__secretKey=

# Contesti FICO per cliente, presenti nell'immagine.
fico__contextsPath=wwwroot/ficoContexts/Famila/

# Correggo4 vive in questo stesso deployment set: nome del servizio.
fico__correggoServerUrl=http://correggo4:8080
fico__agent=ws://correggo4:8080/ws

# Olimpo e Fidelity stanno FUORI da questo progetto Compose, quindi non sono
# raggiungibili per nome di servizio. Si usa l'indirizzo con cui sono esposti:
# host.docker.internal se girano sulla stessa macchina — il compose aggiunge
# l'alias al container di Istanta — altrimenti l'indirizzo di rete.
fico__olympusServerUrl=http://host.docker.internal:3300/olimpo
fico__fpServerUrl=http://host.docker.internal:3010/api

# Mappatura dei dati utente restituiti da FICO.
fico__userDataPolicy__0__source=nome
fico__userDataPolicy__0__dest=NomeUtente
fico__userDataPolicy__1__source=cognome
fico__userDataPolicy__1__dest=email
