# release.env - file passato a docker compose come --env-file dal Runner.
# Serve alla sostituzione delle variabili dentro compose.production.yaml; nei
# container arriva solo cio' che il compose passa esplicitamente.
#
# Il Runner aggiunge e aggiorna da solo ISTANTA_IMAGE e CORREGGO4_IMAGE a ogni
# release, pinnate a digest. Tutte le altre righe restano come le scrivi tu:
# il Runner riscrive esclusivamente le variabili immagine.

# Isola container, rete e volumi di questa istanza. Va cambiato se sulla stessa
# macchina gira piu' di un cliente.
COMPOSE_PROJECT_NAME=istanta-correggo

# Porte HTTPS pubblicate dal proxy: sono gli indirizzi con cui si usano le due
# applicazioni.
ISTANTA_HTTPS_PORT=8443
CORREGGO_HTTPS_PORT=8444

# Porte delle applicazioni in chiaro, senza passare dal proxy. Servono per la
# diagnosi e per le prove in HTTP: entrambe le applicazioni funzionano senza
# TLS, perche' nessuna delle due emette HSTS o una CSP con
# upgrade-insecure-requests, e UseHttpsRedirection di Istanta resta inerte
# quando nel container non esiste una porta https.
#
# APP_BIND_ADDRESS governa a quale indirizzo dell'host sono legate. Il valore
# predefinito 127.0.0.1 le rende raggiungibili solo dalla macchina stessa; per
# provarle da un altro computer della rete si imposta 0.0.0.0, ricordando che
# cosi' viaggiano in chiaro e senza proxy davanti.
APP_BIND_ADDRESS=127.0.0.1
ISTANTA_LOCAL_PORT=18080
CORREGGO_LOCAL_PORT=18081

# PostgreSQL resta sempre su 127.0.0.1: non segue APP_BIND_ADDRESS.
POSTGRES_HOST_PORT=5434

# Database nel container PostgreSQL di questo deployment set.
#
# Questi valori sono la fonte unica: al primo avvio il container li usa per
# creare database e ruoli, e il compose li passa alle applicazioni come
# connection string. Non ripeterli nei file d'ambiente delle applicazioni.
#
# ATTENZIONE: l'inizializzazione avviene UNA VOLTA SOLA, quando il volume
# postgres_data e' vuoto. Cambiare una password qui dopo il primo avvio non la
# cambia dentro il database: l'applicazione smette di connettersi. Per cambiarla
# davvero serve un ALTER ROLE dentro il container, e poi allineare questo file.
ISTANTA_DB_NAME=istanta
ISTANTA_DB_USER=istanta
ISTANTA_DB_PASSWORD=
CORREGGO_DB_NAME=correggo4
CORREGGO_DB_USER=correggo4
CORREGGO_DB_PASSWORD=

# Primo utente amministratore, creato al primo avvio di PostgreSQL nei due
# database. Serve per entrare la prima volta; gli utenti successivi si creano
# dalle applicazioni.
#
# ATTENZIONE: su Istanta la password viene memorizzata IN CHIARO, perche'
# LoginController la confronta direttamente con il valore della colonna. Non e'
# una scelta di questo deployment set: e' come funziona l'applicazione. Vale
# quindi trattare questo file come un segreto (chmod 600) e non riusare qui una
# password usata altrove. Su Correggo4 invece viene cifrata con PBKDF2-SHA256.
#
# Massimo 50 caratteri: e' il limite della colonna utenti.password di Istanta.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NOME=Amministratore
ADMIN_COGNOME=Sistema
# Ruolo su Correggo4: 1 = GDO (corregge), 2 = Agenzia (pubblica e conferma).
# Su Istanta l'utente e' sempre Superadmin.
CORREGGO_ADMIN_RUOLO=2

# Percorsi ASSOLUTI sull'host. Assoluti perche' il Runner lancia docker compose
# da dentro il proprio container: un percorso relativo verrebbe risolto in
# /deployments/..., che sull'host non esiste, e Docker creerebbe una directory
# vuota senza segnalare nulla.
#
# ATTENZIONE alla base del percorso: e' la directory di lavoro che il Runner usa
# sul target, e prende il nome del PROGETTO in ControlPlane (istanta4), non del
# deployment set (istanta-correggo). Se non corrispondono, Docker monta
# directory vuote appena create e il guasto si vede molto dopo: PostgreSQL parte
# senza schemi, e quel volume non si sistemera' piu' da solo.
#
# Dopo aver compilato questo file, prima di distribuire:
#   sudo ./prepare-target.sh
# crea le directory di dati con i permessi giusti e si ferma dicendo cosa manca.
#
# postgres-init e schemas vengono letti una volta sola, quando PostgreSQL
# inizializza il volume: devono essere completi PRIMA del primo avvio.
POSTGRES_INIT_DIR=/opt/company-ai/projects/istanta4/postgres-init
SCHEMAS_DIR=/opt/company-ai/projects/istanta4/schemas
PROXY_TEMPLATE_DIR=/opt/company-ai/projects/istanta4/proxy-templates
# Deve contenere fullchain.pem e privkey.pem.
PROXY_CERT_DIR=/opt/company-ai/projects/istanta4/proxy-certs

# Directory in cui il Runner installa AgenziaLib.dll (artifact di tipo File).
# Deve corrispondere alla DestinationPath configurata nel catalogo ControlPlane
# per il componente agenzia-lib, risolta dentro la working directory.
ISTANTA_EXTERNAL_LIB_DIR=/opt/company-ai/projects/istanta4/external_lib

# Dati persistenti di Istanta, montati come /data. Il compose vi monta anche due
# sottodirectory: dataprotection-keys (le chiavi con cui si cifra il cookie di
# sessione) e ai_models. Le prepara prepare-target.sh con il proprietario giusto.
ISTANTA_DATA_DIR=/opt/company-ai/projects/istanta4/istanta-data

# Dati persistenti di Correggo4: dentro, volantini/ montata come /data/volantini.
CORREGGO_DATA_DIR=/opt/company-ai/projects/istanta4/correggo-data
