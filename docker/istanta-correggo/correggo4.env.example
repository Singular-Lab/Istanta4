# correggo4.env - ambiente aggiuntivo del container Correggo4.
# Contiene credenziali: sul target va chmod 600 e non finisce in git.
#
# NON mettere qui ASPNETCORE_ENVIRONMENT, ASPNETCORE_HTTP_PORTS,
# Storage__VolantiniPath ne' ConnectionStrings__Correggo4Db: le imposta il
# compose e "environment" vince comunque su "env_file". Le credenziali del
# database stanno in release.env.

# Correggo4 si avvia anche senza le chiavi Fico__* qui sotto, ma senza non
# lavora con il resto della suite: non si entra da Fidelity (OAuthLanded),
# l'Edit avanzato non trova foto e loghi, le policy dei Category restano spente.
# prepare-target.sh le controlla.

# ------------------------------------------- collegamento con Fidelity (FICO)

# Olimpo sta nell'altro stack (fidelity-olimpo): si raggiunge con l'indirizzo
# del server e la porta pubblicata di Olimpo. host.docker.internal qui non
# funziona: il servizio correggo4 del compose non lo dichiara.
Fico__OlimpoUrl=http://<ip-del-server>:<porta-olimpo>/olimpo

# Istanta sta in questo stesso compose: basta il nome del servizio.
Fico__IstantaUrl=http://istanta:8080

# Il segreto condiviso della suite: lo STESSO valore di FICO_SECRET di Fidelity
# e di Olimpo. Serve sia a decifrare il context con cui Fidelity apre Correggo,
# sia a chiedere a Olimpo il passaporto per foto e loghi. E' uno solo: la vecchia
# Fico__SecretKey non e' piu' letta.
Fico__Secret=

# Il cliente, come nomeGdo del Correggo originale. "CoopFi" attiva le policy di
# correzione dei Category ricavate dai reparti di Olimpo; vuoto per gli altri
# clienti (nessuna policy, si entra senza restrizioni).
Fico__NomeGdo=

# ------------------------------------------- pubblicazione in una cartella

# Pubblicazione in una cartella (http://dominio/cartella/ invece della radice
# di un'origine). Due modi, a seconda di come il proxy inoltra la richiesta:
#  - il proxy passa il percorso intero (/cartella/...): indicare la cartella qui
#    sotto;
#  - il proxy toglie la cartella (nginx: location /cartella/ { proxy_pass
#    http://correggo4:8080/; }): lasciare vuoto e far mandare al proxy
#    proxy_set_header X-Forwarded-Prefix /cartella;
# Alla radice non serve nulla. Correggo4 si fida degli header X-Forwarded-* solo
# dai proxy su loopback e reti private; per altri indirizzi elencarli con
# ForwardedHeaders__KnownNetworks__0=203.0.113.0/24 (la lista sostituisce quella
# predefinita).
# PathBase=/cartella
