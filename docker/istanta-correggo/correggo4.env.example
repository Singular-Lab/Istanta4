# correggo4.env - ambiente aggiuntivo del container Correggo4.
# Contiene credenziali: sul target va chmod 600 e non finisce in git.
#
# NON mettere qui ASPNETCORE_ENVIRONMENT, ASPNETCORE_HTTP_PORTS,
# Storage__VolantiniPath ne' ConnectionStrings__Correggo4Db: le imposta il
# compose e "environment" vince comunque su "env_file". Le credenziali del
# database stanno in release.env.

# Correggo4 non richiede altre variabili per avviarsi: la sua configurazione
# minima e' la connection string piu' il percorso dei volantini, entrambi gia'
# forniti dal compose. Questo file esiste per le impostazioni per cliente che
# emergeranno, e perche' il compose lo richiede come env_file.
