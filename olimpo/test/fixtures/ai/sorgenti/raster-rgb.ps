%!PS-Adobe-3.0
%%BoundingBox: 0 0 100 100
%%EndComments
[ /Creator (Fixture di test Olimpo) /Title (raster-rgb) /DOCINFO pdfmark
<< /PageSize [100 100] >> setpagedevice
% immagine raster RGB 4x4 incorporata, nessun tracciato vettoriale colorato
gsave
10 10 translate 80 80 scale
4 4 8 [4 0 0 -4 0 4]
<ff0000 00ff00 0000ff ffff00
  00ffff ff00ff 808080 ffffff
  ff8000 0080ff 80ff00 8000ff
  000000 ff0080 00ff80 404040>
false 3 colorimage
grestore
showpage
%%EOF
