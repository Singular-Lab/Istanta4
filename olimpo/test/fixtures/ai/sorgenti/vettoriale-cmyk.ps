%!PS-Adobe-3.0
%%BoundingBox: 0 0 200 100
%%EndComments
[ /Creator (Fixture di test Olimpo) /Title (vettoriale-cmyk) /DOCINFO pdfmark
<< /PageSize [200 100] >> setpagedevice
% riquadro in quadricromia
0.1 0.9 0.8 0.0 setcmykcolor
10 10 80 80 rectfill
% riquadro in tinta piatta, alternativa CMYK
[/Separation (PANTONE 485 C) /DeviceCMYK { pop 0 0.95 1 0 }] setcolorspace
1 setcolor
110 10 80 80 rectfill
showpage
%%EOF
